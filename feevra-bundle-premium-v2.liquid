{% comment %}
  FEEVRA PREMIUM BUNDLE - V2

  Premium, innovative bundle design med smooth animations

  Features:
  - Smooth fold-down animations
  - Innovative color distribution
  - Før-priser på alt
  - Responsive labels
  - Minimalistisk og intuitivt
{% endcomment %}

<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');

/* Complete CSS isolation */
.feevra-bundle-v2 {
  all: initial;
  display: block;

  /* Scoped variables */
  --feevra-primary: #1C1A54;
  --feevra-accent: #00C896;
  --feevra-gray-50: #F9FAFB;
  --feevra-gray-100: #F3F4F6;
  --feevra-gray-200: #E5E7EB;
  --feevra-gray-300: #D1D5DB;
  --feevra-gray-500: #9CA3AF;
  --feevra-gray-600: #6B7280;
  --feevra-gray-700: #374151;
  --feevra-gray-800: #1F2937;
  --feevra-red: #EF4444;
  --feevra-green: #10B981;

  font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  max-width: 680px;
  margin: 0 auto;
  padding: 0;
  box-sizing: border-box;
}

.feevra-bundle-v2 *,
.feevra-bundle-v2 *::before,
.feevra-bundle-v2 *::after {
  box-sizing: border-box;
}

/* Main container with brand border - NOT a card */
.feevra-bundle-v2 .bundle-inner {
  border: 1px solid var(--feevra-primary);
  border-radius: 10px;
  padding: clamp(8px, 2vw, 12px);
  background: #fff;
}

/* Headlines - left aligned, ultra compact */
.feevra-bundle-v2 .bundle-headline {
  font-size: clamp(12px, 2.4vw, 14px);
  font-weight: 700;
  text-align: left;
  margin: 0 0 5px 0;
  color: var(--feevra-primary);
  letter-spacing: -0.01em;
}

.feevra-bundle-v2 .bundle-subheadline {
  font-size: clamp(10px, 2vw, 11px);
  font-weight: 400;
  color: var(--feevra-gray-600);
  text-align: left;
  margin: -3px 0 5px 0;
  line-height: 1.3;
}

/* Section spacing - ultra compact */
.feevra-bundle-v2 .bundle-section {
  margin-bottom: 4px;
}

.feevra-bundle-v2 .bundle-section:last-child {
  margin-bottom: 0;
}

/* Mix colors toggle - discrete link style */
.feevra-bundle-v2 .mix-toggle-container {
  margin: 12px 0;
  display: none;
  text-align: center;
}

.feevra-bundle-v2 .mix-toggle-container.show {
  display: block;
}

.feevra-bundle-v2 .mix-colors-link {
  display: inline-block;
  font-size: clamp(11px, 2.4vw, 13px);
  color: var(--feevra-primary);
  text-decoration: underline;
  cursor: pointer;
  font-weight: 600;
  transition: all 0.2s ease;
  background: none;
  border: none;
  padding: 4px 0;
  font-family: inherit;
}

.feevra-bundle-v2 .mix-colors-link:hover {
  color: #13102d;
  text-decoration: none;
}

/* Distribution section - hidden by default, smooth toggle */
.feevra-bundle-v2 #section-distribution {
  max-height: 0;
  overflow: hidden;
  opacity: 0;
  margin-bottom: 0;
  transition: max-height 0.3s ease, opacity 0.2s ease, margin 0.3s ease;
}

.feevra-bundle-v2 #section-distribution.active {
  max-height: 2000px;
  opacity: 1;
  margin-top: 6px;
  margin-bottom: 6px;
}

/* Color Grid - Always 4 columns, ultra compact */
.feevra-bundle-v2 .color-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: clamp(4px, 1.2vw, 6px);
}

.feevra-bundle-v2 .color-card {
  cursor: pointer;
  border: 2px solid transparent;
  border-radius: 10px;
  background: #fff;
  padding: 0;
  transition: all 0.2s ease;
  position: relative;
  overflow: hidden;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
}

.feevra-bundle-v2 .color-card:hover {
  border-color: var(--feevra-primary);
  transform: translateY(-2px);
  box-shadow: 0 6px 16px rgba(28, 26, 84, 0.12);
}

.feevra-bundle-v2 .color-card.selected {
  border-color: var(--feevra-primary);
  border-width: 3px;
  box-shadow: 0 4px 12px rgba(28, 26, 84, 0.15);
}

.feevra-bundle-v2 .color-card.sold-out {
  opacity: 0.5;
  cursor: not-allowed;
}

.feevra-bundle-v2 .color-card.sold-out:hover {
  transform: none;
}

.feevra-bundle-v2 .color-image {
  position: relative;
  width: 100%;
  padding-bottom: 100%;
  overflow: hidden;
}

.feevra-bundle-v2 .color-image img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}


.feevra-bundle-v2 .color-name {
  padding: 6px 3px;
  text-align: center;
  font-size: clamp(10px, 2.2vw, 12px);
  font-weight: 600;
  color: var(--feevra-gray-800);
}

.feevra-bundle-v2 .color-status {
  font-size: clamp(8px, 1.8vw, 9px);
  color: var(--feevra-red);
  font-weight: 600;
  margin-top: -3px;
  margin-bottom: 3px;
}

/* Quantity Grid - ultra compact */
.feevra-bundle-v2 .qty-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: clamp(5px, 1.2vw, 8px);
}

@media (max-width: 480px) {
  .feevra-bundle-v2 .qty-grid {
    gap: 4px;
  }
}

.feevra-bundle-v2 .qty-card {
  cursor: pointer;
  border: 1.5px solid var(--feevra-gray-300);
  border-radius: 10px;
  background: #fff;
  padding: 0;
  transition: all 0.2s ease;
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  box-shadow: 0 0 0 0 transparent inset;
}

.feevra-bundle-v2 .qty-card:hover {
  border-color: var(--feevra-primary);
  transform: translateY(-1px);
  box-shadow: 0 4px 8px rgba(28, 26, 84, 0.08);
}

.feevra-bundle-v2 .qty-card.selected {
  border-color: var(--feevra-primary);
  box-shadow: 0 0 0 1px var(--feevra-primary) inset, 0 4px 12px rgba(28, 26, 84, 0.15);
}

@media (max-width: 480px) {
  .feevra-bundle-v2 .qty-card {
    border-width: 1.5px;
  }

  .feevra-bundle-v2 .qty-card.selected {
    border-width: 2px;
  }
}

/* Responsive badge labels - extends to edges perfectly */
.feevra-bundle-v2 .qty-badge {
  background: var(--feevra-primary);
  color: #fff;
  padding: clamp(6px, 1.4vw, 8px) 8px;
  font-size: clamp(10px, 2.6vw, 13px);
  font-weight: 700;
  text-transform: capitalize;
  letter-spacing: 0.02em;
  width: calc(100% + 3px);
  text-align: center;
  min-height: clamp(24px, 5.5vw, 28px);
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 8px 8px 0 0;
  margin: -1.5px -1.5px 0 -1.5px;
  position: relative;
}

.feevra-bundle-v2 .qty-badge.best {
  background: var(--feevra-accent);
}

@media (max-width: 480px) {
  .feevra-bundle-v2 .qty-badge {
    padding: 5px 6px;
    font-size: 10px;
    min-height: 24px;
    width: calc(100% + 4px);
    margin: -2px -2px 0 -2px;
  }
}

/* Always show full text on all devices */
.feevra-bundle-v2 .qty-badge .badge-full {
  display: inline;
}

.feevra-bundle-v2 .qty-badge .badge-short {
  display: none;
}

.feevra-bundle-v2 .qty-content {
  padding: clamp(6px, 1.8vw, 10px) clamp(4px, 1.2vw, 6px);
  display: flex;
  flex-direction: column;
  gap: 2px;
  align-items: center;
  justify-content: center;
  width: 100%;
}

/* Force same height for all cards - compact with column prices */
.feevra-bundle-v2 .qty-card {
  min-height: 105px;
}

@media (max-width: 480px) {
  .feevra-bundle-v2 .qty-content {
    padding: 6px 3px;
    gap: 2px;
    width: 100%;
    align-items: center;
  }

  .feevra-bundle-v2 .qty-card {
    min-height: 98px;
  }
}

.feevra-bundle-v2 .qty-amount {
  font-size: clamp(16px, 3.8vw, 20px);
  font-weight: 700;
  color: var(--feevra-primary);
  line-height: 1;
  min-height: 22px;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  text-align: center;
}

.feevra-bundle-v2 .qty-prices {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 3px;
  width: 100%;
}

.feevra-bundle-v2 .qty-original-price {
  font-size: clamp(10px, 2.2vw, 11px);
  color: var(--feevra-gray-500);
  text-decoration: line-through;
  font-weight: 500;
  line-height: 1;
  display: block;
  white-space: nowrap;
}

.feevra-bundle-v2 .qty-price {
  font-size: clamp(16px, 3.8vw, 19px);
  font-weight: 700;
  color: var(--feevra-gray-800);
  line-height: 1;
  display: block;
  white-space: nowrap;
}

.feevra-bundle-v2 .qty-savings {
  font-size: clamp(8px, 1.8vw, 9px);
  font-weight: 700;
  color: var(--feevra-green);
  background: rgba(16, 185, 129, 0.1);
  padding: 3px 8px;
  border-radius: 8px;
  margin-top: 2px;
  min-height: 20px;
  display: flex;
  align-items: center;
  justify-content: center;
  white-space: nowrap;
}

@media (max-width: 480px) {
  .feevra-bundle-v2 .qty-amount {
    font-size: 17px;
    min-height: 20px;
    width: 100%;
    justify-content: center;
    text-align: center;
  }

  .feevra-bundle-v2 .qty-original-price {
    font-size: 10px;
  }

  .feevra-bundle-v2 .qty-price {
    font-size: 15px;
  }

  .feevra-bundle-v2 .qty-savings {
    font-size: 8px;
    padding: 2px 6px;
    min-height: 18px;
    white-space: nowrap;
  }

  .feevra-bundle-v2 .qty-prices {
    gap: 3px;
  }
}

.feevra-bundle-v2 .qty-per {
  display: none;
}

/* Innovative Color Distribution - ultra compact */
.feevra-bundle-v2 .distribution-container {
  background: var(--feevra-gray-50);
  border-radius: 7px;
  padding: clamp(8px, 1.8vw, 10px);
}

.feevra-bundle-v2 .distribution-title {
  font-size: clamp(11px, 2.2vw, 13px);
  font-weight: 600;
  color: var(--feevra-gray-800);
  margin: 0 0 6px 0;
}

.feevra-bundle-v2 .distribution-grid {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.feevra-bundle-v2 .distribution-item {
  display: flex;
  align-items: center;
  gap: 8px;
}

.feevra-bundle-v2 .distribution-label {
  font-size: clamp(10px, 2.2vw, 12px);
  font-weight: 600;
  color: var(--feevra-gray-700);
  min-width: 60px;
}

.feevra-bundle-v2 .distribution-colors {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 5px;
  flex: 1;
}

.feevra-bundle-v2 .dist-color-btn {
  cursor: pointer;
  border: 2px solid var(--feevra-gray-300);
  border-radius: 8px;
  padding: 0;
  background: #fff;
  transition: all 0.2s ease;
  position: relative;
  overflow: hidden;
}

.feevra-bundle-v2 .dist-color-btn:hover {
  border-color: var(--feevra-primary);
}

.feevra-bundle-v2 .dist-color-btn.selected {
  border-color: var(--feevra-primary);
  border-width: 3px;
}

.feevra-bundle-v2 .dist-color-img {
  width: 100%;
  padding-bottom: 100%;
  position: relative;
}

.feevra-bundle-v2 .dist-color-img img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}


/* CTA Button - Bold, prominent, eye-catching */
.feevra-bundle-v2 .cta-button {
  width: 100%;
  padding: clamp(14px, 3vw, 16px) 20px;
  background: var(--feevra-primary);
  color: #fff;
  border: none;
  border-radius: 10px;
  font-size: clamp(15px, 3.4vw, 17px);
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  cursor: pointer;
  transition: all 0.2s ease;
  font-family: 'Inter', sans-serif;
  margin-top: 0;
  box-shadow: 0 4px 12px rgba(28, 26, 84, 0.25);
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
}

/* Loading spinner */
.feevra-bundle-v2 .cta-button .spinner {
  width: 16px;
  height: 16px;
  border: 2px solid rgba(255, 255, 255, 0.3);
  border-top-color: #fff;
  border-radius: 50%;
  animation: feevra-spin 0.6s linear infinite;
  display: none;
}

.feevra-bundle-v2 .cta-button.loading .spinner {
  display: block;
}

@keyframes feevra-spin {
  to { transform: rotate(360deg); }
}

.feevra-bundle-v2 .cta-button:hover:not(:disabled) {
  background: #13102d;
  transform: translateY(-2px);
  box-shadow: 0 8px 20px rgba(28, 26, 84, 0.35);
}

.feevra-bundle-v2 .cta-button:active:not(:disabled) {
  transform: translateY(0);
  box-shadow: 0 4px 12px rgba(28, 26, 84, 0.25);
}

.feevra-bundle-v2 .cta-button:disabled {
  background: var(--feevra-gray-300);
  cursor: not-allowed;
}

/* Trust badges - larger and more visible */
.feevra-bundle-v2 .trust-badges {
  display: flex;
  justify-content: center;
  gap: clamp(12px, 3vw, 16px);
  margin-top: 8px;
  flex-wrap: wrap;
}

.feevra-bundle-v2 .trust-item {
  display: flex;
  align-items: center;
  gap: 5px;
  font-size: clamp(10px, 2.4vw, 12px);
  color: var(--feevra-gray-600);
  font-weight: 500;
}

.feevra-bundle-v2 .trust-icon {
  width: 14px;
  height: 14px;
  color: var(--feevra-accent);
}

/* Payment icons section */
.feevra-bundle-v2 .payment-section {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 6px;
  margin-top: 8px;
  width: 100%;
  box-sizing: border-box;
  flex-wrap: nowrap;
}

.feevra-bundle-v2 .payment-icons {
  display: flex;
  align-items: center;
  min-width: 0;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;
  -ms-overflow-style: none;
}

.feevra-bundle-v2 .payment-icons::-webkit-scrollbar {
  display: none;
}

.feevra-bundle-v2 .payment-icons img {
  height: clamp(12px, 3.2vw, 18px);
  margin-right: 5px;
  flex-shrink: 0;
}

.feevra-bundle-v2 .payment-icons img:last-child {
  margin-right: 0;
}

.feevra-bundle-v2 .trustpilot-badge {
  display: flex;
  align-items: center;
  gap: 5px;
  flex-shrink: 0;
  white-space: nowrap;
  font-weight: 400;
  font-size: clamp(10px, 2.4vw, 12px);
}

.feevra-bundle-v2 .trustpilot-badge span {
  color: #000;
}

.feevra-bundle-v2 .trustpilot-badge img {
  height: clamp(12px, 3vw, 16px);
  flex-shrink: 0;
}

/* Mobile responsive payment section */
@media (max-width: 480px) {
  .feevra-bundle-v2 .payment-icons img {
    height: 15px;
    margin-right: 6px;
  }

  .feevra-bundle-v2 .trustpilot-badge {
    font-size: 9px;
  }

  .feevra-bundle-v2 .trustpilot-badge img {
    height: 13px;
  }
}

/* Toast notifications */
.feevra-bundle-v2 .toast {
  position: fixed;
  bottom: 24px;
  right: 24px;
  background: var(--feevra-gray-800);
  color: #fff;
  padding: 12px 20px;
  border-radius: 8px;
  font-size: 14px;
  font-weight: 500;
  z-index: 9999;
  opacity: 0;
  transform: translateY(20px);
  transition: all 0.3s ease;
  pointer-events: none;
}

.feevra-bundle-v2 .toast.show {
  opacity: 1;
  transform: translateY(0);
  pointer-events: auto;
}

.feevra-bundle-v2 .toast.error {
  background: var(--feevra-red);
}

.feevra-bundle-v2 .toast.success {
  background: var(--feevra-green);
}

/* Utility classes */
.feevra-bundle-v2 .hidden {
  display: none !important;
}
</style>

