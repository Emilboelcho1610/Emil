      <button type="button" class="cta-button" id="add-to-cart-btn">
        <span class="cta-text">Tilføj til kurv</span>
        <span class="spinner"></span>
      </button>

      <div class="trust-badges">
        <div class="trust-item">
          <svg class="trust-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
          </svg>
          <span>Gratis levering</span>
        </div>
        <div class="trust-item">
          <svg class="trust-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <span>100 dages returret</span>
        </div>
      </div>

      <!-- Payment icons and Trustpilot -->
      <div class="payment-section">
        <div class="payment-icons">
          <img src="https://cdn.shopify.com/s/files/1/0871/4570/9910/files/visa-65d650f7.svg?v=1756638751" alt="Visa">
          <img src="https://cdn.shopify.com/s/files/1/0871/4570/9910/files/master-54b5a7ce.svg?v=1756638754" alt="Mastercard">
          <img src="https://cdn.shopify.com/s/files/1/0871/4570/9910/files/mobilepay-a8fc702d.svg?v=1756638746" alt="MobilePay">
          <img src="https://cdn.shopify.com/s/files/1/0871/4570/9910/files/apple_pay-1721ebad.svg?v=1756638775" alt="Apple Pay">
          <img src="https://cdn.shopify.com/s/files/1/0871/4570/9910/files/google_pay-34c30515.svg?v=1756638754" alt="Google Pay">
          <img src="https://cdn.shopify.com/s/files/1/0871/4570/9910/files/klarna-637a076e.svg?v=1761513481" alt="Klarna">
        </div>
        <div class="trustpilot-badge">
          <span>Fremragende</span>
          <img src="https://cdn.shopify.com/s/files/1/0871/4570/9910/files/Trustpilot_stars.png?v=1750971162" alt="Trustpilot stjerner">
        </div>
      </div>
    </div>

  </div>

  <!-- Toast Container -->
  <div class="toast" id="toast"></div>
</div>

<script>
(function() {
  'use strict';

  const CONFIG = {
    products: {
      sort: {
        name: 'Sort',
        variantId: '49885169189206',
        image: 'https://cdn.shopify.com/s/files/1/0871/4570/9910/files/feevra-migraenemasken.jpg_2_e103e0c1-662b-4aca-a605-009f32c6e49e.jpg?v=1768917230'
      },
      rosa: {
        name: 'Rosa',
        variantId: '50188499812694',
        image: 'https://cdn.shopify.com/s/files/1/0871/4570/9910/files/feevra-migraenemaske_jpg_3ec23e6e-1dce-4474-a8e8-30ad75e4a914.jpg?v=1768917229'
      },
      graa: {
        name: 'Grå',
        variantId: '50595389866326',
        image: 'https://cdn.shopify.com/s/files/1/0871/4570/9910/files/feevra-migraenemasken_jpg_049bb0ba-66eb-478f-87ba-5f4e1c3af56c.jpg?v=1768917230'
      },
      blaa: {
        name: 'Blå',
        variantId: '51508439810390',
        image: 'https://cdn.shopify.com/s/files/1/0871/4570/9910/files/feevra-migraenemasken.jpg_3_021793b9-d91c-4e66-8277-77242e0f482e.jpg?v=1768917230'
      }
    }
  };

  const state = {
    selectedColor: null,
    selectedQuantity: 2,
    distribution: {},
    soldOutVariants: [] // Will be populated dynamically from Shopify
  };

  // Elements
  const els = {
    colorCards: document.querySelectorAll('.feevra-bundle-v2 .color-card'),
    qtyCards: document.querySelectorAll('.feevra-bundle-v2 .qty-card'),
    sections: {
      color: document.getElementById('section-color'),
      quantity: document.getElementById('section-quantity'),
      distribution: document.getElementById('section-distribution'),
      cta: document.getElementById('section-cta')
    },
    mixToggleContainer: document.getElementById('mix-toggle-container'),
    mixColorsLink: document.getElementById('mix-colors-link'),
    distributionGrid: document.getElementById('distribution-grid'),
    ctaBtn: document.getElementById('add-to-cart-btn'),
    toast: document.getElementById('toast')
  };

  // Initialize
  function init() {
    // Pre-select defaults: Sort color and 2 stk (Populær)
    const sortCard = document.querySelector('.feevra-bundle-v2 .color-card[data-color="sort"]');
    if (sortCard) {
      sortCard.classList.add('selected');
      state.selectedColor = 'sort';
    }

    updateQuantitySelection(2);

    // Initialize distribution with default color
    state.distribution = { 0: 'sort', 1: 'sort' };

    // Event listeners
    els.colorCards.forEach(card => {
      card.addEventListener('click', handleColorSelect);
    });

    els.qtyCards.forEach(card => {
      card.addEventListener('click', handleQuantitySelect);
    });

    els.mixColorsLink.addEventListener('click', handleMixToggle);
    els.ctaBtn.addEventListener('click', handleAddToCart);

    // Show mix toggle for default 2 stk
    updateMixToggleVisibility();

    // Check stock status
    checkStockStatus();
  }

  // Handle color selection
  function handleColorSelect(e) {
    const card = e.currentTarget;
    const color = card.dataset.color;
    const available = card.dataset.available === 'true';

    if (!available) {
      showToast('Denne farve er udsolgt', 'error');
      return;
    }

    // Update state
    state.selectedColor = color;

    // Batch DOM updates for smoother performance
    requestAnimationFrame(() => {
      // Update UI
      els.colorCards.forEach(c => c.classList.remove('selected'));
      card.classList.add('selected');

      // Update distribution to use new color if not mixing
      if (!els.sections.distribution.classList.contains('active')) {
        const qty = state.selectedQuantity;
        for (let i = 0; i < qty; i++) {
          state.distribution[i] = color;
        }
      } else {
        // Re-render distribution if it's active
        updateDistribution();
      }
    });
  }

  // Handle quantity selection
  function handleQuantitySelect(e) {
    const card = e.currentTarget;
    const quantity = parseInt(card.dataset.quantity);

    // Batch DOM updates for smoother performance
    requestAnimationFrame(() => {
      updateQuantitySelection(quantity);

      // Update distribution for new quantity
      const color = state.selectedColor || 'sort';
      state.distribution = {};
      for (let i = 0; i < quantity; i++) {
        state.distribution[i] = color;
      }

      // Update mix toggle visibility
      updateMixToggleVisibility();

      // If distribution is active, update display
      if (els.sections.distribution.classList.contains('active') && quantity > 1) {
        updateDistribution();
      } else if (quantity === 1) {
        // Hide distribution for single item
        els.sections.distribution.classList.remove('active');
        els.mixColorsLink.textContent = 'Vælg forskellige farver';
      }
    });
  }

  function updateQuantitySelection(quantity) {
    state.selectedQuantity = quantity;

    // Update UI
    els.qtyCards.forEach(card => {
      const cardQty = parseInt(card.dataset.quantity);
      if (cardQty === quantity) {
        card.classList.add('selected');
      } else {
        card.classList.remove('selected');
      }
    });
  }

  // Handle mix toggle
  function handleMixToggle(e) {
    e.preventDefault();

    const isActive = els.sections.distribution.classList.contains('active');

    if (!isActive) {
      // Show distribution section
      els.sections.distribution.classList.add('active');
      els.mixColorsLink.textContent = 'Brug samme farve';
      updateDistribution();
    } else {
      // Hide distribution section
      els.sections.distribution.classList.remove('active');
      els.mixColorsLink.textContent = 'Vælg forskellige farver';

      // Reset all to selected color
      const qty = state.selectedQuantity;
      const color = state.selectedColor || 'sort';
      for (let i = 0; i < qty; i++) {
        state.distribution[i] = color;
      }
    }
  }

  // Update mix toggle visibility based on quantity
  function updateMixToggleVisibility() {
    const qty = state.selectedQuantity;
    if (qty > 1) {
      els.mixToggleContainer.classList.add('show');
    } else {
      els.mixToggleContainer.classList.remove('show');
      els.sections.distribution.classList.remove('active');
      els.mixColorsLink.textContent = 'Vælg forskellige farver';
    }
  }

  // Update distribution UI
  function updateDistribution() {
    const qty = state.selectedQuantity;

    if (qty === 1) {
      els.sections.distribution.classList.remove('active');
      return;
    }

    // Show distribution for 2+ items
    els.sections.distribution.classList.add('active');

    // Build distribution UI
    const grid = els.distributionGrid;
    grid.innerHTML = '';

    // Initialize distribution if needed
    if (Object.keys(state.distribution).length === 0) {
      for (let i = 0; i < qty; i++) {
        state.distribution[i] = state.selectedColor;
      }
    }

    // Create selection for each item
    for (let i = 0; i < qty; i++) {
      const item = document.createElement('div');
      item.className = 'distribution-item';

      const label = document.createElement('div');
      label.className = 'distribution-label';
      label.textContent = `Maske ${i + 1}:`;

      const colors = document.createElement('div');
      colors.className = 'distribution-colors';

      // Create button for each color
      Object.entries(CONFIG.products).forEach(([colorKey, product]) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'dist-color-btn';
        btn.dataset.index = i;
        btn.dataset.color = colorKey;

        if (state.distribution[i] === colorKey) {
          btn.classList.add('selected');
        }

        btn.innerHTML = `
          <div class="dist-color-img">
            <img src="${product.image}" alt="${product.name}">
          </div>
        `;

        btn.addEventListener('click', () => {
          state.distribution[i] = colorKey;
          updateDistribution();
        });

        colors.appendChild(btn);
      });

      item.appendChild(label);
      item.appendChild(colors);
      grid.appendChild(item);
    }
  }

  // Check stock status dynamically from Shopify product data
  async function checkStockStatus() {
    try {
      // Fetch product data - using correct product handle
      const response = await fetch('/products/feevra-migraene-maske.js');

      if (!response.ok) {
        console.warn('Could not fetch product data, status:', response.status);
        return;
      }

      const product = await response.json();
      console.log('Product data fetched:', product);
      console.log('Variants:', product.variants);

      const colorGrid = document.querySelector('.feevra-bundle-v2 .color-grid');
      const soldOutCards = [];

      // Check each variant's availability
      els.colorCards.forEach(card => {
        const variantId = parseInt(card.dataset.variant);
        const variant = product.variants.find(v => v.id === variantId);

        console.log(`Checking variant ${variantId}:`, variant);

        if (variant) {
          console.log(`  - Available: ${variant.available}`);

          // Update availability based on Shopify inventory
          if (!variant.available) {
            console.log(`  - Marking variant ${variantId} as SOLD OUT`);
            card.classList.add('sold-out');
            card.dataset.available = 'false';
            state.soldOutVariants.push(variantId.toString());

            // Add "Udsolgt" text if not already present
            if (!card.querySelector('.color-status')) {
              const statusEl = document.createElement('div');
              statusEl.className = 'color-status';
              statusEl.textContent = 'Udsolgt';
              card.appendChild(statusEl);
            }

            // Track sold out cards for reordering
            soldOutCards.push(card);
          } else {
            console.log(`  - Variant ${variantId} is AVAILABLE`);
            // Ensure it's marked as available
            card.classList.remove('sold-out');
            card.dataset.available = 'true';

            // Remove "Udsolgt" text if present
            const statusEl = card.querySelector('.color-status');
            if (statusEl) {
              statusEl.remove();
            }
          }
        } else {
          console.warn(`  - Variant ${variantId} NOT FOUND in product data`);
        }
      });

      // Move sold out variants to the end of the grid
      console.log(`Moving ${soldOutCards.length} sold-out cards to end`);
      soldOutCards.forEach(card => {
        colorGrid.appendChild(card);
      });

    } catch (error) {
      console.error('Error checking stock status:', error);
      // Fallback to data-available attributes in HTML if API fails
      els.colorCards.forEach(card => {
        const available = card.dataset.available === 'true';
        if (!available) {
          card.classList.add('sold-out');
          state.soldOutVariants.push(card.dataset.variant);
        }
      });
    }
  }

  // Add to cart
  async function handleAddToCart() {
    if (!state.selectedColor) {
      showToast('Vælg venligst en farve', 'error');
      return;
    }

    els.ctaBtn.disabled = true;
    const ctaText = els.ctaBtn.querySelector('.cta-text');
    ctaText.textContent = 'Tilføjer...';

    try {
      // Build items array
      const items = [];
      const colorCounts = {};

      // Count colors
      Object.values(state.distribution).forEach(color => {
        colorCounts[color] = (colorCounts[color] || 0) + 1;
      });

      // Add to cart
      Object.entries(colorCounts).forEach(([color, count]) => {
        const product = CONFIG.products[color];
        items.push({
          id: product.variantId,
          quantity: count,
          properties: {
            'Bundle': 'Feevra Bundle',
            'Antal i bundle': state.selectedQuantity
          }
        });
      });

      const response = await fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ items })
      });

      if (response.ok) {
        // Show success state with loading spinner
        ctaText.textContent = 'Tilføjet!';
        els.ctaBtn.classList.add('loading');

        // Dispatch events for theme integration
        window.dispatchEvent(new CustomEvent('feevra:cart:updated'));

        // Try multiple methods to open cart drawer
        // Method 1: Dawn/common themes
        if (typeof window.Shopify !== 'undefined' && window.Shopify.theme) {
          document.dispatchEvent(new CustomEvent('cart:refresh'));
        }

        // Method 2: Look for cart drawer element and open it
        setTimeout(() => {
          const cartDrawer = document.querySelector('.qsc2-drawer, [id*="cart-drawer"], [class*="cart-drawer"]');
          if (cartDrawer) {
            cartDrawer.classList.add('active', 'open', 'is-open');
            cartDrawer.setAttribute('aria-hidden', 'false');

            // Also try to find and click cart icon/button
            const cartButton = document.querySelector('[data-cart-drawer], [aria-controls*="cart"], .cart-icon-bubble');
            if (cartButton) {
              cartButton.click();
            }
          }

          // Method 3: Dispatch cart open events
          document.dispatchEvent(new CustomEvent('cart:open'));
          document.dispatchEvent(new CustomEvent('drawer:open'));

          // Remove loading spinner after 2 seconds
          setTimeout(() => {
            els.ctaBtn.classList.remove('loading');
            els.ctaBtn.disabled = false;
            ctaText.textContent = 'Tilføj til kurv';
          }, 2000);
        }, 300);

      } else {
        const error = await response.json();

        if (response.status === 422) {
          // Handle sold out
          showToast('En eller flere varer er udsolgt', 'error');
        } else {
          throw new Error(error.description || 'Kunne ikke tilføje til kurv');
        }

        els.ctaBtn.disabled = false;
        ctaText.textContent = 'Tilføj til kurv';
      }
    } catch (error) {
      console.error('Add to cart error:', error);
      showToast('Der skete en fejl. Prøv igen.', 'error');
      els.ctaBtn.disabled = false;
      ctaText.textContent = 'Tilføj til kurv';
    }
  }

  // Show toast notification
  function showToast(message, type = 'info') {
    els.toast.textContent = message;
    els.toast.className = `toast ${type} show`;

    setTimeout(() => {
      els.toast.classList.remove('show');
    }, 3000);
  }

  // Start
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>
