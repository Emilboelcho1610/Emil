{% comment %}
  FEEVRA PREMIUM BUNDLE - V2

  Premium, innovative bundle design med smooth animations

  Features:
  - Smooth fold-down animations
  - Innovative color distribution
  - Før-priser på alt
  - Responsive labels
  - Minimalistisk og intuitivt
{% endcomment %}

<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');

/* Complete CSS isolation */
.feevra-bundle-v2 {
  all: initial;
  display: block;

  /* Scoped variables */
  --feevra-primary: #1C1A54;
  --feevra-accent: #00C896;
  --feevra-gray-50: #F9FAFB;
  --feevra-gray-100: #F3F4F6;
  --feevra-gray-200: #E5E7EB;
  --feevra-gray-300: #D1D5DB;
  --feevra-gray-500: #9CA3AF;
  --feevra-gray-600: #6B7280;
  --feevra-gray-700: #374151;
  --feevra-gray-800: #1F2937;
  --feevra-red: #EF4444;
  --feevra-green: #10B981;

  font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  max-width: 680px;
  margin: 0 auto;
  padding: 0;
  box-sizing: border-box;
}

.feevra-bundle-v2 *,
.feevra-bundle-v2 *::before,
.feevra-bundle-v2 *::after {
  box-sizing: border-box;
}

/* Main container with brand border - NOT a card */
.feevra-bundle-v2 .bundle-inner {
  border: 1px solid var(--feevra-primary);
  border-radius: 10px;
  padding: clamp(8px, 2vw, 12px);
  background: #fff;
}

/* Headlines - left aligned, ultra compact */
.feevra-bundle-v2 .bundle-headline {
  font-size: clamp(12px, 2.4vw, 14px);
  font-weight: 700;
  text-align: left;
  margin: 0 0 5px 0;
  color: var(--feevra-primary);
  letter-spacing: -0.01em;
}

.feevra-bundle-v2 .bundle-subheadline {
  display: none;
}

/* Section spacing - ultra compact */
.feevra-bundle-v2 .bundle-section {
  margin-bottom: 6px;
}

.feevra-bundle-v2 .bundle-section:last-child {
  margin-bottom: 0;
}

/* Mix colors toggle - only shows for 2-3 items */
.feevra-bundle-v2 .mix-toggle-container {
  margin: 4px 0;
  display: none;
}

.feevra-bundle-v2 .mix-toggle-container.show {
  display: block;
}

.feevra-bundle-v2 .mix-toggle {
  display: flex;
  align-items: center;
  gap: 5px;
  cursor: pointer;
  font-size: clamp(10px, 2.2vw, 12px);
  color: var(--feevra-gray-700);
  font-weight: 500;
}

.feevra-bundle-v2 .mix-toggle input[type="checkbox"] {
  width: 14px;
  height: 14px;
  cursor: pointer;
  accent-color: var(--feevra-primary);
}

.feevra-bundle-v2 .mix-toggle:hover {
  color: var(--feevra-primary);
}

/* Distribution section - hidden by default, smooth toggle */
.feevra-bundle-v2 #section-distribution {
  max-height: 0;
  overflow: hidden;
  opacity: 0;
  margin-bottom: 0;
  transition: max-height 0.3s ease, opacity 0.2s ease, margin 0.3s ease;
}

.feevra-bundle-v2 #section-distribution.active {
  max-height: 2000px;
  opacity: 1;
  margin-top: 6px;
  margin-bottom: 6px;
}

/* Color Grid - Always 4 columns, ultra compact */
.feevra-bundle-v2 .color-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: clamp(4px, 1.2vw, 6px);
}

.feevra-bundle-v2 .color-card {
  cursor: pointer;
  border: 1.5px solid var(--feevra-gray-300);
  border-radius: 10px;
  background: #fff;
  padding: 0;
  transition: all 0.35s cubic-bezier(0.32, 0.72, 0, 1);
  position: relative;
  overflow: hidden;
}

.feevra-bundle-v2 .color-card:hover {
  border-color: var(--feevra-primary);
  transform: translateY(-3px) scale(1.02);
  box-shadow: 0 8px 16px rgba(28, 26, 84, 0.08);
}

.feevra-bundle-v2 .color-card.selected {
  border-color: var(--feevra-primary);
  border-width: 3px;
  box-shadow: 0 4px 12px rgba(28, 26, 84, 0.12);
}

.feevra-bundle-v2 .color-card.sold-out {
  opacity: 0.5;
  cursor: not-allowed;
}

.feevra-bundle-v2 .color-card.sold-out:hover {
  transform: none;
}

.feevra-bundle-v2 .color-image {
  position: relative;
  width: 100%;
  padding-bottom: 100%;
  overflow: hidden;
}

.feevra-bundle-v2 .color-image img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}


.feevra-bundle-v2 .color-name {
  padding: 6px 3px;
  text-align: center;
  font-size: clamp(10px, 2.2vw, 12px);
  font-weight: 600;
  color: var(--feevra-gray-800);
}

.feevra-bundle-v2 .color-status {
  font-size: clamp(8px, 1.8vw, 9px);
  color: var(--feevra-red);
  font-weight: 600;
  margin-top: -3px;
  margin-bottom: 3px;
}

/* Quantity Grid - ultra compact */
.feevra-bundle-v2 .qty-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: clamp(5px, 1.2vw, 8px);
}

@media (max-width: 480px) {
  .feevra-bundle-v2 .qty-grid {
    gap: 4px;
  }
}

.feevra-bundle-v2 .qty-card {
  cursor: pointer;
  border: 1.5px solid var(--feevra-gray-300);
  border-radius: 10px;
  background: #fff;
  padding: 0;
  transition: all 0.35s cubic-bezier(0.32, 0.72, 0, 1);
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.feevra-bundle-v2 .qty-card:hover {
  border-color: var(--feevra-primary);
  transform: translateY(-2px) scale(1.01);
  box-shadow: 0 6px 12px rgba(28, 26, 84, 0.08);
}

.feevra-bundle-v2 .qty-card.selected {
  border-color: var(--feevra-primary);
  border-width: 2.5px;
  box-shadow: 0 4px 12px rgba(28, 26, 84, 0.15);
  transform: scale(1.01);
}

@media (max-width: 480px) {
  .feevra-bundle-v2 .qty-card {
    border-width: 1.5px;
  }

  .feevra-bundle-v2 .qty-card.selected {
    border-width: 2px;
  }
}

/* Responsive badge labels */
.feevra-bundle-v2 .qty-badge {
  background: var(--feevra-primary);
  color: #fff;
  padding: 4px 6px;
  font-size: clamp(8px, 1.8vw, 9px);
  font-weight: 700;
  text-transform: capitalize;
  letter-spacing: 0.02em;
  width: 100%;
  text-align: center;
}

.feevra-bundle-v2 .qty-badge.best {
  background: var(--feevra-accent);
}

@media (max-width: 480px) {
  .feevra-bundle-v2 .qty-badge {
    padding: 3px 5px;
    font-size: 8px;
  }
}

/* Always show full text on all devices */
.feevra-bundle-v2 .qty-badge .badge-full {
  display: inline;
}

.feevra-bundle-v2 .qty-badge .badge-short {
  display: none;
}

.feevra-bundle-v2 .qty-content {
  padding: clamp(6px, 1.8vw, 10px) clamp(4px, 1.2vw, 6px);
  display: flex;
  flex-direction: column;
  gap: 2px;
  align-items: center;
  justify-content: center;
  width: 100%;
}

/* Force same height for all cards - ultra compact */
.feevra-bundle-v2 .qty-card {
  min-height: 110px;
}

@media (max-width: 480px) {
  .feevra-bundle-v2 .qty-content {
    padding: 6px 3px;
    gap: 2px;
    width: 100%;
    align-items: center;
  }

  .feevra-bundle-v2 .qty-card {
    min-height: 100px;
  }
}

.feevra-bundle-v2 .qty-amount {
  font-size: clamp(16px, 3.8vw, 20px);
  font-weight: 700;
  color: var(--feevra-primary);
  line-height: 1;
  height: 22px;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  text-align: center;
}

.feevra-bundle-v2 .qty-prices {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2px;
  width: 100%;
}

.feevra-bundle-v2 .qty-original-price {
  font-size: clamp(9px, 2vw, 10px);
  color: var(--feevra-gray-500);
  text-decoration: line-through;
  font-weight: 500;
  line-height: 1;
  height: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
}

.feevra-bundle-v2 .qty-price {
  font-size: clamp(14px, 3.2vw, 16px);
  font-weight: 700;
  color: var(--feevra-gray-800);
  line-height: 1;
  height: 19px;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
}

.feevra-bundle-v2 .qty-savings {
  font-size: clamp(8px, 1.8vw, 9px);
  font-weight: 700;
  color: var(--feevra-green);
  background: rgba(16, 185, 129, 0.1);
  padding: 3px 8px;
  border-radius: 8px;
  margin-top: 2px;
  height: 20px;
  display: flex;
  align-items: center;
  justify-content: center;
  white-space: nowrap;
}

@media (max-width: 480px) {
  .feevra-bundle-v2 .qty-amount {
    font-size: 15px;
    height: 20px;
    width: 100%;
    justify-content: center;
    text-align: center;
  }

  .feevra-bundle-v2 .qty-original-price {
    font-size: 9px;
    height: 11px;
    width: 100%;
  }

  .feevra-bundle-v2 .qty-price {
    font-size: 13px;
    height: 17px;
    width: 100%;
  }

  .feevra-bundle-v2 .qty-savings {
    font-size: 8px;
    padding: 2px 6px;
    height: 18px;
    white-space: nowrap;
  }

  .feevra-bundle-v2 .qty-prices {
    gap: 1px;
  }
}

.feevra-bundle-v2 .qty-per {
  display: none;
}

/* Innovative Color Distribution - ultra compact */
.feevra-bundle-v2 .distribution-container {
  background: var(--feevra-gray-50);
  border-radius: 7px;
  padding: clamp(8px, 1.8vw, 10px);
}

.feevra-bundle-v2 .distribution-title {
  font-size: clamp(11px, 2.2vw, 13px);
  font-weight: 600;
  color: var(--feevra-gray-800);
  margin: 0 0 6px 0;
}

.feevra-bundle-v2 .distribution-grid {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.feevra-bundle-v2 .distribution-item {
  display: flex;
  align-items: center;
  gap: 8px;
}

.feevra-bundle-v2 .distribution-label {
  font-size: clamp(10px, 2.2vw, 12px);
  font-weight: 600;
  color: var(--feevra-gray-700);
  min-width: 60px;
}

.feevra-bundle-v2 .distribution-colors {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 5px;
  flex: 1;
}

.feevra-bundle-v2 .dist-color-btn {
  cursor: pointer;
  border: 2px solid var(--feevra-gray-300);
  border-radius: 8px;
  padding: 0;
  background: #fff;
  transition: all 0.2s ease;
  position: relative;
  overflow: hidden;
}

.feevra-bundle-v2 .dist-color-btn:hover {
  border-color: var(--feevra-primary);
}

.feevra-bundle-v2 .dist-color-btn.selected {
  border-color: var(--feevra-primary);
  border-width: 3px;
}

.feevra-bundle-v2 .dist-color-img {
  width: 100%;
  padding-bottom: 100%;
  position: relative;
}

.feevra-bundle-v2 .dist-color-img img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}


/* CTA Button - Semi-bold uppercase, ultra compact */
.feevra-bundle-v2 .cta-button {
  width: 100%;
  padding: clamp(10px, 2.2vw, 12px) 14px;
  background: var(--feevra-primary);
  color: #fff;
  border: none;
  border-radius: 8px;
  font-size: clamp(12px, 2.6vw, 14px);
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  cursor: pointer;
  transition: all 0.2s ease;
  font-family: 'Inter', sans-serif;
  margin-top: 0;
}

.feevra-bundle-v2 .cta-button:hover:not(:disabled) {
  background: #13102d;
  transform: translateY(-3px);
  box-shadow: 0 12px 24px rgba(28, 26, 84, 0.3);
}

.feevra-bundle-v2 .cta-button:active:not(:disabled) {
  transform: translateY(-1px);
  box-shadow: 0 4px 12px rgba(28, 26, 84, 0.2);
}

.feevra-bundle-v2 .cta-button:disabled {
  background: var(--feevra-gray-300);
  cursor: not-allowed;
}

/* Trust badges - larger and more visible */
.feevra-bundle-v2 .trust-badges {
  display: flex;
  justify-content: center;
  gap: clamp(12px, 3vw, 16px);
  margin-top: 8px;
  flex-wrap: wrap;
}

.feevra-bundle-v2 .trust-item {
  display: flex;
  align-items: center;
  gap: 5px;
  font-size: clamp(10px, 2.4vw, 12px);
  color: var(--feevra-gray-600);
  font-weight: 500;
}

.feevra-bundle-v2 .trust-icon {
  width: 14px;
  height: 14px;
  color: var(--feevra-accent);
}

/* Payment icons section */
.feevra-bundle-v2 .payment-section {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 6px;
  margin-top: 8px;
  width: 100%;
  box-sizing: border-box;
  flex-wrap: nowrap;
}

.feevra-bundle-v2 .payment-icons {
  display: flex;
  align-items: center;
  min-width: 0;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;
  -ms-overflow-style: none;
}

.feevra-bundle-v2 .payment-icons::-webkit-scrollbar {
  display: none;
}

.feevra-bundle-v2 .payment-icons img {
  height: clamp(12px, 3.2vw, 18px);
  margin-right: 5px;
  flex-shrink: 0;
}

.feevra-bundle-v2 .payment-icons img:last-child {
  margin-right: 0;
}

.feevra-bundle-v2 .trustpilot-badge {
  display: flex;
  align-items: center;
  gap: 5px;
  flex-shrink: 0;
  white-space: nowrap;
  font-weight: 400;
  font-size: clamp(10px, 2.4vw, 12px);
}

.feevra-bundle-v2 .trustpilot-badge span {
  color: #000;
}

.feevra-bundle-v2 .trustpilot-badge img {
  height: clamp(12px, 3vw, 16px);
  flex-shrink: 0;
}

/* Mobile responsive payment section */
@media (max-width: 480px) {
  .feevra-bundle-v2 .payment-icons img {
    height: 15px;
    margin-right: 6px;
  }

  .feevra-bundle-v2 .trustpilot-badge {
    font-size: 9px;
  }

  .feevra-bundle-v2 .trustpilot-badge img {
    height: 13px;
  }
}

/* Toast notifications */
.feevra-bundle-v2 .toast {
  position: fixed;
  bottom: 24px;
  right: 24px;
  background: var(--feevra-gray-800);
  color: #fff;
  padding: 12px 20px;
  border-radius: 8px;
  font-size: 14px;
  font-weight: 500;
  z-index: 9999;
  opacity: 0;
  transform: translateY(20px);
  transition: all 0.3s ease;
  pointer-events: none;
}

.feevra-bundle-v2 .toast.show {
  opacity: 1;
  transform: translateY(0);
  pointer-events: auto;
}

.feevra-bundle-v2 .toast.error {
  background: var(--feevra-red);
}

.feevra-bundle-v2 .toast.success {
  background: var(--feevra-green);
}

/* Utility classes */
.feevra-bundle-v2 .hidden {
  display: none !important;
}
</style>

