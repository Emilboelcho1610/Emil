{% if settings.cart_type == 'drawer' %}
<style>
/* ─── DESIGN TOKENS ─────────────────────────────────────── */
:root {
  --cd-navy:     #1A3A5C;
  --cd-blue:     #4B8FCC;
  --cd-blue-lt:  #C8DFF2;
  --cd-blue-bg:  #EAF3FA;
  --cd-green:    #16A34A;
  --cd-green-bg: #DCFCE7;
  --cd-text:     #111827;
  --cd-sub:      #374151;
  --cd-muted:    #9CA3AF;
  --cd-border:   #E5E7EB;
  --cd-bg:       #F9FAFB;
  --cd-white:    #FFFFFF;
  --cd-r:        10px;
}

/* ─── BASE ──────────────────────────────────────────────── */
#CartDrawer * { box-sizing: border-box; }
#CartDrawer {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  color: var(--cd-text);
  background: var(--cd-bg);
}
#CartDrawer .drawer__contents { display: flex; flex-direction: column; height: 100%; }

/* ─── HEADER ────────────────────────────────────────────── */
#CartDrawer .drawer__fixed-header {
  background: var(--cd-navy) !important;
  border-bottom: none !important;
  flex-shrink: 0;
}
#CartDrawer .drawer__header {
  padding: 16px 20px !important;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
#CartDrawer .drawer__title {
  font-size: 1rem !important;
  font-weight: 700 !important;
  color: #FFFFFF !important;
  letter-spacing: .04em !important;
  text-transform: uppercase !important;
}
#CartDrawer .drawer__close-button {
  color: rgba(255,255,255,.7) !important;
  background: rgba(255,255,255,.1) !important;
  border-radius: 8px !important;
  padding: 6px !important;
  transition: background .15s;
}
#CartDrawer .drawer__close-button:hover { background: rgba(255,255,255,.2) !important; }
#CartDrawer .icon-close { width: 18px; height: 18px; stroke-width: 2.5; }

/* ─── MILESTONE BAR ─────────────────────────────────────── */
.cd-bar-wrap {
  background: var(--cd-navy);
  padding: 10px 20px 16px;
  flex-shrink: 0;
}
.cd-bar-msg {
  font-size: .8rem;
  color: rgba(255,255,255,.8);
  text-align: center;
  margin-bottom: 8px;
  line-height: 1.4;
}
.cd-bar-msg strong { color: #FFFFFF; font-weight: 700; }
.cd-bar-track {
  background: rgba(255,255,255,.18);
  border-radius: 99px;
  height: 6px;
  position: relative;
  overflow: visible;
}
.cd-bar-fill {
  height: 100%;
  border-radius: 99px;
  background: linear-gradient(90deg, #60A5FA, #34D399);
  transition: width .55s cubic-bezier(.4,0,.2,1);
  width: 0%;
  position: relative;
}
.cd-bar-dot {
  position: absolute;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 16px; height: 16px;
  border-radius: 50%;
  background: rgba(255,255,255,.25);
  border: 2px solid rgba(255,255,255,.5);
  z-index: 2;
  display: flex; align-items: center; justify-content: center;
  font-size: 9px;
  transition: background .3s, border-color .3s;
}
.cd-bar-dot.reached {
  background: #34D399;
  border-color: #34D399;
}
.cd-bar-row {
  display: flex;
  justify-content: space-between;
  margin-top: 8px;
}
.cd-bar-label {
  font-size: .7rem;
  color: rgba(255,255,255,.5);
  font-weight: 500;
  transition: color .3s;
}
.cd-bar-label.reached { color: #86EFAC; font-weight: 600; }

/* ─── SCROLLABLE ────────────────────────────────────────── */
#CartDrawer .drawer__inner { flex: 1; overflow: hidden; display: flex; flex-direction: column; }
#CartDrawer .drawer__scrollable { overflow-y: auto; flex: 1; padding-bottom: 8px; }

/* ─── PRODUCT ROWS (theme-rendered) ────────────────────── */
#CartDrawer [data-products] { padding: 12px 0; }
#CartDrawer .cart__item,
#CartDrawer .cart__item-row:not(.cart__item-sub):not(.cart__savings):not(.cart__terms) {
  display: flex !important;
  align-items: flex-start !important;
  gap: 12px !important;
  padding: 12px 16px !important;
  background: var(--cd-white) !important;
  margin: 0 12px 8px !important;
  border-radius: var(--cd-r) !important;
  border: 1px solid var(--cd-border) !important;
}
#CartDrawer .cart__item-image,
#CartDrawer .cart__item-image a { display: block; }
#CartDrawer .cart__item-image img {
  width: 72px !important;
  height: 72px !important;
  object-fit: cover !important;
  border-radius: 8px !important;
  background: var(--cd-bg);
}
#CartDrawer .cart__item-info,
#CartDrawer .cart__item-details { flex: 1 !important; min-width: 0 !important; }
#CartDrawer .cart__item-title,
#CartDrawer .cart__item-name {
  font-size: .88rem !important;
  font-weight: 600 !important;
  color: var(--cd-text) !important;
  line-height: 1.35 !important;
  margin-bottom: 3px !important;
  white-space: normal !important;
}
#CartDrawer .cart__item-vendor,
#CartDrawer .cart__item-variant {
  font-size: .75rem !important;
  color: var(--cd-muted) !important;
  margin-bottom: 6px !important;
}
#CartDrawer .cart__item-price,
#CartDrawer .cart__item-prices {
  font-size: .88rem !important;
  font-weight: 700 !important;
  color: var(--cd-navy) !important;
}
#CartDrawer .cart__item-quantity,
#CartDrawer .cart__item-quantity-wrapper {
  display: flex !important;
  align-items: center !important;
  gap: 0 !important;
  margin-top: 8px !important;
  background: var(--cd-bg) !important;
  border: 1px solid var(--cd-border) !important;
  border-radius: 8px !important;
  overflow: hidden !important;
  width: fit-content !important;
}
#CartDrawer .cart__quantity-selector button,
#CartDrawer .cart__item-quantity button,
#CartDrawer .cart__qty-minus,
#CartDrawer .cart__qty-plus {
  background: transparent !important;
  border: none !important;
  width: 30px !important;
  height: 30px !important;
  font-size: 1rem !important;
  cursor: pointer !important;
  color: var(--cd-sub) !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
}
#CartDrawer .cart__quantity-selector button:hover,
#CartDrawer .cart__item-quantity button:hover {
  background: var(--cd-border) !important;
}
#CartDrawer .cart__quantity-selector input,
#CartDrawer .cart__item-quantity input,
#CartDrawer .cart__qty-input {
  width: 30px !important;
  text-align: center !important;
  font-size: .85rem !important;
  font-weight: 600 !important;
  border: none !important;
  background: transparent !important;
  color: var(--cd-text) !important;
  padding: 0 !important;
  -moz-appearance: textfield !important;
}
#CartDrawer .cart__remove,
#CartDrawer .cart__item-remove a {
  font-size: .7rem !important;
  color: var(--cd-muted) !important;
  text-decoration: none !important;
  opacity: .6;
  transition: opacity .15s;
}
#CartDrawer .cart__remove:hover,
#CartDrawer .cart__item-remove a:hover { opacity: 1; color: #DC2626 !important; }

/* ─── UPSELL SECTION ────────────────────────────────────── */
#Motion-Upsells-Wrapper {
  margin: 0 12px 8px !important;
  background: var(--cd-white) !important;
  border: 1px solid var(--cd-border) !important;
  border-radius: var(--cd-r) !important;
  padding: 14px !important;
  overflow: hidden;
}
.cd-upsell-hd {
  font-size: .75rem;
  font-weight: 700;
  color: var(--cd-muted);
  text-transform: uppercase;
  letter-spacing: .06em;
  margin: 0 0 10px;
}
.upsell-item-candidate {
  display: none;
  align-items: center;
  gap: 12px;
  padding: 10px 0 !important;
  border-top: 1px solid var(--cd-border) !important;
  background: transparent !important;
  border-radius: 0 !important;
  margin: 0 !important;
}
.upsell-item-candidate:first-of-type { border-top: none !important; padding-top: 0 !important; }
.upsell-item-candidate img {
  width: 52px !important; height: 52px !important;
  object-fit: cover !important;
  border-radius: 8px !important;
  flex-shrink: 0;
  background: var(--cd-bg);
}
.cd-upsell-info { flex: 1; min-width: 0; }
.cd-upsell-name {
  font-size: .82rem;
  font-weight: 600;
  color: var(--cd-text);
  line-height: 1.3;
  margin-bottom: 2px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.cd-upsell-price { font-size: .78rem; color: var(--cd-muted); }
.upsell-add-btn {
  flex-shrink: 0;
  background: var(--cd-blue-bg) !important;
  color: var(--cd-navy) !important;
  border: 1.5px solid var(--cd-blue-lt) !important;
  border-radius: 8px !important;
  font-size: .78rem !important;
  font-weight: 700 !important;
  padding: 7px 14px !important;
  cursor: pointer;
  transition: background .15s, transform .1s;
  white-space: nowrap;
}
.upsell-add-btn:hover { background: var(--cd-blue-lt) !important; }
.upsell-add-btn:active { transform: scale(.97); }

/* ─── REBUY ─────────────────────────────────────────────── */
[data-rebuy-id] { padding: 0 12px; }

/* ─── CART NOTES ────────────────────────────────────────── */
.cd-notes { padding: 0 12px 8px; }
.cd-notes label { font-size: .75rem; font-weight: 600; color: var(--cd-sub); display: block; margin-bottom: 4px; }
.cd-notes textarea {
  width: 100%;
  border: 1px solid var(--cd-border) !important;
  border-radius: 8px !important;
  padding: 8px 10px !important;
  font-size: .82rem !important;
  background: var(--cd-white) !important;
  resize: vertical;
  color: var(--cd-text) !important;
  min-height: 70px;
}

/* ─── FOOTER ────────────────────────────────────────────── */
#CartDrawer .drawer__footer {
  flex-shrink: 0;
  padding: 0 !important;
  background: var(--cd-white) !important;
  border-top: 1px solid var(--cd-border) !important;
  box-shadow: 0 -4px 16px rgba(0,0,0,.06) !important;
}

/* Discounts */
#CartDrawer [data-discounts] {
  padding: 0 !important;
}
#CartDrawer .cart__item-sub.cart__item-row {
  margin: 0 !important;
  padding: 10px 18px !important;
  border-radius: 0 !important;
  border: none !important;
  border-bottom: 1px solid var(--cd-border) !important;
  background: var(--cd-bg) !important;
  font-size: .8rem !important;
  color: var(--cd-sub) !important;
  display: flex !important;
  justify-content: space-between !important;
}

/* Savings tag */
#CartDrawer [data-savings],
#CartDrawer .cart__savings {
  display: block !important;
  font-size: .75rem !important;
  font-weight: 700 !important;
  color: var(--cd-green) !important;
  background: transparent !important;
  text-align: right !important;
  padding: 8px 18px 0 !important;
  line-height: 1 !important;
}
#CartDrawer [data-savings].hide,
#CartDrawer .cart__savings.hide { display: none !important; }
#CartDrawer [data-savings] * { font-size: .75rem !important; color: var(--cd-green) !important; }

/* Subtotal / Total */
.cd-summary {
  padding: 10px 18px 14px;
}
.cd-summary-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 3px 0;
}
.cd-summary-row--ship {
  font-size: .78rem;
  color: var(--cd-muted);
}
.cd-summary-row--total {
  padding-top: 10px;
  margin-top: 6px;
  border-top: 1px dashed var(--cd-border);
}
.cd-lbl { font-size: .82rem; font-weight: 500; color: var(--cd-sub); }
.cd-lbl--total { font-size: .95rem; font-weight: 700; color: var(--cd-text); }
.cd-val { font-size: .82rem; color: var(--cd-sub); }
#CartDrawer [data-subtotal],
.cd-val--total {
  font-size: 1.15rem !important;
  font-weight: 800 !important;
  color: var(--cd-navy) !important;
  letter-spacing: -.02em !important;
  line-height: 1 !important;
}

/* ─── TERMS ─────────────────────────────────────────────── */
.cd-terms {
  display: flex;
  align-items: flex-start;
  gap: 8px;
  padding: 0 18px 12px;
}
.cd-terms input[type="checkbox"] {
  accent-color: var(--cd-blue);
  margin-top: 2px;
  flex-shrink: 0;
}
.cd-terms label {
  font-size: .72rem;
  color: var(--cd-muted);
  line-height: 1.5;
}
.cd-terms label a { color: var(--cd-blue); }

/* ─── CTA BUTTON ────────────────────────────────────────── */
.cd-cta { padding: 0 14px 14px; }
#CartDrawer .cart__checkout,
#CartDrawerForm .cart__checkout {
  display: block !important;
  width: 100% !important;
  background: var(--cd-navy) !important;
  color: var(--cd-white) !important;
  border: none !important;
  border-radius: var(--cd-r) !important;
  font-size: .95rem !important;
  font-weight: 700 !important;
  letter-spacing: .02em !important;
  padding: 14px 20px !important;
  cursor: pointer;
  transition: background .15s, transform .1s, box-shadow .15s !important;
  box-shadow: 0 2px 12px rgba(26,58,92,.25) !important;
  text-align: center !important;
}
#CartDrawer .cart__checkout:hover,
#CartDrawerForm .cart__checkout:hover {
  background: #112540 !important;
  box-shadow: 0 4px 18px rgba(26,58,92,.35) !important;
}
#CartDrawer .cart__checkout:active,
#CartDrawerForm .cart__checkout:active { transform: scale(.99) !important; }

/* ─── EXPRESS CHECKOUT ──────────────────────────────────── */
.cd-express-divider {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 0 14px 8px;
  font-size: .7rem;
  color: var(--cd-muted);
  text-transform: uppercase;
  letter-spacing: .05em;
}
.cd-express-divider::before,
.cd-express-divider::after { content:''; flex:1; height:1px; background:var(--cd-border); }
.additional-checkout-buttons { padding: 0 14px 12px !important; }

/* ─── TRUST FOOTER ──────────────────────────────────────── */
.cd-trust {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 10px 16px 16px;
  border-top: 1px solid var(--cd-border);
}
.cd-trust-tp { line-height: 0; }
.cd-trust-tp img { width: 130px; height: auto; }
.cd-payments {
  display: flex;
  flex-wrap: wrap;
  gap: 4px;
  justify-content: flex-end;
  list-style: none;
  margin: 0; padding: 0;
}
.cd-payments li { display: flex; align-items: center; }
.cd-payments svg,
.cd-payments .icon--payment svg { width: 34px !important; height: 22px !important; }

/* ─── EMPTY STATE ───────────────────────────────────────── */
#CartDrawer .drawer__cart-empty { background: var(--cd-bg); }
#CartDrawer .drawer__cart-empty .drawer__scrollable {
  display: flex !important;
  flex-direction: column !important;
  align-items: center !important;
  justify-content: center !important;
  min-height: 70vh !important;
  text-align: center !important;
  padding: 40px 28px !important;
}
.cd-empty-icon {
  width: 80px; height: 80px;
  border-radius: 50%;
  background: var(--cd-white);
  border: 1.5px solid var(--cd-border);
  display: flex; align-items: center; justify-content: center;
  margin: 0 auto 20px;
}
.cd-empty-title {
  font-size: 1.15rem;
  font-weight: 700;
  color: var(--cd-text);
  margin: 0 0 8px;
}
.cd-empty-sub {
  font-size: .85rem;
  color: var(--cd-muted);
  line-height: 1.6;
  margin: 0 0 28px;
}
.cd-empty-btn {
  background: var(--cd-navy) !important;
  color: var(--cd-white) !important;
  border-radius: var(--cd-r) !important;
  font-weight: 700 !important;
  font-size: .9rem !important;
  padding: 13px 32px !important;
  border: none !important;
  box-shadow: 0 2px 12px rgba(26,58,92,.2) !important;
}
</style>

<div id="CartDrawer" class="drawer drawer--right">
  <form id="CartDrawerForm" action="{{ routes.cart_url }}" method="post" novalidate class="drawer__contents">

    <!-- HEADER -->
    <div class="drawer__fixed-header">
      <div class="drawer__header appear-animation appear-delay-1">
        <div class="drawer__title">{{ 'cart.general.title' | t }}</div>
        <div class="drawer__close">
          <button type="button" class="drawer__close-button js-drawer-close">
            <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-close" viewBox="0 0 64 64">
              <path d="M19 17.61l27.12 27.13m0-27.12L19 44.74"/>
            </svg>
            <span class="icon__fallback-text">{{ 'cart.general.close_cart' | t }}</span>
          </button>
        </div>
      </div>

      <!-- MILESTONE BAR -->
      <div class="cd-bar-wrap">
        <div class="cd-bar-msg" id="cd-ms-msg">Beregner fragt…</div>
        <div class="cd-bar-track">
          <div class="cd-bar-fill" id="cd-ms-fill"></div>
          <div class="cd-bar-dot" id="cd-dot-1" style="left:{{ 49900 | divided_by: 129900.0 | times: 100 | round }}%">🚚</div>
          <div class="cd-bar-dot" id="cd-dot-2" style="left:100%">🎁</div>
        </div>
        <div class="cd-bar-row">
          <span class="cd-bar-label" id="cd-lbl-shipping">Gratis fragt</span>
          <span class="cd-bar-label" id="cd-lbl-gift">Gratis gave</span>
        </div>
      </div>
    </div>

    <div id="fsb_placeholder"></div>

    <!-- INNER: scroll + footer -->
    <div class="drawer__inner">
      <div class="drawer__scrollable">

        <!-- Theme-rendered product rows -->
        <div data-products class="appear-animation appear-delay-2"></div>

        <!-- Rebuy -->
        <div data-rebuy-id="56865"></div>

        <!-- UPSELLS -->
        <div id="Motion-Upsells-Wrapper" class="appear-animation appear-delay-3" style="display:none;">
          <p class="cd-upsell-hd">Ofte købt sammen</p>
          <div id="Motion-Upsells-List">
            {% assign upsell_handles = "chi-maskine,feevra-migraene-maske,novared-pro-1500,feevra-recovery-sleeve,feevra-relief-foot-sleeve,massager,handholdt-massager" | split: "," %}
            {% for handle in upsell_handles %}
              {% assign p = all_products[handle] %}
              {% if p != blank and p.available %}
                <div class="upsell-item-candidate" data-handle="{{ p.handle }}">
                  <img src="{{ p.featured_image | image_url: width: 128 }}" alt="{{ p.title }}" width="52" height="52" loading="lazy">
                  <div class="cd-upsell-info">
                    <div class="cd-upsell-name">{{ p.title }}</div>
                    <div class="cd-upsell-price">{{ p.price | money }}</div>
                  </div>
                  <button type="button" class="upsell-add-btn" data-id="{{ p.variants.first.id }}">+ Tilføj</button>
                </div>
              {% endif %}
            {% endfor %}
          </div>
        </div>

        <!-- Cart notes -->
        {% if settings.cart_notes_enable %}
          <div class="cd-notes appear-animation appear-delay-4">
            <label for="CartNoteDrawer">{{ 'cart.general.note' | t }}</label>
            <textarea name="note" class="input-full cart-notes" id="CartNoteDrawer">{{ cart.note }}</textarea>
          </div>
        {% endif %}

      </div><!-- /scrollable -->

      <!-- FOOTER -->
      <div class="drawer__footer appear-animation appear-delay-5">

        <!-- Discounts (theme hook) -->
        <div data-discounts>
          {% if cart.cart_level_discount_applications != blank %}
            <div class="cart__item-sub cart__item-row">
              <div>{{ 'cart.general.discounts' | t }}</div>
              <div class="text-right">
                {% for d in cart.cart_level_discount_applications %}
                  <div>{{ d.title }} (–{{ d.total_allocated_amount | money }})</div>
                {% endfor %}
              </div>
            </div>
          {% endif %}
        </div>

        <!-- Savings (theme hook) -->
        <div class="cart__item-row cart__savings hide" data-savings></div>

        <!-- Summary -->
        <div class="cd-summary">
          <div class="cd-summary-row cd-summary-row--ship" id="cd-ship-row">
            <span>Fragt</span>
            <span id="cd-ship-val">–</span>
          </div>
          <div class="cd-summary-row cd-summary-row--total">
            <span class="cd-lbl cd-lbl--total">I alt</span>
            <span class="cd-val cd-val--total" data-subtotal>{{ cart.total_price | money }}</span>
          </div>
        </div>

        <!-- Terms -->
        {% if settings.cart_terms_conditions_enable %}
          <div class="cd-terms">
            <input type="checkbox" id="CartTermsDrawer" class="cart__terms-checkbox">
            <label for="CartTermsDrawer">
              {% if settings.cart_terms_conditions_page != blank %}
                {{ 'cart.general.terms_html' | t: url: settings.cart_terms_conditions_page.url }}
              {% else %}
                {{ 'cart.general.terms' | t }}
              {% endif %}
            </label>
          </div>
        {% endif %}

        <!-- CTA -->
        <div class="cd-cta">
          <button type="submit" name="checkout"
            data-terms-required="{{ settings.cart_terms_conditions_enable }}"
            class="btn cart__checkout">
            {{ 'cart.general.checkout' | t }}
          </button>
        </div>

        <!-- Express checkout -->
        {% if additional_checkout_buttons and settings.cart_additional_buttons %}
          <div class="cd-express-divider">eller betal med</div>
          <div class="additional-checkout-buttons additional-checkout-buttons--vertical">
            {{ content_for_additional_checkout_buttons }}
          </div>
        {% endif %}

        <!-- Trust: Trustpilot + Payments -->
        <div class="cd-trust">
          <a class="cd-trust-tp" href="https://dk.trustpilot.com/review/feevra.dk" target="_blank" rel="noopener">
            <img src="https://cdn.shopify.com/s/files/1/0892/4269/8075/files/Design_uden_navn_-_2026-03-19T162057.921.png?v=1773908464"
              alt="Fremragende på Trustpilot">
          </a>
          <ul class="cd-payments">
            {% assign enabled_payment_types = 'mobilepay,visa,dankort,master,maestro,american_express' | split: ',' %}
            {% for type in enabled_payment_types %}
              <li>{{ type | payment_type_svg_tag }}</li>
            {% endfor %}
          </ul>
        </div>

      </div><!-- /footer -->
    </div><!-- /inner -->

    <!-- EMPTY STATE -->
    <div class="drawer__cart-empty appear-animation appear-delay-2">
      <div class="drawer__scrollable">
        <div class="cd-empty-icon">
          <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#9CA3AF" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
          </svg>
        </div>
        <h2 class="cd-empty-title">Din kurv er tom</h2>
        <p class="cd-empty-sub">Udforsk vores produkter og<br>find det perfekte til dig.</p>
        <a href="{{ routes.all_products_collection_url }}" class="btn cd-empty-btn">Gå til shoppen</a>
      </div>
    </div>

  </form>
</div>

<script>
(function () {
  'use strict';

  var SHIP_THRESHOLD = 49900;
  var GIFT_THRESHOLD = 129900;

  function updateBar(total) {
    var fill  = document.getElementById('cd-ms-fill');
    var msg   = document.getElementById('cd-ms-msg');
    var dot1  = document.getElementById('cd-dot-1');
    var dot2  = document.getElementById('cd-dot-2');
    var lblS  = document.getElementById('cd-lbl-shipping');
    var lblG  = document.getElementById('cd-lbl-gift');
    var shipRow = document.getElementById('cd-ship-row');
    var shipVal = document.getElementById('cd-ship-val');
    if (!fill || !msg) return;

    var shipPct = (SHIP_THRESHOLD / GIFT_THRESHOLD) * 100;
    if (dot1) dot1.style.left = shipPct.toFixed(1) + '%';

    var pct = Math.min((total / GIFT_THRESHOLD) * 100, 100);
    fill.style.width = pct + '%';

    var shipOk = total >= SHIP_THRESHOLD;
    var giftOk = total >= GIFT_THRESHOLD;

    if (dot1) dot1.classList.toggle('reached', shipOk);
    if (dot2) dot2.classList.toggle('reached', giftOk);
    if (lblS) lblS.classList.toggle('reached', shipOk);
    if (lblG) lblG.classList.toggle('reached', giftOk);

    if (giftOk) {
      msg.innerHTML = 'Du har <strong>gratis fragt</strong> og <strong>gratis gave</strong> 🎁';
    } else if (shipOk) {
      var remG = Math.ceil((GIFT_THRESHOLD - total) / 100);
      msg.innerHTML = '<strong>Gratis fragt!</strong> Mangler <strong>' + remG + ' kr</strong> til gave 🎁';
    } else {
      var remS = Math.ceil((SHIP_THRESHOLD - total) / 100);
      msg.innerHTML = 'Mangler <strong>' + remS + ' kr</strong> til <strong>gratis fragt</strong> 🚚';
    }

    if (shipRow && shipVal) {
      shipVal.textContent = shipOk ? 'Gratis' : '49 kr';
      shipVal.style.color = shipOk ? 'var(--cd-green)' : '';
      shipVal.style.fontWeight = shipOk ? '700' : '';
    }
  }

  function updateUpsells(cart) {
    var inCart = cart.items ? cart.items.map(function(i) { return i.handle; }) : [];
    var visible = 0;
    document.querySelectorAll('.upsell-item-candidate').forEach(function(el) {
      var show = visible < 3 && !inCart.includes(el.dataset.handle);
      el.style.display = show ? 'flex' : 'none';
      if (show) visible++;
    });
    var wrap = document.getElementById('Motion-Upsells-Wrapper');
    if (wrap) wrap.style.display = (visible > 0 && cart.item_count > 0) ? 'block' : 'none';
  }

  function refresh(cart) {
    updateBar(cart.total_price);
    updateUpsells(cart);
  }

  document.addEventListener('DOMContentLoaded', function () {
    fetch('/cart.js').then(function(r){ return r.json(); }).then(refresh);

    document.addEventListener('cart:updated', function(e) {
      if (e.detail && e.detail.cart) {
        refresh(e.detail.cart);
      } else {
        fetch('/cart.js').then(function(r){ return r.json(); }).then(refresh);
      }
    });

    document.querySelectorAll('.upsell-add-btn').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var self = this;
        var orig = self.textContent;
        self.textContent = '…';
        self.disabled = true;
        fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ items: [{ id: self.dataset.id, quantity: 1 }] })
        })
        .then(function(r){ return r.json(); })
        .then(function() {
          self.textContent = '✓ Tilføjet';
          setTimeout(function() {
            self.textContent = orig;
            self.disabled = false;
          }, 1600);
          document.dispatchEvent(new CustomEvent('ajaxProduct:added'));
          fetch('/cart.js').then(function(r){ return r.json(); }).then(refresh);
        })
        .catch(function() {
          self.textContent = orig;
          self.disabled = false;
        });
      });
    });
  });
})();
</script>
{% endif %}
