{% if settings.cart_type == 'drawer' %}
<style>
  /* ─── CART DRAWER – PREMIUM REDESIGN ──────────────────────────── */
  :root {
    --cd-navy:   #1C1A54;
    --cd-gold:   #C9A84C;
    --cd-gold2:  #E8C96A;
    --cd-green:  #1A7A4A;
    --cd-red:    #D94040;
    --cd-bg:     #F5F5F7;
    --cd-white:  #FFFFFF;
    --cd-text:   #1C1A54;
    --cd-muted:  #6B7280;
    --cd-border: #E5E7EB;
    --cd-radius: 12px;
    --cd-shadow: 0 4px 24px rgba(28,26,84,.13);
  }

  /* ── WRAPPER ── */
  #CartDrawer {
    font-family: 'Inter', sans-serif;
    background: var(--cd-white);
  }

  /* ── RISK-FREE TOP BANNER ── */
  .cd-topbanner {
    background: linear-gradient(90deg, #1C1A54 0%, #2d2a7a 100%);
    color: #fff;
    text-align: center;
    padding: 10px 16px;
    font-size: .8rem;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }
  .cd-topbanner svg { flex-shrink: 0; }

  /* ── ROTATING PROMO TICKER ── */
  .cd-ticker-wrap {
    background: #FFFBEB;
    border-bottom: 1px solid #FDE68A;
    overflow: hidden;
    height: 34px;
    display: flex;
    align-items: center;
  }
  .cd-ticker {
    display: flex;
    gap: 60px;
    white-space: nowrap;
    animation: ticker-scroll 22s linear infinite;
  }
  .cd-ticker span {
    font-size: .78rem;
    font-weight: 600;
    color: #92400E;
  }
  @keyframes ticker-scroll {
    0%   { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  /* ── HEADER ── */
  .drawer__header {
    border-bottom: 1px solid var(--cd-border) !important;
    padding: 14px 20px !important;
  }
  .drawer__title {
    font-size: 1.15rem !important;
    font-weight: 800 !important;
    letter-spacing: -.01em !important;
  }
  .cd-item-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--cd-gold);
    color: #fff;
    font-size: .7rem;
    font-weight: 800;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    margin-left: 8px;
    vertical-align: middle;
  }

  /* ── SHIPPING PROGRESS BAR ── */
  .cd-shipping-bar {
    margin: 14px 16px 0;
    padding: 14px 16px;
    background: linear-gradient(135deg, #F0F4FF 0%, #EEF2FF 100%);
    border-radius: var(--cd-radius);
    border: 1px solid #C7D2FE;
  }
  .cd-shipping-bar__label {
    font-size: .82rem;
    font-weight: 600;
    color: var(--cd-navy);
    margin-bottom: 8px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .cd-shipping-bar__label em {
    font-style: normal;
    color: var(--cd-green);
    font-weight: 700;
  }
  .cd-shipping-bar__track {
    background: #C7D2FE;
    border-radius: 99px;
    height: 8px;
    overflow: hidden;
  }
  .cd-shipping-bar__fill {
    background: linear-gradient(90deg, #1C1A54, #4F46E5);
    height: 100%;
    border-radius: 99px;
    transition: width .6s cubic-bezier(.4,0,.2,1);
    width: 0%;
  }
  .cd-shipping-bar__fill.is-free {
    background: linear-gradient(90deg, var(--cd-green), #34D399);
  }
  .cd-shipping-bar--free .cd-shipping-bar__label em {
    color: var(--cd-green);
  }

  /* ── UPSELL SECTION ── */
  #Motion-Upsells-Wrapper {
    padding: 16px !important;
    background: #fff !important;
    border-top: 1px solid var(--cd-border) !important;
  }
  .cd-upsell-heading {
    font-size: .95rem;
    font-weight: 800;
    color: var(--cd-navy);
    margin: 0 0 12px;
    text-align: center;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
  }
  .upsell-item-candidate {
    border-radius: var(--cd-radius) !important;
    border: 1.5px solid var(--cd-border) !important;
    padding: 10px 12px !important;
    margin-bottom: 8px !important;
    background: #FAFAFA !important;
    transition: border-color .2s, box-shadow .2s;
    position: relative;
    overflow: hidden;
  }
  .upsell-item-candidate:hover {
    border-color: var(--cd-navy) !important;
    box-shadow: 0 2px 12px rgba(28,26,84,.1);
  }
  .upsell-item-candidate img {
    border-radius: 8px !important;
    object-fit: cover;
  }
  .cd-badge-hot {
    position: absolute;
    top: 8px;
    left: 8px;
    background: var(--cd-red);
    color: #fff;
    font-size: .62rem;
    font-weight: 800;
    padding: 2px 7px;
    border-radius: 99px;
    letter-spacing: .04em;
    text-transform: uppercase;
    pointer-events: none;
  }
  .upsell-add-btn {
    background: var(--cd-navy) !important;
    color: #fff !important;
    border-radius: 8px !important;
    font-size: .78rem !important;
    font-weight: 700 !important;
    padding: 8px 14px !important;
    border: none !important;
    cursor: pointer !important;
    transition: background .2s, transform .1s;
    white-space: nowrap;
  }
  .upsell-add-btn:hover { background: #2d2a7a !important; }
  .upsell-add-btn:active { transform: scale(.96); }

  /* ── FOOTER ── */
  .drawer__footer {
    padding: 0 !important;
    border-top: 1px solid var(--cd-border) !important;
  }

  /* ── SAVINGS ROW ── */
  .cd-savings-pill {
    background: #DCFCE7;
    color: var(--cd-green);
    font-size: .8rem;
    font-weight: 700;
    text-align: center;
    padding: 8px 16px;
    border-bottom: 1px solid #BBF7D0;
    display: none;
  }

  /* ── SUBTOTAL ── */
  .cd-subtotal-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 14px 18px 6px;
  }
  .cd-subtotal-label {
    font-size: .9rem;
    font-weight: 700;
    color: var(--cd-navy);
  }
  .cd-subtotal-value {
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--cd-navy);
  }

  /* ── DELIVERY NOTE ── */
  .cd-delivery-note {
    text-align: center;
    font-size: .78rem;
    color: var(--cd-green);
    font-weight: 600;
    padding: 4px 16px 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
  }

  /* ── TRUST ICONS ROW ── */
  .cd-trust-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 6px;
    padding: 10px 14px;
    border-top: 1px solid var(--cd-border);
    border-bottom: 1px solid var(--cd-border);
  }
  .cd-trust-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
    font-size: .67rem;
    font-weight: 600;
    color: var(--cd-navy);
    text-align: center;
    line-height: 1.2;
  }
  .cd-trust-item svg { color: var(--cd-navy); }

  /* ── CHECKOUT SECTION ── */
  .cd-checkout-wrap {
    padding: 12px 14px 6px;
  }
  .cart__checkout {
    background: linear-gradient(135deg, #1C1A54 0%, #2d2a7a 100%) !important;
    border: none !important;
    border-radius: 10px !important;
    font-size: 1rem !important;
    font-weight: 800 !important;
    letter-spacing: .03em !important;
    padding: 15px 20px !important;
    position: relative;
    overflow: hidden;
    box-shadow: 0 4px 18px rgba(28,26,84,.35) !important;
    transition: transform .15s, box-shadow .15s !important;
  }
  .cart__checkout:hover {
    transform: translateY(-1px) !important;
    box-shadow: 0 6px 22px rgba(28,26,84,.45) !important;
  }
  .cart__checkout:active { transform: translateY(0) !important; }
  .cart__checkout::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, transparent 0%, rgba(255,255,255,.08) 50%, transparent 100%);
    transform: translateX(-100%);
    animation: shimmer 2.4s ease-in-out infinite;
  }
  @keyframes shimmer {
    0%   { transform: translateX(-100%); }
    60%  { transform: translateX(100%); }
    100% { transform: translateX(100%); }
  }
  .cd-checkout-lock {
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }

  /* ── PAYMENT BRAND ROW ── */
  .cd-payment-row {
    padding: 8px 14px 10px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }
  .cd-payment-row .payment-icons {
    display: flex !important;
    flex-wrap: wrap;
    gap: 5px;
    justify-content: center;
  }

  /* ── EXPRESS CHECKOUT ── */
  .additional-checkout-buttons {
    margin-top: 8px !important;
    padding: 0 !important;
  }
  .cd-or-divider {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 6px 14px 4px;
    color: var(--cd-muted);
    font-size: .73rem;
    font-weight: 500;
  }
  .cd-or-divider::before,
  .cd-or-divider::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--cd-border);
  }

  /* ── EMPTY STATE ── */
  .drawer__cart-empty .drawer__scrollable {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 60vh;
    padding: 40px 24px !important;
  }
  .cd-empty-icon {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: linear-gradient(135deg, #EEF2FF, #E0E7FF);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
  }

  /* ── TERMS ── */
  .cart__terms { padding: 0 14px 8px; font-size: .75rem; }
  .cart__terms-checkbox { accent-color: var(--cd-navy); }

  /* ── DISCOUNT AREA ── */
  .cd-discount-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    font-size: .78rem;
    font-weight: 600;
    color: var(--cd-navy);
    cursor: pointer;
    padding: 6px 14px;
    text-decoration: underline;
    text-underline-offset: 2px;
    background: none;
    border: none;
    width: 100%;
  }

  /* ── MISC ── */
  .drawer__close-button { color: var(--cd-navy) !important; }
</style>

<div id="CartDrawer" class="drawer drawer--right">
  <form id="CartDrawerForm" action="{{ routes.cart_url }}" method="post" novalidate class="drawer__contents">

    <!-- ① RISK-FREE TOPBANNER -->
    <div class="cd-topbanner">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
      35 dages risikofri prøveperiode &nbsp;·&nbsp; Fuld refusion
    </div>

    <!-- ② PROMO TICKER -->
    <div class="cd-ticker-wrap">
      <div class="cd-ticker">
        <span>🚚 Gratis fragt over 499 kr.</span>
        <span>⭐ 4,8 / 5 på Trustpilot</span>
        <span>🔒 Sikker betaling</span>
        <span>📦 1–2 dages levering</span>
        <span>↩️ 35 dages returret</span>
        <span>🇩🇰 Dansk webshop</span>
        <!-- dublicate for seamless loop -->
        <span>🚚 Gratis fragt over 499 kr.</span>
        <span>⭐ 4,8 / 5 på Trustpilot</span>
        <span>🔒 Sikker betaling</span>
        <span>📦 1–2 dages levering</span>
        <span>↩️ 35 dages returret</span>
        <span>🇩🇰 Dansk webshop</span>
      </div>
    </div>

    <!-- ③ HEADER -->
    <div class="drawer__fixed-header">
      <div class="drawer__header appear-animation appear-delay-1">
        <div class="drawer__title" style="color:#1C1A54; font-weight:800;">
          Din kurv
          <span class="cd-item-count" id="cd-item-count">{{ cart.item_count }}</span>
        </div>
        <div class="drawer__close">
          <button type="button" class="drawer__close-button js-drawer-close">
            <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-close" viewBox="0 0 64 64"><path d="M19 17.61l27.12 27.13m0-27.12L19 44.74"/></svg>
            <span class="icon__fallback-text">{{ 'cart.general.close_cart' | t }}</span>
          </button>
        </div>
      </div>
    </div>

    <!-- ④ FREE SHIPPING PROGRESS BAR -->
    <div class="cd-shipping-bar appear-animation appear-delay-1" id="cd-shipping-bar">
      <div class="cd-shipping-bar__label">
        <span id="cd-shipping-msg">Beregner fragt …</span>
        <span>🚚</span>
      </div>
      <div class="cd-shipping-bar__track">
        <div class="cd-shipping-bar__fill" id="cd-shipping-fill"></div>
      </div>
    </div>

    <div id="fsb_placeholder"></div>

    <!-- ⑤ PRODUCT LIST (theme-controlled) -->
    <div class="drawer__inner">
      <div class="drawer__scrollable">
        <div data-products class="appear-animation appear-delay-2"></div>
        <div data-rebuy-id="56865"></div>

        <!-- ⑥ UPSELL SECTION -->
        <div id="Motion-Upsells-Wrapper" class="appear-animation appear-delay-3" style="display:none;">
          <h3 class="cd-upsell-heading">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            Kunder køber også
          </h3>
          <div id="Motion-Upsells-List">
            {% assign upsell_handles = "chi-maskine,feevra-migraene-maske,novared-pro-1500,feevra-recovery-sleeve,feevra-relief-foot-sleeve,massager,handholdt-massager" | split: "," %}
            {% for handle in upsell_handles %}
              {% assign p = all_products[handle] %}
              {% if p != blank and p.available %}
                <div class="upsell-item-candidate" data-handle="{{ p.handle }}" style="display:none; align-items:center; gap:12px;">
                  {% if forloop.index == 1 %}
                    <span class="cd-badge-hot">Bestseller</span>
                  {% endif %}
                  <img src="{{ p.featured_image | image_url: width: 120 }}" alt="{{ p.title }}" width="60" height="60" style="border-radius:8px; object-fit:cover; flex-shrink:0;">
                  <div style="flex-grow:1; min-width:0;">
                    <div style="font-weight:700; font-size:.88rem; color:#1C1A54; line-height:1.25; margin-bottom:3px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">{{ p.title }}</div>
                    <div style="display:flex; align-items:center; gap:6px;">
                      <span style="font-weight:800; font-size:.9rem; color:#1C1A54;">{{ p.price | money }}</span>
                      {% if p.compare_at_price > p.price %}
                        <span style="font-size:.78rem; color:#9CA3AF; text-decoration:line-through;">{{ p.compare_at_price | money }}</span>
                        <span style="font-size:.7rem; background:#DCFCE7; color:#15803D; font-weight:700; padding:1px 6px; border-radius:99px;">
                          -{{ p.compare_at_price | minus: p.price | times: 100 | divided_by: p.compare_at_price }}%
                        </span>
                      {% endif %}
                    </div>
                  </div>
                  <button type="button" class="upsell-add-btn btn" data-id="{{ p.variants.first.id }}">+ Tilføj</button>
                </div>
              {% endif %}
            {% endfor %}
          </div>
        </div>

        <!-- Cart notes -->
        {% if settings.cart_notes_enable %}
          <div class="appear-animation appear-delay-4" style="padding:16px;">
            <label for="CartNoteDrawer" style="font-size:.8rem; font-weight:600; color:#1C1A54;">{{ 'cart.general.note' | t }}</label>
            <textarea name="note" class="input-full cart-notes" id="CartNoteDrawer" style="margin-top:6px; border-radius:8px; font-size:.85rem;">{{ cart.note }}</textarea>
          </div>
        {% endif %}
      </div>

      <!-- ⑦ FOOTER -->
      <div class="drawer__footer appear-animation appear-delay-5">

        <!-- Discounts (theme) -->
        <div data-discounts>
          {% if cart.cart_level_discount_applications != blank %}
            <div class="cart__item-sub cart__item-row" style="padding:10px 16px; background:#DCFCE7; color:#15803D; font-weight:700; font-size:.85rem;">
              <div>{{ 'cart.general.discounts' | t }}</div>
              <div class="text-right">
                {% for cart_discount in cart.cart_level_discount_applications %}
                  <div>{{ cart_discount.title }} (–{{ cart_discount.total_allocated_amount | money }})</div>
                {% endfor %}
              </div>
            </div>
          {% endif %}
        </div>

        <!-- Savings pill -->
        <div class="cd-savings-pill" id="cd-savings-pill" data-savings></div>

        <!-- Subtotal -->
        <div class="cd-subtotal-row">
          <span class="cd-subtotal-label">Subtotal</span>
          <span class="cd-subtotal-value" data-subtotal>{{ cart.total_price | money }}</span>
        </div>

        <!-- Delivery note -->
        <div class="cd-delivery-note">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          1–2 dages levering i hele Danmark 🇩🇰
        </div>

        <!-- ⑧ TRUST ICON ROW -->
        <div class="cd-trust-row">
          <div class="cd-trust-item">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            35 dages returret
          </div>
          <div class="cd-trust-item">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13" rx="2"/><path d="M16 8h4a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2h-4m0-9v9"/><circle cx="7.5" cy="19.5" r="1.5"/><circle cx="19.5" cy="19.5" r="1.5"/></svg>
            Hurtig levering
          </div>
          <div class="cd-trust-item">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            Sikker betaling
          </div>
        </div>

        <!-- Terms -->
        {% if settings.cart_terms_conditions_enable %}
          <div class="cart__item-row cart__terms">
            <input type="checkbox" id="CartTermsDrawer" class="cart__terms-checkbox">
            <label for="CartTermsDrawer" style="font-size:.75rem;">
              {% if settings.cart_terms_conditions_page != blank %}
                {{ 'cart.general.terms_html' | t: url: settings.cart_terms_conditions_page.url }}
              {% else %}
                {{ 'cart.general.terms' | t }}
              {% endif %}
            </label>
          </div>
        {% endif %}

        <!-- ⑨ CHECKOUT BUTTON -->
        <div class="cd-checkout-wrap">
          <button type="submit" name="checkout" data-terms-required="{{ settings.cart_terms_conditions_enable }}" class="btn cart__checkout" style="width:100%;">
            <span class="cd-checkout-lock">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
              Gå til betaling
            </span>
          </button>
        </div>

        <!-- ⑩ EXPRESS CHECKOUT DIVIDER -->
        {% if additional_checkout_buttons and settings.cart_additional_buttons %}
          <div class="cd-or-divider">eller betal med</div>
          <div class="additional-checkout-buttons additional-checkout-buttons--vertical" style="padding:0 14px 8px;">{{ content_for_additional_checkout_buttons }}</div>
        {% endif %}

        <!-- ⑪ TRUSTPILOT + PAYMENT ICONS -->
        <div class="cd-payment-row">
          <a href="https://dk.trustpilot.com/review/feevra.dk" target="_blank" rel="noopener" style="display:block; line-height:0;">
            <img src="https://cdn.shopify.com/s/files/1/0892/4269/8075/files/Design_uden_navn_-_2026-03-19T162057.921.png?v=1773908464" alt="Trustpilot – 4,8 stjerner" style="width:170px; height:auto;">
          </a>
          <ul class="inline-list payment-icons" style="margin:0; padding:0; list-style:none;">
            {% assign enabled_payment_types = 'mobilepay,visa,dankort,master,maestro,american_express' | split: ',' %}
            {% for type in enabled_payment_types %}
              <li class="icon--payment">{{ type | payment_type_svg_tag }}</li>
            {% endfor %}
          </ul>
        </div>

      </div><!-- /drawer__footer -->
    </div><!-- /drawer__inner -->

    <!-- ⑫ EMPTY CART STATE -->
    <div class="drawer__cart-empty appear-animation appear-delay-2">
      <div class="drawer__scrollable">
        <div class="cd-empty-icon">
          <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="#1C1A54" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
        </div>
        <h2 style="color:#1C1A54; font-weight:800; margin:0 0 8px; font-size:1.2rem;">Din kurv er tom</h2>
        <p style="color:#6B7280; margin:0 0 28px; font-size:.9rem; text-align:center; line-height:1.5;">Oplev vores prisbelønnede produkter og find det perfekte til dig.</p>
        <a href="{{ routes.all_products_collection_url }}" class="btn" style="background:#1C1A54; border-radius:10px; font-weight:700; font-size:.95rem; padding:14px 32px; box-shadow:0 4px 16px rgba(28,26,84,.3);">
          Se alle produkter →
        </a>
        <!-- Trust row in empty state too -->
        <div style="display:flex; gap:20px; margin-top:32px; justify-content:center; flex-wrap:wrap;">
          <div style="font-size:.72rem; color:#6B7280; font-weight:600; text-align:center;">🛡️ 35 dages returret</div>
          <div style="font-size:.72rem; color:#6B7280; font-weight:600; text-align:center;">🚚 Hurtig levering</div>
          <div style="font-size:.72rem; color:#6B7280; font-weight:600; text-align:center;">⭐ 4,8 på Trustpilot</div>
        </div>
      </div>
    </div>

  </form>
</div>

<script>
(function() {
  'use strict';

  /* ─── CONFIG ─────────────────────────────────────────────── */
  var FREE_SHIPPING_THRESHOLD = 49900; // øre = 499 kr.

  /* ─── SHIPPING BAR ───────────────────────────────────────── */
  function updateShippingBar(cartTotal) {
    var bar   = document.getElementById('cd-shipping-bar');
    var fill  = document.getElementById('cd-shipping-fill');
    var msg   = document.getElementById('cd-shipping-msg');
    if (!bar || !fill || !msg) return;

    if (cartTotal >= FREE_SHIPPING_THRESHOLD) {
      var pct = 100;
      fill.style.width = '100%';
      fill.classList.add('is-free');
      msg.innerHTML = '<em>✓ Du har gratis fragt!</em>';
      bar.classList.add('cd-shipping-bar--free');
    } else {
      var remaining = FREE_SHIPPING_THRESHOLD - cartTotal;
      var pct = Math.round((cartTotal / FREE_SHIPPING_THRESHOLD) * 100);
      fill.style.width = pct + '%';
      fill.classList.remove('is-free');
      var remainingFormatted = (remaining / 100).toFixed(0);
      msg.innerHTML = 'Tilføj <em>' + remainingFormatted + ' kr.</em> mere for gratis fragt';
      bar.classList.remove('cd-shipping-bar--free');
    }
  }

  /* ─── SAVINGS PILL ───────────────────────────────────────── */
  function updateSavings(cart) {
    var pill = document.getElementById('cd-savings-pill');
    if (!pill) return;
    var savings = 0;
    if (cart.items) {
      cart.items.forEach(function(item) {
        if (item.compare_at_price && item.compare_at_price > item.price) {
          savings += (item.compare_at_price - item.price) * item.quantity;
        }
      });
    }
    if (savings > 0) {
      var formatted = (savings / 100).toFixed(0);
      pill.textContent = '🎉 Du sparer ' + formatted + ' kr. på denne ordre!';
      pill.style.display = 'block';
    } else {
      pill.style.display = 'none';
    }
  }

  /* ─── ITEM COUNT BADGE ───────────────────────────────────── */
  function updateItemCount(count) {
    var badge = document.getElementById('cd-item-count');
    if (badge) badge.textContent = count;
  }

  /* ─── UPSELLS ────────────────────────────────────────────── */
  function updateUpsells(cartData) {
    var handlesInCart = cartData && cartData.items
      ? cartData.items.map(function(i) { return i.handle; })
      : [];
    var candidates = document.querySelectorAll('.upsell-item-candidate');
    var visible = 0;
    candidates.forEach(function(el) {
      if (visible < 3 && !handlesInCart.includes(el.dataset.handle)) {
        el.style.display = 'flex';
        visible++;
      } else {
        el.style.display = 'none';
      }
    });
    var wrapper = document.getElementById('Motion-Upsells-Wrapper');
    if (wrapper) {
      wrapper.style.display = (visible > 0 && cartData.item_count > 0) ? 'block' : 'none';
    }
  }

  /* ─── FULL REFRESH ───────────────────────────────────────── */
  function refreshCart(cart) {
    updateShippingBar(cart.total_price);
    updateSavings(cart);
    updateItemCount(cart.item_count);
    updateUpsells(cart);
  }

  /* ─── INIT ───────────────────────────────────────────────── */
  document.addEventListener('DOMContentLoaded', function() {
    // Initial load
    fetch('/cart.js')
      .then(function(r) { return r.json(); })
      .then(refreshCart);

    // Theme event
    document.addEventListener('cart:updated', function(evt) {
      if (evt.detail && evt.detail.cart) {
        refreshCart(evt.detail.cart);
      } else {
        fetch('/cart.js').then(function(r) { return r.json(); }).then(refreshCart);
      }
    });

    // ─── UPSELL ADD ───────────────────────────────────────────
    document.querySelectorAll('.upsell-add-btn').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var self = this;
        var variantId = self.dataset.id;
        var originalText = self.textContent;
        self.textContent = '…';
        self.disabled = true;

        fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ items: [{ id: variantId, quantity: 1 }] })
        })
        .then(function(r) { return r.json(); })
        .then(function() {
          self.textContent = '✓ Tilføjet';
          self.style.background = '#1A7A4A';
          setTimeout(function() {
            self.textContent = originalText;
            self.style.background = '';
            self.disabled = false;
          }, 1600);
          // Tell Motion theme to reload cart
          document.dispatchEvent(new CustomEvent('ajaxProduct:added'));
          // Also re-fetch to update bar
          fetch('/cart.js').then(function(r) { return r.json(); }).then(refreshCart);
        })
        .catch(function() {
          self.textContent = originalText;
          self.disabled = false;
        });
      });
    });
  });
})();
</script>
{% endif %}
