{% if settings.cart_type == 'drawer' %}
<style>
  /* ─── CART DRAWER – CLEAN REDESIGN (matching reference) ────── */
  :root {
    --cd-blue:    #6B9DC8;
    --cd-blue-lt: #A8C8E0;
    --cd-blue-bg: #EAF3FA;
    --cd-text:    #1A1A1A;
    --cd-muted:   #6B7280;
    --cd-border:  #E5E7EB;
    --cd-bg:      #F4F6F8;
    --cd-white:   #FFFFFF;
    --cd-radius:  12px;
  }

  #CartDrawer {
    font-family: -apple-system, BlinkMacSystemFont, 'Inter', sans-serif;
    background: var(--cd-white);
    color: var(--cd-text);
  }

  /* ── MILESTONE BAR ── */
  .cd-milestone-wrap {
    background: var(--cd-white);
    padding: 14px 18px 12px;
    border-bottom: 1px solid var(--cd-border);
  }
  .cd-milestone-msg {
    font-size: .88rem;
    font-weight: 400;
    color: var(--cd-text);
    text-align: center;
    margin-bottom: 10px;
    line-height: 1.4;
  }
  .cd-milestone-msg strong { font-weight: 700; }
  .cd-milestone-track {
    background: #D8E8F2;
    border-radius: 99px;
    height: 9px;
    position: relative;
    overflow: visible;
    margin-bottom: 8px;
  }
  .cd-milestone-fill {
    background: var(--cd-blue);
    height: 100%;
    border-radius: 99px;
    transition: width .6s cubic-bezier(.4,0,.2,1);
    width: 0%;
    position: relative;
  }
  /* milestone dot markers */
  .cd-milestone-dot {
    position: absolute;
    top: 50%;
    transform: translate(-50%, -50%);
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--cd-white);
    border: 2.5px solid var(--cd-blue);
    z-index: 2;
  }
  .cd-milestone-dot.reached {
    background: var(--cd-blue);
  }
  .cd-milestone-labels {
    display: flex;
    justify-content: space-between;
    font-size: .73rem;
    font-weight: 600;
    color: var(--cd-muted);
    margin-top: 4px;
  }
  .cd-milestone-labels span.reached { color: var(--cd-blue); }

  /* ── HEADER ── */
  .drawer__fixed-header { border-bottom: 1px solid var(--cd-border) !important; }
  .drawer__header { padding: 14px 18px !important; }
  .drawer__title {
    font-size: 1.1rem !important;
    font-weight: 700 !important;
    color: var(--cd-text) !important;
    letter-spacing: -.01em !important;
  }
  .drawer__close-button { color: var(--cd-text) !important; }

  /* ── SCROLLABLE AREA ── */
  .drawer__scrollable { background: var(--cd-white); }

  /* ── UPSELL SECTION ── */
  #Motion-Upsells-Wrapper {
    padding: 20px 16px !important;
    background: var(--cd-white) !important;
    border-top: 1px solid var(--cd-border) !important;
    border-bottom: 1px solid var(--cd-border) !important;
  }
  .cd-upsell-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--cd-text);
    text-align: center;
    margin: 0 0 14px;
  }
  .upsell-item-candidate {
    display: none;
    align-items: center;
    gap: 14px;
    background: var(--cd-bg) !important;
    border: 1px solid transparent !important;
    border-radius: var(--cd-radius) !important;
    padding: 12px 14px !important;
    margin-bottom: 10px !important;
    transition: border-color .2s;
  }
  .upsell-item-candidate:last-child { margin-bottom: 0 !important; }
  .upsell-item-candidate:hover { border-color: var(--cd-blue-lt) !important; }
  .upsell-item-candidate img {
    width: 64px !important;
    height: 64px !important;
    object-fit: cover;
    border-radius: 8px !important;
    flex-shrink: 0;
    background: var(--cd-white);
  }
  .cd-upsell-info { flex-grow: 1; min-width: 0; }
  .cd-upsell-name {
    font-size: .9rem;
    font-weight: 700;
    color: var(--cd-text);
    line-height: 1.3;
    margin-bottom: 3px;
  }
  .cd-upsell-price {
    font-size: .85rem;
    color: var(--cd-muted);
    font-weight: 400;
  }
  .upsell-add-btn {
    flex-shrink: 0;
    background: var(--cd-blue) !important;
    color: var(--cd-white) !important;
    border: none !important;
    border-radius: 8px !important;
    font-size: .85rem !important;
    font-weight: 600 !important;
    padding: 10px 18px !important;
    cursor: pointer;
    transition: opacity .15s, transform .1s;
    white-space: nowrap;
    min-width: 74px;
    text-align: center;
  }
  .upsell-add-btn:hover  { opacity: .88; }
  .upsell-add-btn:active { transform: scale(.96); }

  /* ── FOOTER ── */
  .drawer__footer {
    padding: 0 !important;
    border-top: 1px solid var(--cd-border) !important;
    background: var(--cd-white);
  }

  /* Discounts */
  .cart__item-sub.cart__item-row {
    padding: 10px 18px !important;
    font-size: .85rem !important;
  }

  /* Savings row */
  .cart__item-row.cart__savings {
    background: #EAF7F0;
    color: #1A7A4A;
    padding: 8px 18px !important;
    font-size: .82rem !important;
    font-weight: 600 !important;
  }

  /* ── TOTAL ROW ── */
  .cd-total-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 18px 18px 4px;
  }
  .cd-total-label {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--cd-text);
  }
  .cd-total-value {
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--cd-text);
    letter-spacing: -.01em;
  }

  /* ── DELIVERY NOTE ── */
  .cd-delivery {
    text-align: center;
    font-size: .8rem;
    color: var(--cd-muted);
    padding: 4px 18px 14px;
  }

  /* ── CHECKOUT BTN ── */
  .cd-checkout-wrap { padding: 0 16px 14px; }
  .cart__checkout {
    background: var(--cd-blue) !important;
    border: none !important;
    border-radius: 10px !important;
    font-size: 1.05rem !important;
    font-weight: 700 !important;
    color: var(--cd-white) !important;
    padding: 15px 20px !important;
    width: 100% !important;
    letter-spacing: .01em !important;
    box-shadow: 0 2px 10px rgba(107,157,200,.35) !important;
    transition: opacity .15s, transform .1s !important;
  }
  .cart__checkout:hover  { opacity: .9 !important; }
  .cart__checkout:active { transform: scale(.99) !important; }

  /* ── EXPRESS CHECKOUT ── */
  .cd-or-divider {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 2px 16px 8px;
    font-size: .73rem;
    color: var(--cd-muted);
  }
  .cd-or-divider::before, .cd-or-divider::after {
    content: ''; flex: 1; height: 1px; background: var(--cd-border);
  }
  .additional-checkout-buttons { padding: 0 16px 10px !important; }

  /* ── TRUSTPILOT + PAYMENTS ── */
  .cd-trust-foot {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    padding: 10px 16px 18px;
    border-top: 1px solid var(--cd-border);
  }
  .cd-trust-foot .payment-icons {
    display: flex !important;
    flex-wrap: wrap;
    gap: 6px;
    justify-content: center;
    list-style: none;
    margin: 0; padding: 0;
  }

  /* ── TERMS ── */
  .cart__terms {
    padding: 0 16px 10px !important;
    font-size: .75rem !important;
    align-items: flex-start !important;
    gap: 6px !important;
  }
  .cart__terms-checkbox { accent-color: var(--cd-blue); margin-top: 2px; }

  /* ── EMPTY STATE ── */
  .drawer__cart-empty .drawer__scrollable {
    display: flex !important;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 65vh;
    text-align: center;
    padding: 40px 24px !important;
  }
  .cd-empty-bag {
    width: 72px; height: 72px;
    border-radius: 50%;
    background: var(--cd-blue-bg);
    display: flex; align-items: center; justify-content: center;
    margin: 0 auto 20px;
  }
  .cd-empty-title {
    font-size: 1.2rem; font-weight: 700;
    color: var(--cd-text); margin: 0 0 8px;
  }
  .cd-empty-sub {
    font-size: .88rem; color: var(--cd-muted);
    margin: 0 0 28px; line-height: 1.5;
  }
  .cd-empty-btn {
    background: var(--cd-blue) !important;
    border-radius: 10px !important;
    font-weight: 700 !important;
    font-size: .95rem !important;
    padding: 14px 36px !important;
    color: var(--cd-white) !important;
  }
</style>

<div id="CartDrawer" class="drawer drawer--right">
  <form id="CartDrawerForm" action="{{ routes.cart_url }}" method="post" novalidate class="drawer__contents">

    <!-- ① DUAL-MILESTONE PROGRESS BAR -->
    <div class="cd-milestone-wrap">
      <div class="cd-milestone-msg" id="cd-ms-msg">Beregner fragt …</div>
      <div class="cd-milestone-track">
        <div class="cd-milestone-fill" id="cd-ms-fill"></div>
        <!-- milestone 1: free shipping -->
        <div class="cd-milestone-dot" id="cd-dot-1" style="left: {{ 49900 | divided_by: 129900.0 | times: 100 | round }}%"></div>
        <!-- milestone 2: free gift -->
        <div class="cd-milestone-dot" id="cd-dot-2" style="left: 100%"></div>
      </div>
      <div class="cd-milestone-labels">
        <span id="cd-lbl-shipping">Gratis fragt</span>
        <span id="cd-lbl-gift">Gratis gave</span>
      </div>
    </div>

    <!-- ② HEADER -->
    <div class="drawer__fixed-header">
      <div class="drawer__header appear-animation appear-delay-1">
        <div class="drawer__title">{{ 'cart.general.title' | t }}</div>
        <div class="drawer__close">
          <button type="button" class="drawer__close-button js-drawer-close">
            <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-close" viewBox="0 0 64 64">
              <path d="M19 17.61l27.12 27.13m0-27.12L19 44.74"/>
            </svg>
            <span class="icon__fallback-text">{{ 'cart.general.close_cart' | t }}</span>
          </button>
        </div>
      </div>
    </div>

    <div id="fsb_placeholder"></div>

    <!-- ③ PRODUCT LIST + UPSELLS -->
    <div class="drawer__inner">
      <div class="drawer__scrollable">

        <!-- Theme-rendered product rows -->
        <div data-products class="appear-animation appear-delay-2"></div>
        <div data-rebuy-id="56865"></div>

        <!-- ④ UPSELL SECTION -->
        <div id="Motion-Upsells-Wrapper" class="appear-animation appear-delay-3" style="display:none;">
          <h3 class="cd-upsell-title">Vi anbefaler også</h3>
          <div id="Motion-Upsells-List">
            {% assign upsell_handles = "chi-maskine,feevra-migraene-maske,novared-pro-1500,feevra-recovery-sleeve,feevra-relief-foot-sleeve,massager,handholdt-massager" | split: "," %}
            {% for handle in upsell_handles %}
              {% assign p = all_products[handle] %}
              {% if p != blank and p.available %}
                <div class="upsell-item-candidate" data-handle="{{ p.handle }}">
                  <img src="{{ p.featured_image | image_url: width: 128 }}" alt="{{ p.title }}" width="64" height="64">
                  <div class="cd-upsell-info">
                    <div class="cd-upsell-name">{{ p.title }}</div>
                    <div class="cd-upsell-price">{{ p.price | money }}</div>
                  </div>
                  <button type="button" class="upsell-add-btn" data-id="{{ p.variants.first.id }}">Tilføj</button>
                </div>
              {% endif %}
            {% endfor %}
          </div>
        </div>

        <!-- Cart notes -->
        {% if settings.cart_notes_enable %}
          <div class="appear-animation appear-delay-4" style="padding:16px;">
            <label for="CartNoteDrawer" style="font-size:.8rem; font-weight:600; color:var(--cd-text);">
              {{ 'cart.general.note' | t }}
            </label>
            <textarea name="note" class="input-full cart-notes" id="CartNoteDrawer" style="margin-top:6px; border-radius:8px;">{{ cart.note }}</textarea>
          </div>
        {% endif %}

      </div><!-- /drawer__scrollable -->

      <!-- ⑤ FOOTER -->
      <div class="drawer__footer appear-animation appear-delay-5">

        <!-- Discounts (theme hook) -->
        <div data-discounts>
          {% if cart.cart_level_discount_applications != blank %}
            <div class="cart__item-sub cart__item-row">
              <div>{{ 'cart.general.discounts' | t }}</div>
              <div class="text-right">
                {% for d in cart.cart_level_discount_applications %}
                  <div>{{ d.title }} (–{{ d.total_allocated_amount | money }})</div>
                {% endfor %}
              </div>
            </div>
          {% endif %}
        </div>

        <!-- Savings (theme hook) -->
        <div class="cart__item-row cart__savings hide" data-savings></div>

        <!-- Total row -->
        <div class="cd-total-row">
          <span class="cd-total-label">I alt</span>
          <span class="cd-total-value" data-subtotal>{{ cart.total_price | money_with_currency }}</span>
        </div>

        <!-- Delivery note -->
        <div class="cd-delivery">1-2 dages levering i hele Danmark 🇩🇰</div>

        <!-- Terms -->
        {% if settings.cart_terms_conditions_enable %}
          <div class="cart__item-row cart__terms">
            <input type="checkbox" id="CartTermsDrawer" class="cart__terms-checkbox">
            <label for="CartTermsDrawer">
              {% if settings.cart_terms_conditions_page != blank %}
                {{ 'cart.general.terms_html' | t: url: settings.cart_terms_conditions_page.url }}
              {% else %}
                {{ 'cart.general.terms' | t }}
              {% endif %}
            </label>
          </div>
        {% endif %}

        <!-- Checkout button -->
        <div class="cd-checkout-wrap">
          <button type="submit" name="checkout"
            data-terms-required="{{ settings.cart_terms_conditions_enable }}"
            class="btn cart__checkout">
            Gå til betaling
          </button>
        </div>

        <!-- Express checkout -->
        {% if additional_checkout_buttons and settings.cart_additional_buttons %}
          <div class="cd-or-divider">eller betal med</div>
          <div class="additional-checkout-buttons additional-checkout-buttons--vertical">
            {{ content_for_additional_checkout_buttons }}
          </div>
        {% endif %}

        <!-- Trustpilot + payment icons -->
        <div class="cd-trust-foot">
          <a href="https://dk.trustpilot.com/review/feevra.dk" target="_blank" rel="noopener" style="display:block; line-height:0;">
            <img src="https://cdn.shopify.com/s/files/1/0892/4269/8075/files/Design_uden_navn_-_2026-03-19T162057.921.png?v=1773908464"
              alt="Fremragende på Trustpilot" style="width:185px; height:auto;">
          </a>
          <ul class="inline-list payment-icons">
            {% assign enabled_payment_types = 'mobilepay,visa,dankort,master,maestro,american_express' | split: ',' %}
            {% for type in enabled_payment_types %}
              <li class="icon--payment">{{ type | payment_type_svg_tag }}</li>
            {% endfor %}
          </ul>
        </div>

      </div><!-- /drawer__footer -->
    </div><!-- /drawer__inner -->

    <!-- ⑥ EMPTY CART STATE -->
    <div class="drawer__cart-empty appear-animation appear-delay-2">
      <div class="drawer__scrollable">
        <div class="cd-empty-bag">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#6B9DC8" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
          </svg>
        </div>
        <h2 class="cd-empty-title">Din kurv er tom</h2>
        <p class="cd-empty-sub">Men det behøver den ikke være…<br>Udforsk vores produkter og find det perfekte til dig.</p>
        <a href="{{ routes.all_products_collection_url }}" class="btn cd-empty-btn">Gå til shoppen</a>
      </div>
    </div>

  </form>
</div>

<script>
(function () {
  'use strict';

  /* ─── THRESHOLDS (øre) ─────────────────────────── */
  var SHIP_THRESHOLD = 49900;   // 499 kr → gratis fragt
  var GIFT_THRESHOLD = 129900;  // 1.299 kr → gratis gave

  /* ─── MILESTONE BAR ──────────────────────────────── */
  function updateMilestoneBar(total) {
    var fill   = document.getElementById('cd-ms-fill');
    var msg    = document.getElementById('cd-ms-msg');
    var dot1   = document.getElementById('cd-dot-1');
    var dot2   = document.getElementById('cd-dot-2');
    var lblS   = document.getElementById('cd-lbl-shipping');
    var lblG   = document.getElementById('cd-lbl-gift');
    if (!fill || !msg) return;

    /* positions */
    var shipPct = (SHIP_THRESHOLD / GIFT_THRESHOLD) * 100;
    if (dot1) dot1.style.left = shipPct.toFixed(1) + '%';

    var pct = Math.min((total / GIFT_THRESHOLD) * 100, 100);
    fill.style.width = pct + '%';

    var shipReached = total >= SHIP_THRESHOLD;
    var giftReached = total >= GIFT_THRESHOLD;

    if (dot1) dot1.classList.toggle('reached', shipReached);
    if (dot2) dot2.classList.toggle('reached', giftReached);
    if (lblS) lblS.classList.toggle('reached', shipReached);
    if (lblG) lblG.classList.toggle('reached', giftReached);

    if (giftReached) {
      msg.innerHTML = 'Du har <strong>gratis fragt</strong> og <strong>gratis gave</strong>! 🎁';
    } else if (shipReached) {
      var rem = Math.ceil((GIFT_THRESHOLD - total) / 100);
      msg.innerHTML = 'Du har <strong>gratis fragt!</strong> Mangler <strong>' + rem + ' kr</strong> til gave 🎁';
    } else {
      var remShip = Math.ceil((SHIP_THRESHOLD - total) / 100);
      msg.innerHTML = 'Mangler <strong>' + remShip + ' kr</strong> til <strong>gratis fragt</strong> 🚚';
    }
  }

  /* ─── UPSELLS ────────────────────────────────────── */
  function updateUpsells(cart) {
    var inCart = cart.items ? cart.items.map(function(i) { return i.handle; }) : [];
    var visible = 0;
    document.querySelectorAll('.upsell-item-candidate').forEach(function(el) {
      var show = visible < 3 && !inCart.includes(el.dataset.handle);
      el.style.display = show ? 'flex' : 'none';
      if (show) visible++;
    });
    var wrap = document.getElementById('Motion-Upsells-Wrapper');
    if (wrap) wrap.style.display = (visible > 0 && cart.item_count > 0) ? 'block' : 'none';
  }

  /* ─── FULL REFRESH ───────────────────────────────── */
  function refreshCart(cart) {
    updateMilestoneBar(cart.total_price);
    updateUpsells(cart);
  }

  /* ─── INIT ───────────────────────────────────────── */
  document.addEventListener('DOMContentLoaded', function () {

    fetch('/cart.js').then(function(r) { return r.json(); }).then(refreshCart);

    document.addEventListener('cart:updated', function(evt) {
      if (evt.detail && evt.detail.cart) {
        refreshCart(evt.detail.cart);
      } else {
        fetch('/cart.js').then(function(r) { return r.json(); }).then(refreshCart);
      }
    });

    /* upsell add-to-cart */
    document.querySelectorAll('.upsell-add-btn').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var self = this;
        var orig = self.textContent;
        self.textContent = '…';
        self.disabled = true;

        fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ items: [{ id: self.dataset.id, quantity: 1 }] })
        })
        .then(function(r) { return r.json(); })
        .then(function() {
          self.textContent = '✓';
          setTimeout(function() {
            self.textContent = orig;
            self.disabled = false;
          }, 1400);
          document.dispatchEvent(new CustomEvent('ajaxProduct:added'));
          fetch('/cart.js').then(function(r) { return r.json(); }).then(refreshCart);
        })
        .catch(function() {
          self.textContent = orig;
          self.disabled = false;
        });
      });
    });

  });
})();
</script>
{% endif %}
