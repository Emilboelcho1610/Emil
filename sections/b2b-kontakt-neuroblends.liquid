{%- liquid
  assign margin_top = section.settings.logo_margin_top
  assign margin_bottom = section.settings.logo_margin_bottom
  assign padding_top = section.settings.logo_padding_top
  assign padding_bottom = section.settings.logo_padding_bottom
  assign logo_background_color = section.settings.logo_background_color

  assign full_width = section.settings.logo_full_width
  assign content_width = section.settings.logo_content_width

  assign border_thickness = section.settings.logo_border_thickness
  assign border_color = section.settings.logo_border_color

  assign ss_title = section.settings.logo_title
  assign header_size = section.settings.logo_header_size
  assign header_color = section.settings.logo_header_color
  assign header_align = section.settings.logo_header_align
  assign heading_custom = section.settings.logo_heading_custom
  assign heading_font = section.settings.logo_heading_font

  assign sliders_mt = section.settings.logo_sliders_mt
  assign logo_padding_top_inner = section.settings.logo_padding_top_inner
  assign logo_padding_bottom_inner = section.settings.logo_padding_bottom_inner
  assign shadow = section.settings.logo_shadow
  assign scrolling_velocity = section.settings.logo_scrolling_velocity
  assign pause_hover = section.settings.logo_pause_hover
  assign slider_background_color = section.settings.logo_slider_background_color
  assign slider_gap_mobile = section.settings.logo_slider_gap_mobile
  assign slider_gap = section.settings.logo_slider_gap
  assign slider_direction = section.settings.logo_slider_direction

  assign icon_width = section.settings.logo_icon_width
-%}

