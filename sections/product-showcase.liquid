{%- comment -%}
  ================================================================
  PRODUKT SHOWCASE — Premium Shopify Section
  ================================================================
  Desktop: 4-column grid (rows of 4, wraps naturally)
  Mobile:  Horizontal swipe slider (default) or stacked grid
  ================================================================
{%- endcomment -%}

{%- liquid
  assign section_id    = section.id
  assign card_style    = section.settings.card_style
  assign cta_text      = section.settings.cta_text
  assign mobile_layout = section.settings.mobile_layout
-%}

<style>
  /* ============================================================
     1. CUSTOM PROPERTIES
     ============================================================ */
  #PS-{{ section_id }} {
    --ps-accent: {{ section.settings.accent_color }};
    --ps-bg: {{ section.settings.bg_color }};
    --ps-card-bg: {{ section.settings.card_bg_color }};
    --ps-text: {{ section.settings.text_color }};
    --ps-text-muted: {{ section.settings.text_color | color_modify: 'alpha', 0.5 }};
    --ps-star: {{ section.settings.star_color }};
    --ps-star-empty: {{ section.settings.text_color | color_modify: 'alpha', 0.15 }};
    --ps-radius: {{ section.settings.card_radius }}px;
    --ps-gap: {{ section.settings.grid_gap }}px;
    --ps-transition: 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* ============================================================
     2. SECTION WRAPPER
     ============================================================ */
  .ps-showcase {
    background: var(--ps-bg);
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }
  .ps-inner {
    max-width: 1360px;
    margin: 0 auto;
    padding: 0 40px;
  }

  /* ============================================================
     3. HEADER
     ============================================================ */
  .ps-header {
    text-align: center;
    margin-bottom: 52px;
    max-width: 640px;
    margin-left: auto;
    margin-right: auto;
  }
  .ps-subheading {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ps-accent);
    margin-bottom: 14px;
  }
  .ps-subheading::before,
  .ps-subheading::after {
    content: '';
    width: 24px;
    height: 1.5px;
    background: var(--ps-accent);
    opacity: 0.35;
  }
  .ps-heading {
    font-size: clamp(1.75rem, 4.5vw, 2.85rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.12;
    color: var(--ps-text);
    margin: 0 0 10px;
  }
  .ps-description {
    font-size: 1.02rem;
    line-height: 1.6;
    color: var(--ps-text-muted);
    margin: 0;
  }

  /* ============================================================
     4. DESKTOP GRID — simple 4-column rows
     ============================================================ */
  .ps-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--ps-gap);
  }

  /* ============================================================
     5. CARD
     ============================================================ */
  .ps-card {
    position: relative;
    display: flex;
    flex-direction: column;
    border-radius: var(--ps-radius);
    overflow: hidden;
    background: var(--ps-card-bg);
    text-decoration: none;
    color: inherit;
    cursor: pointer;
    /* Scroll reveal */
    opacity: 0;
    transform: translateY(36px);
    transition: transform var(--ps-transition), box-shadow var(--ps-transition);
  }
  .ps-card.ps-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Card style variants */
  .ps-card--shadow {
    box-shadow: 0 1px 4px rgba(0,0,0,0.04), 0 4px 14px rgba(0,0,0,0.035);
  }
  .ps-card--shadow.ps-visible:hover {
    transform: translateY(-7px);
    box-shadow: 0 22px 44px rgba(0,0,0,0.10), 0 2px 6px rgba(0,0,0,0.04);
  }
  .ps-card--outline {
    box-shadow: none;
    border: 1.5px solid var(--ps-text-muted);
  }
  .ps-card--outline.ps-visible:hover {
    transform: translateY(-7px);
    border-color: var(--ps-accent);
    box-shadow: 0 22px 44px rgba(0,0,0,0.08);
  }
  .ps-card--flat { box-shadow: none; }
  .ps-card--flat.ps-visible:hover { transform: translateY(-4px); }

  /* ============================================================
     6. IMAGE
     ============================================================ */
  .ps-card__img-wrap {
    position: relative;
    overflow: hidden;
    background: color-mix(in srgb, var(--ps-text) 5%, transparent);
    aspect-ratio: 3 / 4;
  }
  .ps-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition:
      opacity 0.55s cubic-bezier(0.22,1,0.36,1),
      transform 0.85s cubic-bezier(0.22,1,0.36,1);
  }
  .ps-card__img--hover {
    position: absolute;
    inset: 0;
    opacity: 0;
  }
  .ps-card:hover .ps-card__img--primary { opacity: 0; }
  .ps-card:hover .ps-card__img--hover { opacity: 1; }
  .ps-card:hover .ps-card__img { transform: scale(1.05); }

  /* Quick-view overlay (desktop only) */
  .ps-card__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding-bottom: 20px;
    background: linear-gradient(0deg, rgba(0,0,0,0.32) 0%, transparent 48%);
    opacity: 0;
    transition: opacity 0.4s;
    pointer-events: none;
    z-index: 2;
  }
  .ps-card:hover .ps-card__overlay { opacity: 1; pointer-events: auto; }
  .ps-card__quick-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 11px 26px;
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ps-text);
    background: var(--ps-card-bg);
    border: none;
    border-radius: 100px;
    cursor: pointer;
    transform: translateY(10px);
    transition: transform 0.4s cubic-bezier(0.22,1,0.36,1), background 0.3s, color 0.3s;
    text-decoration: none;
  }
  .ps-card:hover .ps-card__quick-btn { transform: translateY(0); }
  .ps-card__quick-btn:hover { background: var(--ps-accent); color: #fff; }

  /* Placeholder */
  .ps-card__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    background: color-mix(in srgb, var(--ps-text) 4%, transparent);
  }
  .ps-placeholder-svg { width: 48%; height: auto; opacity: 0.15; }

  /* ============================================================
     7. BADGE — always inside image area, never overlaps body
     ============================================================ */
  .ps-badge {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 3;
    padding: 5px 12px;
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #fff;
    border-radius: 100px;
    line-height: 1.3;
    max-width: calc(100% - 24px);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .ps-badge--dark   { background: #111; }
  .ps-badge--accent { background: var(--ps-accent); }
  .ps-badge--sale   { background: #e74c3c; }
  .ps-badge--new    { background: #27ae60; }

  /* Sold-out overlay */
  .ps-card__soldout {
    position: absolute;
    inset: 0;
    z-index: 4;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255,255,255,0.7);
    backdrop-filter: blur(2px);
  }
  .ps-card__soldout-pill {
    padding: 8px 20px;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #fff;
    background: #111;
    border-radius: 100px;
  }

  /* ============================================================
     8. CARD BODY
     ============================================================ */
  .ps-card__body {
    padding: 18px 20px 22px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    flex-shrink: 0;
    min-width: 0;
  }
  .ps-card__vendor {
    font-size: 0.67rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ps-text-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .ps-card__title {
    font-size: 0.95rem;
    font-weight: 700;
    line-height: 1.3;
    margin: 0;
    color: var(--ps-text);
    transition: color 0.3s;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .ps-card:hover .ps-card__title { color: var(--ps-accent); }

  .ps-card__desc {
    font-size: 0.8rem;
    line-height: 1.45;
    color: var(--ps-text-muted);
    margin: 2px 0 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ============================================================
     9. STARS
     ============================================================ */
  .ps-rating {
    display: flex;
    align-items: center;
    gap: 6px;
    margin: 2px 0;
    flex-wrap: nowrap;
    min-width: 0;
  }
  .ps-stars {
    position: relative;
    display: inline-flex;
    flex-shrink: 0;
    line-height: 1;
  }
  .ps-stars__row {
    display: flex;
    gap: 1.5px;
  }
  .ps-stars__empty .ps-star { color: var(--ps-star-empty); }
  .ps-stars__filled {
    position: absolute;
    top: 0; left: 0;
    display: flex;
    gap: 1.5px;
    overflow: hidden;
    width: calc(var(--ps-rating) / 5 * 100%);
  }
  .ps-stars__filled .ps-star { color: var(--ps-star); }
  .ps-star { width: 14px; height: 14px; flex-shrink: 0; }
  .ps-review-count {
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--ps-text-muted);
    white-space: nowrap;
  }

  /* ============================================================
     10. PRICE
     ============================================================ */
  .ps-price {
    display: flex;
    align-items: baseline;
    gap: 7px;
    flex-wrap: wrap;
    margin-top: 3px;
  }
  .ps-price__now {
    font-size: 1.02rem;
    font-weight: 800;
    color: var(--ps-text);
  }
  .ps-price__now--sale { color: #e74c3c; }
  .ps-price__was {
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--ps-text-muted);
    text-decoration: line-through;
  }
  .ps-price__save {
    display: inline-block;
    font-size: 0.62rem;
    font-weight: 800;
    color: #e74c3c;
    background: rgba(231,76,60,0.1);
    padding: 2px 8px;
    border-radius: 100px;
    letter-spacing: 0.02em;
  }
  .ps-price__unit {
    font-size: 0.72rem;
    color: var(--ps-text-muted);
    width: 100%;
  }

  /* ============================================================
     11. CTA ARROW (desktop)
     ============================================================ */
  .ps-cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 8px;
    font-size: 0.77rem;
    font-weight: 700;
    color: var(--ps-accent);
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.35s, transform 0.35s;
  }
  .ps-cta svg { transition: transform 0.35s cubic-bezier(0.22,1,0.36,1); }
  .ps-card:hover .ps-cta { opacity: 1; transform: translateY(0); }
  .ps-card:hover .ps-cta svg { transform: translateX(4px); }

  /* ============================================================
     12. EMPTY STATE
     ============================================================ */
  .ps-card--empty {
    border: 2px dashed var(--ps-text-muted);
    box-shadow: none;
    opacity: 0.45;
  }
  .ps-card--empty:hover { transform: none !important; box-shadow: none !important; }
  .ps-card--empty.ps-visible { opacity: 0.45; }

  /* ============================================================
     13. VIEW ALL
     ============================================================ */
  .ps-view-all {
    text-align: center;
    margin-top: 44px;
  }
  .ps-view-all__btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 15px 38px;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ps-accent);
    border: 2px solid var(--ps-accent);
    border-radius: 100px;
    transition: background 0.35s, color 0.35s, transform 0.35s;
  }
  .ps-view-all__btn:hover {
    background: var(--ps-accent);
    color: var(--ps-card-bg);
    transform: translateY(-2px);
  }
  .ps-view-all__btn svg { transition: transform 0.35s; }
  .ps-view-all__btn:hover svg { transform: translateX(4px); }

  /* ============================================================
     14. MOBILE SLIDER DOTS
     ============================================================ */
  .ps-dots {
    display: none;
    justify-content: center;
    gap: 8px;
    margin-top: 20px;
    padding: 0;
    list-style: none;
  }
  .ps-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--ps-text-muted);
    border: none;
    padding: 0;
    cursor: pointer;
    transition: background 0.3s, transform 0.3s;
  }
  .ps-dot--active {
    background: var(--ps-accent);
    transform: scale(1.3);
  }

  /* ============================================================
     15. TABLET — 3 columns, then 2
     ============================================================ */
  @media (max-width: 1100px) {
    .ps-inner { padding: 0 28px; }
    .ps-grid { grid-template-columns: repeat(3, 1fr); }
  }

  @media (max-width: 880px) {
    .ps-grid { grid-template-columns: repeat(2, 1fr); }
  }

  /* ============================================================
     16. MOBILE — slider (default) or stacked
     ============================================================ */
  @media (max-width: 749px) {
    .ps-showcase {
      padding-top: {{ section.settings.padding_top | divided_by: 2 }}px;
      padding-bottom: {{ section.settings.padding_bottom | divided_by: 2 }}px;
    }
    .ps-inner { padding: 0 16px; }
    .ps-header { margin-bottom: 32px; }
    .ps-heading { margin-bottom: 8px; }
    .ps-description { font-size: 0.9rem; }

    /* ---- Slider mode ---- */
    .ps-grid--mobile-slider {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scroll-padding-left: 16px;
      gap: 14px;
      padding-bottom: 4px;
      /* Hide scrollbar */
      scrollbar-width: none;
      -ms-overflow-style: none;
    }
    .ps-grid--mobile-slider::-webkit-scrollbar { display: none; }

    .ps-grid--mobile-slider .ps-card {
      flex: 0 0 72vw;
      max-width: 300px;
      scroll-snap-align: start;
    }

    .ps-grid--mobile-slider + .ps-dots { display: flex; }

    /* ---- Stacked mode ---- */
    .ps-grid--mobile-stacked {
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }

    /* ---- Card mobile tweaks ---- */
    .ps-card__img-wrap { aspect-ratio: 3 / 4; }

    .ps-card__body {
      padding: 12px 12px 16px;
      gap: 3px;
    }
    .ps-card__vendor { font-size: 0.6rem; letter-spacing: 0.1em; }
    .ps-card__title {
      font-size: 0.82rem;
      -webkit-line-clamp: 2;
    }
    .ps-card__desc { display: none; }

    /* Stars — smaller on mobile */
    .ps-star { width: 11px; height: 11px; }
    .ps-stars__row { gap: 1px; }
    .ps-review-count { font-size: 0.62rem; }
    .ps-rating { gap: 4px; }

    /* Price — tighter */
    .ps-price { gap: 5px; margin-top: 2px; }
    .ps-price__now { font-size: 0.88rem; }
    .ps-price__was { font-size: 0.7rem; }
    .ps-price__save { font-size: 0.56rem; padding: 2px 6px; }
    .ps-price__unit { font-size: 0.62rem; }

    /* Badge — smaller, stays inside image */
    .ps-badge {
      top: 8px;
      left: 8px;
      padding: 3px 8px;
      font-size: 0.54rem;
      max-width: calc(100% - 16px);
    }

    .ps-card__soldout-pill {
      padding: 6px 14px;
      font-size: 0.6rem;
    }

    /* Hide desktop-only elements */
    .ps-card__overlay { display: none; }
    .ps-cta { display: none; }

    /* View all — smaller */
    .ps-view-all { margin-top: 28px; }
    .ps-view-all__btn {
      padding: 12px 28px;
      font-size: 0.72rem;
    }
  }

  /* Very small screens — single column stacked */
  @media (max-width: 374px) {
    .ps-grid--mobile-slider .ps-card {
      flex: 0 0 82vw;
    }
    .ps-grid--mobile-stacked {
      grid-template-columns: 1fr;
    }
  }

  /* ============================================================
     17. REDUCED MOTION
     ============================================================ */
  @media (prefers-reduced-motion: reduce) {
    .ps-card {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
    .ps-card:hover .ps-card__img { transform: none; }
  }
</style>

{%- comment -%} ========== HTML ========== {%- endcomment -%}
<section class="ps-showcase" id="PS-{{ section_id }}">
  <div class="ps-inner">

    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="ps-header">
        {%- if section.settings.subheading != blank -%}
          <span class="ps-subheading">{{ section.settings.subheading }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="ps-heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.description != blank -%}
          <p class="ps-description">{{ section.settings.description }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div
      class="ps-grid ps-grid--mobile-{{ mobile_layout }}"
      id="PSGrid-{{ section_id }}"
      {% if mobile_layout == 'slider' %}role="region" aria-label="Produkter — swipe for at se flere"{% endif %}
    >
      {%- for block in section.blocks -%}
        {%- assign product = block.settings.product -%}

        {%- if product != blank -%}
          {%- assign sold_out = false -%}
          {%- unless product.available -%}{%- assign sold_out = true -%}{%- endunless -%}

          {%- assign on_sale = false -%}
          {%- if product.compare_at_price > product.price -%}{%- assign on_sale = true -%}{%- endif -%}

          {%- assign badge_cls = 'ps-badge--dark' -%}
          {%- case block.settings.badge_style -%}
            {%- when 'accent' -%}{%- assign badge_cls = 'ps-badge--accent' -%}
            {%- when 'sale' -%}{%- assign badge_cls = 'ps-badge--sale' -%}
            {%- when 'new' -%}{%- assign badge_cls = 'ps-badge--new' -%}
          {%- endcase -%}

          <a
            href="{{ product.url }}"
            class="ps-card ps-card--{{ card_style }}"
            {{ block.shopify_attributes }}
            data-ps-card
          >
            {%- comment -%} — Image area (badge + image + overlays all inside) — {%- endcomment -%}
            <div class="ps-card__img-wrap">

              {%- if block.settings.badge_text != blank -%}
                <span class="ps-badge {{ badge_cls }}">{{ block.settings.badge_text }}</span>
              {%- elsif on_sale and section.settings.auto_sale_badge -%}
                {%- assign pct = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round -%}
                <span class="ps-badge ps-badge--sale">-{{ pct }}%</span>
              {%- endif -%}

              {%- if product.featured_image != blank -%}
                <img
                  src="{{ product.featured_image | image_url: width: 900 }}"
                  srcset="
                    {{ product.featured_image | image_url: width: 400 }} 400w,
                    {{ product.featured_image | image_url: width: 600 }} 600w,
                    {{ product.featured_image | image_url: width: 900 }} 900w,
                    {{ product.featured_image | image_url: width: 1200 }} 1200w
                  "
                  sizes="(max-width: 374px) 82vw, (max-width: 749px) 72vw, (max-width: 880px) 50vw, (max-width: 1100px) 33vw, 25vw"
                  alt="{{ product.featured_image.alt | default: product.title | escape }}"
                  loading="lazy"
                  width="{{ product.featured_image.width }}"
                  height="{{ product.featured_image.height }}"
                  class="ps-card__img ps-card__img--primary"
                >
                {%- if product.images.size > 1 -%}
                  <img
                    src="{{ product.images[1] | image_url: width: 900 }}"
                    alt="{{ product.images[1].alt | default: product.title | escape }}"
                    loading="lazy"
                    class="ps-card__img ps-card__img--hover"
                  >
                {%- endif -%}
              {%- else -%}
                <div class="ps-card__placeholder">
                  {{ 'product-1' | placeholder_svg_tag: 'ps-placeholder-svg' }}
                </div>
              {%- endif -%}

              {%- if sold_out -%}
                <div class="ps-card__soldout">
                  <span class="ps-card__soldout-pill">Udsolgt</span>
                </div>
              {%- endif -%}

              {%- unless sold_out -%}
                <div class="ps-card__overlay">
                  <span class="ps-card__quick-btn">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                    {{ cta_text | default: 'Se produkt' }}
                  </span>
                </div>
              {%- endunless -%}
            </div>

            {%- comment -%} — Card body — {%- endcomment -%}
            <div class="ps-card__body">
              {%- if block.settings.show_vendor and product.vendor != blank -%}
                <span class="ps-card__vendor">{{ product.vendor }}</span>
              {%- endif -%}

              <h3 class="ps-card__title">{{ product.title }}</h3>

              {%- if block.settings.show_description and product.description != blank -%}
                <p class="ps-card__desc">{{ product.description | strip_html | truncate: 85 }}</p>
              {%- endif -%}

              {%- if block.settings.show_stars -%}
                <div class="ps-rating">
                  <div class="ps-stars" style="--ps-rating: {{ block.settings.star_rating }};" aria-label="{{ block.settings.star_rating }} ud af 5 stjerner">
                    <div class="ps-stars__row ps-stars__empty">
                      {%- for i in (1..5) -%}
                        <svg class="ps-star" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                      {%- endfor -%}
                    </div>
                    <div class="ps-stars__row ps-stars__filled">
                      {%- for i in (1..5) -%}
                        <svg class="ps-star" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="1.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                      {%- endfor -%}
                    </div>
                  </div>
                  {%- if block.settings.review_count > 0 -%}
                    <span class="ps-review-count">({{ block.settings.review_count }})</span>
                  {%- endif -%}
                </div>
              {%- endif -%}

              <div class="ps-price">
                {%- if on_sale -%}
                  <span class="ps-price__now ps-price__now--sale">{{ product.price | money }}</span>
                  <span class="ps-price__was">{{ product.compare_at_price | money }}</span>
                  {%- assign pct = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round -%}
                  <span class="ps-price__save">-{{ pct }}%</span>
                {%- else -%}
                  <span class="ps-price__now">{{ product.price | money }}</span>
                {%- endif -%}
                {%- if product.selected_or_first_available_variant.unit_price -%}
                  <span class="ps-price__unit">
                    {{ product.selected_or_first_available_variant.unit_price | money }} /
                    {{ product.selected_or_first_available_variant.unit_price_measurement.reference_value }}{{ product.selected_or_first_available_variant.unit_price_measurement.reference_unit }}
                  </span>
                {%- endif -%}
              </div>

              <span class="ps-cta">
                {{ cta_text | default: 'Se produkt' }}
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              </span>
            </div>
          </a>

        {%- else -%}
          <div class="ps-card ps-card--empty ps-card--{{ card_style }}" {{ block.shopify_attributes }} data-ps-card>
            <div class="ps-card__img-wrap">
              <div class="ps-card__placeholder">
                {{ 'product-1' | placeholder_svg_tag: 'ps-placeholder-svg' }}
              </div>
            </div>
            <div class="ps-card__body">
              <span class="ps-card__vendor">Brand</span>
              <h3 class="ps-card__title">Vaelg et produkt</h3>
              <div class="ps-price"><span class="ps-price__now">0,00 kr.</span></div>
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- comment -%} Slider dots (mobile only, rendered via JS) {%- endcomment -%}
    {%- if mobile_layout == 'slider' -%}
      <ul class="ps-dots" id="PSDots-{{ section_id }}" aria-label="Slider navigation"></ul>
    {%- endif -%}

    {%- if section.settings.show_view_all and section.settings.view_all_collection != blank -%}
      <div class="ps-view-all">
        <a href="{{ section.settings.view_all_collection.url }}" class="ps-view-all__btn">
          {{ section.settings.view_all_text | default: 'Se alle produkter' }}
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
      </div>
    {%- endif -%}

  </div>
</section>

{%- comment -%} ========== JAVASCRIPT ========== {%- endcomment -%}
<script>
(function() {
  var sid   = '{{ section_id }}';
  var root  = document.getElementById('PS-' + sid);
  var grid  = document.getElementById('PSGrid-' + sid);
  var cards = root.querySelectorAll('[data-ps-card]');
  if (!cards.length) return;

  /* ---- 1. Scroll reveal (IntersectionObserver) ---- */
  var reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (reducedMotion) {
    cards.forEach(function(c) { c.classList.add('ps-visible'); });
  } else {
    var revealObserver = new IntersectionObserver(function(entries) {
      entries.forEach(function(e) {
        if (!e.isIntersecting) return;
        var card = e.target;
        var i = parseInt(card.getAttribute('data-ps-i'), 10) || 0;
        setTimeout(function() {
          card.style.transition = 'opacity 0.65s cubic-bezier(0.22,1,0.36,1), transform 0.65s cubic-bezier(0.22,1,0.36,1)';
          card.classList.add('ps-visible');
        }, i * 90);
        revealObserver.unobserve(card);
      });
    }, { threshold: 0.06, rootMargin: '0px 0px -30px 0px' });

    cards.forEach(function(c, i) {
      c.setAttribute('data-ps-i', i);
      revealObserver.observe(c);
    });
  }

  /* ---- 2. Mobile slider dots ---- */
  var dotsWrap = document.getElementById('PSDots-' + sid);
  if (!dotsWrap || !grid.classList.contains('ps-grid--mobile-slider')) return;

  function isMobile() { return window.innerWidth <= 749; }

  function buildDots() {
    dotsWrap.innerHTML = '';
    if (!isMobile()) return;
    cards.forEach(function(_, i) {
      var li = document.createElement('li');
      var btn = document.createElement('button');
      btn.className = 'ps-dot' + (i === 0 ? ' ps-dot--active' : '');
      btn.setAttribute('aria-label', 'Gaa til produkt ' + (i + 1));
      btn.addEventListener('click', function() {
        cards[i].scrollIntoView({ behavior: 'smooth', inline: 'start', block: 'nearest' });
      });
      li.appendChild(btn);
      dotsWrap.appendChild(li);
    });
  }

  function updateDots() {
    if (!isMobile()) return;
    var dots = dotsWrap.querySelectorAll('.ps-dot');
    if (!dots.length) return;

    var scrollLeft = grid.scrollLeft;
    var closest = 0;
    var closestDist = Infinity;

    cards.forEach(function(card, i) {
      var dist = Math.abs(card.offsetLeft - scrollLeft - 16);
      if (dist < closestDist) {
        closestDist = dist;
        closest = i;
      }
    });

    dots.forEach(function(d, i) {
      d.classList.toggle('ps-dot--active', i === closest);
    });
  }

  buildDots();
  var scrollTimer;
  grid.addEventListener('scroll', function() {
    clearTimeout(scrollTimer);
    scrollTimer = setTimeout(updateDots, 60);
  }, { passive: true });

  window.addEventListener('resize', function() {
    buildDots();
  });
})();
</script>

