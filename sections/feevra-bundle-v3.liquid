{% comment %}
  FEEVRA PREMIUM BUNDLE - V3.2 HYBRID

  Best of both: large color cards (visual) + #1/#2/#3 rows (multi-pack)
  - Large color image cards at top (sets all masks to that color)
  - Horizontal quantity cards
  - For 2-3 stk: #1/#2/#3 swatch rows appear automatically
  - For 1 stk: top color cards are enough, no extra rows
  - No toggle link needed
  - CTA without price
  - Pre-selected: 2 stk + Sort
{% endcomment %}

<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');

.feevra-bundle-v3 {
  all: initial;
  display: block;

  --fb-primary: #1C1A54;
  --fb-accent: #00C896;
  --fb-gray-50: #F9FAFB;
  --fb-gray-200: #E5E7EB;
  --fb-gray-300: #D1D5DB;
  --fb-gray-500: #9CA3AF;
  --fb-gray-600: #6B7280;
  --fb-gray-700: #374151;
  --fb-gray-800: #1F2937;
  --fb-red: #EF4444;
  --fb-green: #10B981;
  --fb-check-size: 16px;

  font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  max-width: 680px;
  margin: 0 auto;
  padding: 0;
  box-sizing: border-box;
}

@media (max-width: 480px) {
  .feevra-bundle-v3 { --fb-check-size: 14px; }
}

.feevra-bundle-v3 *,
.feevra-bundle-v3 *::before,
.feevra-bundle-v3 *::after { box-sizing: border-box; }

.feevra-bundle-v3 .bundle-inner {
  border-radius: 10px;
  padding: clamp(8px, 2vw, 12px);
  background: #fff;
}

/* ── Shared card styles (border + checkmark) ── */
.feevra-bundle-v3 .color-card,
.feevra-bundle-v3 .qty-card {
  position: relative;
  border: 0;
  -webkit-tap-highlight-color: transparent;
  touch-action: manipulation;
  overflow: visible !important;
}

.feevra-bundle-v3 .color-card::before,
.feevra-bundle-v3 .qty-card::before {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: inherit;
  pointer-events: none;
  border: 2px solid var(--fb-gray-300);
  transition: border-color 0.16s ease, border-width 0.16s ease;
  z-index: 3;
}

.feevra-bundle-v3 .color-card > *,
.feevra-bundle-v3 .qty-card > * {
  position: relative;
  z-index: 1;
}

.feevra-bundle-v3 .color-card.selected::before,
.feevra-bundle-v3 .qty-card.selected::before {
  border-color: var(--fb-primary);
  border-width: 3px;
}

@media (hover: hover) and (pointer: fine) {
  .feevra-bundle-v3 .color-card:hover::before,
  .feevra-bundle-v3 .qty-card:hover::before {
    border-color: var(--fb-primary);
    border-width: 2px;
  }
}

.feevra-bundle-v3 .color-card.selected::after,
.feevra-bundle-v3 .qty-card.selected::after {
  content: "";
  position: absolute;
  width: var(--fb-check-size);
  height: var(--fb-check-size);
  top: -6px;
  right: -6px;
  background-image: url("https://cdn.shopify.com/s/files/1/0871/4570/9910/files/Ikoner_5.svg?v=1769718275");
  background-repeat: no-repeat;
  background-position: center;
  background-size: 100% 100%;
  background-color: transparent;
  z-index: 10;
  pointer-events: none;
  filter: drop-shadow(0 2px 8px rgba(0,0,0,0.18));
}

@media (max-width: 480px) {
  .feevra-bundle-v3 .color-card.selected::after,
  .feevra-bundle-v3 .qty-card.selected::after {
    top: -5px;
    right: -5px;
  }
}

/* ── Color cards (large, top section) ── */
.feevra-bundle-v3 .color-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: clamp(4px, 1.2vw, 6px);
  margin-bottom: 10px;
}

.feevra-bundle-v3 .color-card {
  cursor: pointer;
  border-radius: 10px;
  background: #fff;
  padding: 0;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
}

@media (hover: hover) and (pointer: fine) {
  .feevra-bundle-v3 .color-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(28, 26, 84, 0.12);
  }
}

.feevra-bundle-v3 .color-card.selected {
  box-shadow: 0 4px 12px rgba(28, 26, 84, 0.15);
}

.feevra-bundle-v3 .color-card.sold-out {
  opacity: 0.7;
  cursor: not-allowed;
}

.feevra-bundle-v3 .color-card.sold-out:hover { transform: none; }

.feevra-bundle-v3 .color-image {
  position: relative;
  width: 100%;
  padding-bottom: 100%;
  border-radius: 10px 10px 0 0;
  overflow: hidden;
}

.feevra-bundle-v3 .color-image img {
  position: absolute;
  top: 0; left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.feevra-bundle-v3 .color-name {
  padding: 6px 4px;
  text-align: center;
  font-size: clamp(10px, 2.2vw, 12px);
  font-weight: 600;
  color: var(--fb-gray-800);
  margin: 0;
}

.feevra-bundle-v3 .color-status {
  position: absolute;
  bottom: 0; left: 0; right: 0;
  color: var(--fb-red);
  font-size: clamp(9px, 2vw, 10px);
  font-weight: 700;
  padding: 4px 6px;
  text-align: center;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  text-shadow: 0 1px 2px rgba(0, 0, 0, 0.35);
}

/* ── Quantity grid ── */
.feevra-bundle-v3 .qty-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: clamp(5px, 1.2vw, 8px);
}

@media (max-width: 480px) {
  .feevra-bundle-v3 .qty-grid { gap: 4px; }
}

.feevra-bundle-v3 .qty-card {
  cursor: pointer;
  border-radius: 10px;
  background: #fff;
  padding: 0;
  display: flex;
  flex-direction: column;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

@media (hover: hover) and (pointer: fine) {
  .feevra-bundle-v3 .qty-card:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 8px rgba(28, 26, 84, 0.08);
  }
}

.feevra-bundle-v3 .qty-card.selected {
  box-shadow: 0 4px 12px rgba(28, 26, 84, 0.15);
}

.feevra-bundle-v3 .qty-badge {
  width: 100%;
  margin: 0;
  background: var(--fb-primary);
  color: #fff;
  padding: 0 8px;
  min-height: 28px;
  line-height: 1.1;
  font-size: clamp(10px, 2.6vw, 13px);
  font-weight: 700;
  letter-spacing: 0.02em;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 10px 10px 0 0;
}

.feevra-bundle-v3 .qty-badge.best { background: var(--fb-accent); }

@media (max-width: 480px) {
  .feevra-bundle-v3 .qty-badge {
    padding: 0 6px;
    min-height: 26px;
    font-size: 10px;
  }
}

.feevra-bundle-v3 .qty-content {
  padding: clamp(8px, 2vw, 12px) clamp(4px, 1.2vw, 6px);
  display: flex;
  flex-direction: column;
  gap: 4px;
  align-items: center;
  justify-content: center;
  width: 100%;
}

.feevra-bundle-v3 .qty-card { min-height: 105px; }

@media (max-width: 480px) {
  .feevra-bundle-v3 .qty-content { padding: 8px 3px; }
  .feevra-bundle-v3 .qty-card { min-height: 98px; }
}

.feevra-bundle-v3 .qty-amount {
  font-size: clamp(16px, 3.8vw, 20px);
  font-weight: 700;
  color: var(--fb-primary);
  line-height: 1;
  text-align: center;
}

.feevra-bundle-v3 .qty-price {
  font-size: clamp(16px, 3.8vw, 19px);
  font-weight: 700;
  color: var(--fb-gray-800);
  line-height: 1;
  white-space: nowrap;
  margin-top: 2px;
}

.feevra-bundle-v3 .qty-savings {
  font-size: clamp(8px, 1.8vw, 9px);
  font-weight: 700;
  color: var(--fb-green);
  background: rgba(16, 185, 129, 0.1);
  padding: 3px 8px;
  border-radius: 8px;
  margin-top: 2px;
  display: flex;
  align-items: center;
  justify-content: center;
  white-space: nowrap;
}

/* ── #1/#2/#3 distribution rows ── */
.feevra-bundle-v3 .distribution-area {
  margin-top: 12px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.feevra-bundle-v3 .dist-row {
  display: flex;
  align-items: flex-start;
  gap: 10px;
}

.feevra-bundle-v3 .dist-row-label {
  font-size: clamp(12px, 2.6vw, 14px);
  font-weight: 700;
  color: var(--fb-primary);
  min-width: 24px;
  height: 32px;
  line-height: 32px;
}

.feevra-bundle-v3 .dist-row-swatches {
  display: flex;
  gap: 8px;
  align-items: flex-start;
}

.feevra-bundle-v3 .dist-swatch-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2px;
}

.feevra-bundle-v3 .dist-swatch {
  position: relative;
  width: 32px;
  height: 32px;
  border-radius: 50%;
  border: 2px solid var(--fb-gray-200);
  cursor: pointer;
  transition: border-color 0.16s ease, transform 0.16s ease, box-shadow 0.16s ease;
  padding: 0;
  background: none;
  -webkit-tap-highlight-color: transparent;
  touch-action: manipulation;
  overflow: hidden;
}

.feevra-bundle-v3 .dist-swatch img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  border-radius: 50%;
  display: block;
}

.feevra-bundle-v3 .dist-swatch.selected {
  border-color: var(--fb-primary);
  border-width: 3px;
  box-shadow: 0 0 0 2px rgba(28, 26, 84, 0.15);
}

.feevra-bundle-v3 .dist-swatch.sold-out {
  opacity: 0.4;
  cursor: not-allowed;
}

@media (hover: hover) and (pointer: fine) {
  .feevra-bundle-v3 .dist-swatch:not(.sold-out):hover {
    border-color: var(--fb-primary);
    transform: scale(1.1);
  }
}

.feevra-bundle-v3 .dist-swatch-name {
  font-size: clamp(9px, 2vw, 10px);
  font-weight: 500;
  color: var(--fb-gray-600);
  text-align: center;
}

/* ── CTA ── */
.feevra-bundle-v3 .cta-button {
  width: 100%;
  padding: clamp(14px, 3vw, 16px) 20px;
  background: var(--fb-primary);
  color: #fff;
  border: none;
  border-radius: 10px;
  font-size: clamp(15px, 3.4vw, 17px);
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  cursor: pointer;
  transition: all 0.2s ease;
  font-family: 'Inter', sans-serif;
  margin-top: 14px;
  box-shadow: 0 4px 12px rgba(28, 26, 84, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
}

.feevra-bundle-v3 .cta-button .spinner {
  width: 16px;
  height: 16px;
  border: 2px solid rgba(255,255,255,0.3);
  border-top-color: #fff;
  border-radius: 50%;
  animation: fb-spin 0.6s linear infinite;
  display: none;
}

.feevra-bundle-v3 .cta-button.loading .spinner { display: block; }

.feevra-bundle-v3 .cta-button:disabled {
  background: var(--fb-gray-300);
  cursor: not-allowed;
  box-shadow: none;
}

@keyframes fb-spin { to { transform: rotate(360deg); } }

.feevra-bundle-v3 .preorder-note {
  margin-top: 10px;
  text-align: center;
  font-size: 14px;
  font-weight: 600;
  color: var(--fb-gray-700);
  line-height: 1.25;
}

/* ── Trust badges ── */
.feevra-bundle-v3 .trust-badges {
  display: grid;
  grid-template-columns: repeat(3, max-content);
  justify-content: center;
  align-items: center;
  gap: clamp(12px, 3vw, 18px);
  margin-top: 8px;
}

.feevra-bundle-v3 .trust-item {
  display: flex;
  align-items: center;
  gap: 5px;
  font-size: clamp(10px, 2.4vw, 12px);
  color: var(--fb-gray-600);
  font-weight: 500;
}

.feevra-bundle-v3 .trust-icon {
  width: 14px;
  height: 14px;
  color: var(--fb-accent);
  overflow: visible;
}

.feevra-bundle-v3 .trustpilot-inline {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: clamp(10px, 2.4vw, 12px);
  color: var(--fb-gray-600);
  font-weight: 500;
  white-space: nowrap;
}

.feevra-bundle-v3 .trustpilot-inline img {
  height: clamp(12px, 3vw, 16px);
  flex-shrink: 0;
}

.feevra-bundle-v3 .payment-section {
  display: flex;
  justify-content: center;
  margin-top: 8px;
  width: 100%;
}

.feevra-bundle-v3 .payment-icon-list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 6px;
  flex-wrap: nowrap;
}

.feevra-bundle-v3 .payment-icon { flex: 0 0 auto; display: flex; align-items: center; }
.feevra-bundle-v3 .payment-icon svg { height: clamp(12px, 3.2vw, 18px); width: auto; display: block; }

.feevra-bundle-v3 .toast {
  position: fixed;
  bottom: 24px;
  right: 24px;
  background: var(--fb-gray-800);
  color: #fff;
  padding: 12px 20px;
  border-radius: 8px;
  font-size: 14px;
  font-weight: 500;
  z-index: 9999;
  opacity: 0;
  transform: translateY(20px);
  transition: all 0.3s ease;
  pointer-events: none;
}

.feevra-bundle-v3 .toast.show { opacity: 1; transform: translateY(0); pointer-events: auto; }
.feevra-bundle-v3 .toast.error { background: var(--fb-red); }
.feevra-bundle-v3 .toast.success { background: var(--fb-green); }
</style>

<div class="feevra-bundle-v3" id="feevra-bundle-v3">
  <div class="bundle-inner">

    <!-- Large color cards -->
    <div class="color-grid" id="color-grid" role="radiogroup" aria-label="Farve">
      <button type="button" class="color-card" data-color="sort" data-variant="49885169189206" data-available="true" aria-pressed="false">
        <div class="color-image">
          <img src="https://cdn.shopify.com/s/files/1/0871/4570/9910/files/feevra-migraenemasken.jpg_2_e103e0c1-662b-4aca-a605-009f32c6e49e.jpg?v=1768917230" alt="Sort">
        </div>
        <div class="color-name">Sort</div>
      </button>

      <button type="button" class="color-card" data-color="rosa" data-variant="50188499812694" data-available="true" aria-pressed="false">
        <div class="color-image">
          <img src="https://cdn.shopify.com/s/files/1/0871/4570/9910/files/feevra-migraenemaske_jpg_3ec23e6e-1dce-4474-a8e8-30ad75e4a914.jpg?v=1768917229" alt="Rosa">
        </div>
        <div class="color-name">Rosa</div>
      </button>

      <button type="button" class="color-card" data-color="graa" data-variant="50595389866326" data-available="true" aria-pressed="false">
        <div class="color-image">
          <img src="https://cdn.shopify.com/s/files/1/0871/4570/9910/files/feevra-migraenemasken_jpg_049bb0ba-66eb-478f-87ba-5f4e1c3af56c.jpg?v=1768917230" alt="Grå">
        </div>
        <div class="color-name">Grå</div>
      </button>

      <button type="button" class="color-card" data-color="blaa" data-variant="51508439810390" data-available="true" aria-pressed="false">
        <div class="color-image">
          <img src="https://cdn.shopify.com/s/files/1/0871/4570/9910/files/feevra-migraenemasken.jpg_3_021793b9-d91c-4e66-8277-77242e0f482e.jpg?v=1768917230" alt="Blå">
        </div>
        <div class="color-name">Blå</div>
      </button>
    </div>

    <!-- Quantity cards -->
    <div class="qty-grid" role="radiogroup" aria-label="Antal">
      <button type="button" class="qty-card" data-quantity="1" aria-pressed="false">
        <div class="qty-badge" style="visibility: hidden;">.</div>
        <div class="qty-content">
          <div class="qty-amount">1 Stk</div>
          <div class="qty-price">399 kr.</div>
          <div class="qty-savings">Spar 33%</div>
        </div>
      </button>

      <button type="button" class="qty-card" data-quantity="2" aria-pressed="false">
        <div class="qty-badge">Mest populær</div>
        <div class="qty-content">
          <div class="qty-amount">2 Stk</div>
          <div class="qty-price">750 kr.</div>
          <div class="qty-savings">Spar 37%</div>
        </div>
      </button>

      <button type="button" class="qty-card" data-quantity="3" aria-pressed="false">
        <div class="qty-badge best">Bedst værdi</div>
        <div class="qty-content">
          <div class="qty-amount">3 Stk</div>
          <div class="qty-price">950 kr.</div>
          <div class="qty-savings">Spar 47%</div>
        </div>
      </button>
    </div>

    <!-- #1/#2/#3 distribution rows (rendered by JS for 2-3 stk) -->
    <div class="distribution-area" id="distribution-area"></div>

    <!-- CTA -->
    <div id="section-cta">
      <button type="button" class="cta-button" id="add-to-cart-btn" disabled>
        <span class="cta-text">Tilføj til kurv</span>
        <span class="spinner"></span>
      </button>

      <div class="preorder-note">Forudbestilling: På lager igen 20 Februar</div>

      <div class="trust-badges">
        <div class="trust-item">
          <svg class="trust-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
          </svg>
          <span>Gratis levering</span>
        </div>
        <div class="trust-item">
          <svg class="trust-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <span>100 dages returret</span>
        </div>
        <div class="trustpilot-inline">
          <span>Fremragende</span>
          <img src="https://cdn.shopify.com/s/files/1/0871/4570/9910/files/Trustpilot_stars.png?v=1750971162" alt="Trustpilot stjerner">
        </div>
      </div>

      <div class="payment-section">
        <div aria-label="Betalingsmuligheder">
          <ul class="payment-icon-list" role="list">
            {%- assign payment_icons = "visa,master,apple_pay,google_pay,mobilepay,klarna" | split: "," -%}
            {%- for type in payment_icons -%}
              <li class="payment-icon">{{ type | payment_type_svg_tag }}</li>
            {%- endfor -%}
          </ul>
        </div>
      </div>
    </div>

  </div>
  <div class="toast" id="fb-toast" role="status" aria-live="polite" aria-atomic="true"></div>
</div>

<script>
(function() {
  'use strict';

  var CONFIG = {
    productHandle: 'feevra-migraene-maske',
    cacheKey: 'feevra_bundle_product_cache_v3',
    cacheTtlMs: 300000,
    uiLockMs: 140,
    defaultColor: 'sort',
    defaultQuantity: 2,
    products: {
      sort: { name: 'Sort', variantId: '49885169189206', image: 'https://cdn.shopify.com/s/files/1/0871/4570/9910/files/feevra-migraenemasken.jpg_2_e103e0c1-662b-4aca-a605-009f32c6e49e.jpg?v=1768917230' },
      rosa: { name: 'Rosa', variantId: '50188499812694', image: 'https://cdn.shopify.com/s/files/1/0871/4570/9910/files/feevra-migraenemaske_jpg_3ec23e6e-1dce-4474-a8e8-30ad75e4a914.jpg?v=1768917229' },
      graa: { name: 'Grå', variantId: '50595389866326', image: 'https://cdn.shopify.com/s/files/1/0871/4570/9910/files/feevra-migraenemasken_jpg_049bb0ba-66eb-478f-87ba-5f4e1c3af56c.jpg?v=1768917230' },
      blaa: { name: 'Blå', variantId: '51508439810390', image: 'https://cdn.shopify.com/s/files/1/0871/4570/9910/files/feevra-migraenemasken.jpg_3_021793b9-d91c-4e66-8277-77242e0f482e.jpg?v=1768917230' }
    }
  };

  var colorKeys = Object.keys(CONFIG.products);

  var state = {
    selectedColor: null,
    selectedQuantity: null,
    distribution: {},
    soldOutVariantIds: new Set(),
    inFlightProductPromise: null,
    lockedUntil: 0,
    isAdding: false,
    renderedDistQty: 0
  };

  var els = {
    colorCards: document.querySelectorAll('.feevra-bundle-v3 .color-card'),
    qtyCards: document.querySelectorAll('.feevra-bundle-v3 .qty-card'),
    distArea: document.getElementById('distribution-area'),
    ctaBtn: document.getElementById('add-to-cart-btn'),
    toast: document.getElementById('fb-toast')
  };

  function now() { return Date.now(); }
  function lockUi(ms) { state.lockedUntil = Math.max(state.lockedUntil, now() + ms); }
  function blocked() { return state.isAdding || (now() < state.lockedUntil); }

  function showToast(msg, type) {
    els.toast.textContent = msg;
    els.toast.className = 'toast ' + (type || 'info') + ' show';
    setTimeout(function() { els.toast.classList.remove('show'); }, 3000);
  }

  function isSoldOut(vid) { return state.soldOutVariantIds.has(String(vid)); }
  function availableKeys() { return colorKeys.filter(function(k) { return !isSoldOut(CONFIG.products[k].variantId); }); }

  /* ── CTA ── */
  function updateCta() {
    var txt = els.ctaBtn.querySelector('.cta-text');
    if (!availableKeys().length) { els.ctaBtn.disabled = true; txt.textContent = 'Udsolgt'; return; }
    if (!state.selectedColor || !state.selectedQuantity) { els.ctaBtn.disabled = true; txt.textContent = 'Tilføj til kurv'; return; }
    if (!state.isAdding) { els.ctaBtn.disabled = false; txt.textContent = 'Tilføj til kurv'; }
  }

  /* ── Color card UI ── */
  function setColorCardUi(colorKey) {
    els.colorCards.forEach(function(c) {
      var sel = c.dataset.color === colorKey;
      c.classList.toggle('selected', sel);
      c.setAttribute('aria-pressed', sel ? 'true' : 'false');
    });
  }

  /* ── Qty card UI ── */
  function setQtyCardUi(qty) {
    els.qtyCards.forEach(function(c) {
      var sel = qty != null && parseInt(c.dataset.quantity, 10) === qty;
      c.classList.toggle('selected', sel);
      c.setAttribute('aria-pressed', sel ? 'true' : 'false');
    });
  }

  /* ── Distribution rows (#1 #2 #3) ── */
  function renderDistribution() {
    var qty = state.selectedQuantity;

    // For 1 stk: no rows needed, top color card is enough
    if (!qty || qty <= 1) {
      els.distArea.innerHTML = '';
      state.renderedDistQty = 0;
      return;
    }

    // Only re-render if qty changed
    if (state.renderedDistQty === qty) {
      refreshDistSoldOut();
      refreshDistSelection();
      return;
    }

    state.renderedDistQty = qty;
    els.distArea.innerHTML = '';

    for (var i = 0; i < qty; i++) {
      (function(idx) {
        var row = document.createElement('div');
        row.className = 'dist-row';
        row.dataset.index = String(idx);

        var label = document.createElement('span');
        label.className = 'dist-row-label';
        label.textContent = '#' + (idx + 1);
        row.appendChild(label);

        var swatches = document.createElement('div');
        swatches.className = 'dist-row-swatches';

        colorKeys.forEach(function(colorKey) {
          var product = CONFIG.products[colorKey];
          var soldOut = isSoldOut(product.variantId);

          var item = document.createElement('div');
          item.className = 'dist-swatch-item';

          var btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'dist-swatch';
          btn.dataset.color = colorKey;
          btn.dataset.index = String(idx);
          btn.dataset.variant = product.variantId;
          btn.title = product.name;
          btn.setAttribute('aria-pressed', 'false');

          if (soldOut) {
            btn.classList.add('sold-out');
            btn.dataset.available = 'false';
          } else {
            btn.dataset.available = 'true';
          }

          btn.innerHTML = '<img src="' + product.image + '" alt="' + product.name + '">';

          btn.addEventListener('pointerup', function() {
            if (blocked()) return;
            lockUi(CONFIG.uiLockMs);
            if (btn.dataset.available !== 'true') { showToast('Denne farve er udsolgt', 'error'); return; }
            state.distribution[idx] = colorKey;
            updateDistRowSelection(idx);

            // Update top color card to reflect #1 selection
            if (idx === 0) {
              state.selectedColor = colorKey;
              setColorCardUi(colorKey);
            }
          });

          var name = document.createElement('span');
          name.className = 'dist-swatch-name';
          name.textContent = product.name;

          item.appendChild(btn);
          item.appendChild(name);
          swatches.appendChild(item);
        });

        row.appendChild(swatches);
        els.distArea.appendChild(row);
      })(i);
    }

    refreshDistSelection();
  }

  function updateDistRowSelection(idx) {
    var row = els.distArea.querySelector('.dist-row[data-index="' + idx + '"]');
    if (!row) return;
    var sel = state.distribution[idx];
    row.querySelectorAll('.dist-swatch').forEach(function(btn) {
      var isSel = btn.dataset.color === sel;
      btn.classList.toggle('selected', isSel);
      btn.setAttribute('aria-pressed', isSel ? 'true' : 'false');
    });
  }

  function refreshDistSelection() {
    var qty = state.selectedQuantity || 0;
    for (var i = 0; i < qty; i++) updateDistRowSelection(i);
  }

  function refreshDistSoldOut() {
    els.distArea.querySelectorAll('.dist-swatch').forEach(function(btn) {
      var sold = isSoldOut(btn.dataset.variant);
      btn.classList.toggle('sold-out', sold);
      btn.dataset.available = sold ? 'false' : 'true';
    });
  }

  /* ── Product fetch ── */
  function getCachedProduct() {
    try {
      var raw = sessionStorage.getItem(CONFIG.cacheKey);
      if (!raw) return null;
      var p = JSON.parse(raw);
      if (!p || !p.t || !p.data || now() - p.t > CONFIG.cacheTtlMs) return null;
      return p.data;
    } catch(e) { return null; }
  }

  function setCachedProduct(data) {
    try { sessionStorage.setItem(CONFIG.cacheKey, JSON.stringify({ t: now(), data: data })); } catch(e) {}
  }

  function fetchProduct(force) {
    if (!force) { var c = getCachedProduct(); if (c) return Promise.resolve(c); }
    if (state.inFlightProductPromise) return state.inFlightProductPromise;
    state.inFlightProductPromise = fetch('/products/' + CONFIG.productHandle + '.js', { credentials: 'same-origin' })
      .then(function(r) { if (!r.ok) throw new Error('fail'); return r.json(); })
      .then(function(d) { setCachedProduct(d); return d; })
      .finally(function() { state.inFlightProductPromise = null; });
    return state.inFlightProductPromise;
  }

  /* ── Stock ── */
  function applyStock(product) {
    state.soldOutVariantIds = new Set();
    if (product && product.variants) {
      product.variants.forEach(function(v) { if (!v.available) state.soldOutVariantIds.add(String(v.id)); });
    }

    // Update top color cards
    var colorGrid = document.getElementById('color-grid');
    var availCards = [], soldCards = [];
    els.colorCards.forEach(function(card) {
      var vid = card.dataset.variant;
      var img = card.querySelector('.color-image');
      var status = img ? img.querySelector('.color-status') : null;

      if (isSoldOut(vid)) {
        card.classList.add('sold-out');
        card.dataset.available = 'false';
        if (img && !status) { var s = document.createElement('div'); s.className = 'color-status'; s.textContent = 'Udsolgt'; img.appendChild(s); }
        soldCards.push(card);
      } else {
        card.classList.remove('sold-out');
        card.dataset.available = 'true';
        if (status) status.remove();
        availCards.push(card);
      }
    });
    if (colorGrid) {
      availCards.forEach(function(c) { colorGrid.appendChild(c); });
      soldCards.forEach(function(c) { colorGrid.appendChild(c); });
    }

    // Fix selected color if sold out
    if (state.selectedColor && isSoldOut(CONFIG.products[state.selectedColor].variantId)) {
      var keys = availableKeys();
      state.selectedColor = keys.length ? keys[0] : null;
      if (state.selectedColor) setColorCardUi(state.selectedColor);
    }

    // Fix distribution
    var qty = state.selectedQuantity || 0;
    for (var i = 0; i < qty; i++) {
      var cur = state.distribution[i];
      if (cur && isSoldOut(CONFIG.products[cur].variantId)) {
        var fb = availableKeys();
        state.distribution[i] = fb.length ? fb[0] : cur;
      }
    }

    refreshDistSoldOut();
    refreshDistSelection();
    updateCta();
  }

  function fetchAndApply(force) {
    return fetchProduct(!!force).then(function(p) { applyStock(p); return p; }).catch(function() { updateCta(); return null; });
  }

  /* ── Handlers ── */
  function handleColorClick(e) {
    if (blocked()) return;
    lockUi(CONFIG.uiLockMs);
    var card = e.currentTarget;
    if (card.dataset.available !== 'true') { showToast('Denne farve er udsolgt', 'error'); return; }

    var color = card.dataset.color;
    state.selectedColor = color;
    setColorCardUi(color);

    // Set ALL distribution slots to this color
    var qty = state.selectedQuantity || 0;
    for (var i = 0; i < qty; i++) state.distribution[i] = color;
    refreshDistSelection();
    updateCta();
  }

  function handleQtyClick(e) {
    if (blocked()) return;
    lockUi(CONFIG.uiLockMs);

    var qty = parseInt(e.currentTarget.dataset.quantity, 10);
    state.selectedQuantity = qty;
    setQtyCardUi(qty);

    // Build distribution, keeping existing selections where possible
    var baseColor = state.selectedColor || CONFIG.defaultColor;
    var newDist = {};
    for (var i = 0; i < qty; i++) {
      newDist[i] = state.distribution[i] || baseColor;
    }
    state.distribution = newDist;

    renderDistribution();
    updateCta();
    fetchAndApply(false);
  }

  async function handleAddToCart() {
    if (blocked()) return;
    if (!state.selectedColor || !state.selectedQuantity) { showToast('Vælg dine masker', 'error'); return; }

    state.isAdding = true;
    lockUi(400);
    var txt = els.ctaBtn.querySelector('.cta-text');
    els.ctaBtn.disabled = true;
    txt.textContent = 'Tilføjer...';
    els.ctaBtn.classList.add('loading');

    try {
      await fetchAndApply(true);
      if (!availableKeys().length) {
        showToast('Produktet er udsolgt', 'error');
        txt.textContent = 'Udsolgt';
        els.ctaBtn.classList.remove('loading');
        state.isAdding = false;
        updateCta();
        return;
      }

      var qty = state.selectedQuantity;
      var counts = {};
      for (var i = 0; i < qty; i++) {
        var k = state.distribution[i] || state.selectedColor;
        counts[k] = (counts[k] || 0) + 1;
      }

      var items = [];
      Object.keys(counts).forEach(function(ck) {
        var cfg = CONFIG.products[ck];
        if (!cfg || isSoldOut(cfg.variantId)) return;
        items.push({ id: cfg.variantId, quantity: counts[ck], properties: { 'Bundle': 'Feevra Bundle', 'Antal i bundle': qty } });
      });

      var res = await fetch('/cart/add.js', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ items: items }) });

      if (res.ok) {
        txt.textContent = 'Tilføjet!';
        window.dispatchEvent(new CustomEvent('feevra:cart:updated'));
        setTimeout(function() { els.ctaBtn.classList.remove('loading'); state.isAdding = false; updateCta(); }, 1200);
        return;
      }
      showToast('Der skete en fejl. Prøv igen.', 'error');
    } catch(err) {
      showToast('Der skete en fejl. Prøv igen.', 'error');
    }
    els.ctaBtn.classList.remove('loading');
    state.isAdding = false;
    updateCta();
  }

  /* ── Init ── */
  function init() {
    state.selectedColor = CONFIG.defaultColor;
    state.selectedQuantity = CONFIG.defaultQuantity;
    for (var i = 0; i < state.selectedQuantity; i++) state.distribution[i] = state.selectedColor;

    setColorCardUi(state.selectedColor);
    setQtyCardUi(state.selectedQuantity);
    renderDistribution();
    updateCta();

    els.colorCards.forEach(function(c) { c.addEventListener('pointerup', handleColorClick); });
    els.qtyCards.forEach(function(c) { c.addEventListener('pointerup', handleQtyClick); });
    els.ctaBtn.addEventListener('click', handleAddToCart);

    fetchAndApply(false);
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
})();
</script>
