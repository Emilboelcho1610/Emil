      {% endif %}
    </div>
  </div>
</div>

{%- comment -%} =================== JAVASCRIPT =================== {%- endcomment -%}
<script>
  (function() {
    const sectionId = '{{ section.id }}';
    const CLOSE_DELAY = 200;
    let closeTimeout = null;
    let activeNavItem = null;

    /* ----- DESKTOP MEGA MENU ----- */
    const navItems = document.querySelectorAll('.nav-item-' + sectionId);

    function openDropdown(item) {
      if (closeTimeout) {
        clearTimeout(closeTimeout);
        closeTimeout = null;
      }
      if (activeNavItem && activeNavItem !== item) {
        activeNavItem.classList.remove('is-active');
        const btn = activeNavItem.querySelector('button');
        if (btn) btn.setAttribute('aria-expanded', 'false');
      }
      item.classList.add('is-active');
      const btn = item.querySelector('button');
      if (btn) btn.setAttribute('aria-expanded', 'true');
      activeNavItem = item;
    }

    function closeDropdown(item) {
      closeTimeout = setTimeout(function() {
        item.classList.remove('is-active');
        const btn = item.querySelector('button');
        if (btn) btn.setAttribute('aria-expanded', 'false');
        if (activeNavItem === item) activeNavItem = null;
      }, CLOSE_DELAY);
    }

    function closeAllDropdowns() {
      navItems.forEach(function(item) {
        item.classList.remove('is-active');
        const btn = item.querySelector('button');
        if (btn) btn.setAttribute('aria-expanded', 'false');
      });
      activeNavItem = null;
    }

    navItems.forEach(function(item) {
      const dropdown = item.querySelector('.mega-dropdown-' + sectionId);
      if (!dropdown) return;

      /* Hover events */
      item.addEventListener('mouseenter', function() {
        openDropdown(item);
      });

      item.addEventListener('mouseleave', function() {
        closeDropdown(item);
      });

      /* Click toggle for accessibility */
      const btn = item.querySelector('button');
      if (btn) {
        btn.addEventListener('click', function(e) {
          e.preventDefault();
          if (item.classList.contains('is-active')) {
            item.classList.remove('is-active');
            btn.setAttribute('aria-expanded', 'false');
            activeNavItem = null;
          } else {
            openDropdown(item);
          }
        });
      }
    });

    /* Close on outside click */
    document.addEventListener('click', function(e) {
      const header = document.querySelector('.site-header-' + sectionId);
      if (header && !header.contains(e.target)) {
        closeAllDropdowns();
      }
    });

    /* Close on Escape key */
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        closeAllDropdowns();
        closeMobileDrawer();
      }
    });

    /* ----- MOBILE DRAWER ----- */
    const drawer = document.querySelector('[data-drawer="' + sectionId + '"]');
    const overlay = document.querySelector('[data-overlay="' + sectionId + '"]');
    const toggleBtn = document.querySelector('[data-drawer-toggle="' + sectionId + '"]');
    const closeBtn = document.querySelector('[data-drawer-close="' + sectionId + '"]');

    function openMobileDrawer() {
      if (!drawer || !overlay) return;
      drawer.classList.add('is-open');
      overlay.classList.add('is-visible');
      document.body.style.overflow = 'hidden';
    }

    function closeMobileDrawer() {
      if (!drawer || !overlay) return;
      drawer.classList.remove('is-open');
      overlay.classList.remove('is-visible');
      document.body.style.overflow = '';

      /* Close all mobile submenus */
      document.querySelectorAll('[data-mobile-submenu]').forEach(function(sub) {
        sub.classList.remove('is-open');
      });
      document.querySelectorAll('[data-mobile-toggle]').forEach(function(btn) {
        btn.setAttribute('aria-expanded', 'false');
      });
    }

    if (toggleBtn) toggleBtn.addEventListener('click', openMobileDrawer);
    if (closeBtn) closeBtn.addEventListener('click', closeMobileDrawer);
    if (overlay) overlay.addEventListener('click', closeMobileDrawer);

    /* Mobile submenu toggles */
    document.querySelectorAll('[data-mobile-toggle]').forEach(function(btn) {
      btn.addEventListener('click', function() {
        const handle = this.getAttribute('data-mobile-toggle');
        const submenu = document.querySelector('[data-mobile-submenu="' + handle + '"]');
        if (!submenu) return;

        const isOpen = submenu.classList.contains('is-open');
        submenu.classList.toggle('is-open');
        this.setAttribute('aria-expanded', isOpen ? 'false' : 'true');
      });
    });

    /* Position fullwidth dropdowns below header */
    function positionFullwidthDropdowns() {
      const header = document.querySelector('.site-header-' + sectionId);
      if (!header) return;
      const rect = header.getBoundingClientRect();
      const dropdowns = document.querySelectorAll('.mega-dropdown-fullwidth-' + sectionId);
      dropdowns.forEach(function(dd) {
        dd.style.top = rect.bottom + 'px';
      });
    }

    positionFullwidthDropdowns();
    window.addEventListener('scroll', positionFullwidthDropdowns);
    window.addEventListener('resize', positionFullwidthDropdowns);
  })();
</script>

