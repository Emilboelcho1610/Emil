{% schema %}
{
  "name": "FAQ (Beauty)",
  "settings": [
    {
      "type": "header",
      "content": "Generelle indstillinger"
    },
    {
      "type": "text",
      "id": "section_title",
      "label": "Overskrift",
      "default": "Ofte stillede spørgsmål"
    },
    {
      "type": "textarea",
      "id": "section_subtitle",
      "label": "Undertekst",
      "default": "Find svar på de mest almindelige spørgsmål om vores produkter og din skønhedsrutine"
    },
    {
      "type": "select",
      "id": "layout_style",
      "label": "Layout stil",
      "options": [
        { "value": "single", "label": "Enkelt kolonne" },
        { "value": "two-column", "label": "To kolonner" }
      ],
      "default": "single"
    },
    {
      "type": "header",
      "content": "Farver"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Baggrundsfarve",
      "default": "#faf8f5"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Kort baggrundsfarve",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Overskrift farve",
      "default": "#2c2c2c"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Tekst farve",
      "default": "#5a5a5a"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent farve",
      "default": "#c9a87c"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border farve",
      "default": "#e8e4df"
    },
    {
      "type": "color",
      "id": "hover_bg_color",
      "label": "Hover baggrundsfarve",
      "default": "#fdfcfa"
    },
    {
      "type": "header",
      "content": "Typografi"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Overskrift størrelse",
      "min": 24,
      "max": 60,
      "step": 2,
      "default": 42,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "question_size",
      "label": "Spørgsmål størrelse",
      "min": 14,
      "max": 22,
      "step": 1,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Afstand"
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "label": "Padding top",
      "min": 20,
      "max": 120,
      "step": 10,
      "default": 80,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "label": "Padding bottom",
      "min": 20,
      "max": 120,
      "step": 10,
      "default": 80,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "CTA sektion"
    },
    {
      "type": "checkbox",
      "id": "show_cta",
      "label": "Vis kontakt CTA",
      "default": true
    },
    {
      "type": "text",
      "id": "cta_title",
      "label": "CTA overskrift",
      "default": "Har du stadig spørgsmål?"
    },
    {
      "type": "textarea",
      "id": "cta_text",
      "label": "CTA tekst",
      "default": "Vores skønhedseksperter er klar til at hjælpe dig med personlige anbefalinger"
    },
    {
      "type": "text",
      "id": "cta_button_text",
      "label": "Knap tekst",
      "default": "Kontakt os"
    },
    {
      "type": "url",
      "id": "cta_button_url",
      "label": "Knap link"
    },
    {
      "type": "color",
      "id": "cta_bg_color",
      "label": "CTA baggrund",
      "default": "#2c2c2c"
    },
    {
      "type": "color",
      "id": "cta_text_color",
      "label": "CTA tekst farve",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "cta_button_bg",
      "label": "CTA knap baggrund",
      "default": "#c9a87c"
    },
    {
      "type": "color",
      "id": "cta_button_text_color",
      "label": "CTA knap tekst",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Kategori",
      "settings": [
        {
          "type": "text",
          "id": "category_title",
          "label": "Kategori navn",
          "default": "Produkter"
        },
        {
          "type": "select",
          "id": "category_icon",
          "label": "Ikon",
          "options": [
            { "value": "skincare", "label": "Hudpleje" },
            { "value": "makeup", "label": "Makeup" },
            { "value": "haircare", "label": "Hårpleje" },
            { "value": "fragrance", "label": "Parfume" },
            { "value": "shipping", "label": "Levering" },
            { "value": "returns", "label": "Returneringer" },
            { "value": "ingredients", "label": "Ingredienser" },
            { "value": "general", "label": "Generelt" }
          ],
          "default": "skincare"
        }
      ]
    },
    {
      "type": "faq",
      "name": "Spørgsmål",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Spørgsmål",
          "default": "Hvordan bruger jeg produktet?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Svar",
          "default": "<p>Påfør en passende mængde på ren hud morgen og aften. Massér forsigtigt ind i huden med opadgående bevægelser.</p>"
        },
        {
          "type": "text",
          "id": "category",
          "label": "Kategori (skal matche kategorinavn)",
          "default": "Produkter"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ (Beauty)",
      "blocks": [
        {
          "type": "category",
          "settings": {
            "category_title": "Hudpleje",
            "category_icon": "skincare"
          }
        },
        {
          "type": "category",
          "settings": {
            "category_title": "Bestilling & Levering",
            "category_icon": "shipping"
          }
        },
        {
          "type": "category",
          "settings": {
            "category_title": "Ingredienser",
            "category_icon": "ingredients"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Hvordan finder jeg de rigtige produkter til min hudtype?",
            "answer": "<p>Vi anbefaler at starte med vores <strong>hudtype-quiz</strong> for at finde de perfekte produkter til netop din hud. Du kan også kontakte vores skønhedseksperter for personlig rådgivning.</p>",
            "category": "Hudpleje"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "I hvilken rækkefølge skal jeg påføre mine produkter?",
            "answer": "<p>Den generelle regel er at gå fra tyndeste til tykkeste konsistens:</p><p>1. Rens<br>2. Toner<br>3. Serum<br>4. Øjencreme<br>5. Fugtighedscreme<br>6. Solcreme (om dagen)</p>",
            "category": "Hudpleje"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Hvor lang tid går der før jeg ser resultater?",
            "answer": "<p>De fleste af vores produkter viser synlige resultater inden for <strong>4-6 uger</strong> ved daglig brug. Husk at konsistens er nøglen til god hudpleje!</p>",
            "category": "Hudpleje"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Hvor hurtigt leverer I?",
            "answer": "<p>Vi tilbyder <strong>gratis levering</strong> på alle ordrer over 499 kr. Standard levering tager 2-4 hverdage, og express levering leveres næste dag ved bestilling før kl. 14.</p>",
            "category": "Bestilling & Levering"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Kan jeg returnere produkter?",
            "answer": "<p>Ja! Vi tilbyder <strong>30 dages returret</strong> på alle uåbnede produkter. Har du åbnet et produkt og er utilfreds, kontakt os venligst - vi finder altid en løsning.</p>",
            "category": "Bestilling & Levering"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Er jeres produkter veganske og cruelty-free?",
            "answer": "<p>Ja, alle vores produkter er <strong>100% veganske</strong> og <strong>cruelty-free</strong>. Vi tester aldrig på dyr, og vores ingredienser er nøje udvalgt for at være så skånsomme som muligt.</p>",
            "category": "Ingredienser"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Indeholder jeres produkter parabener eller sulfater?",
            "answer": "<p>Nej, vi formulerer <strong>uden parabener, sulfater, mineralolier og syntetiske dufte</strong>. Alle ingredienser er omhyggeligt udvalgt for deres effektivitet og sikkerhed.</p>",
            "category": "Ingredienser"
          }
        }
      ]
    }
  ]
}
{% endschema %}

<style>
  .faq-beauty-section {
    background-color: {{ section.settings.bg_color }};
    padding-top: {{ section.settings.section_padding_top }}px;
    padding-bottom: {{ section.settings.section_padding_bottom }}px;
    font-family: 'Montserrat', -apple-system, BlinkMacSystemFont, sans-serif;
  }

  .faq-beauty-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  /* Header */
  .faq-beauty-header {
    text-align: center;
    margin-bottom: 60px;
  }

  .faq-beauty-title {
    font-size: {{ section.settings.title_size }}px;
    font-weight: 300;
    color: {{ section.settings.title_color }};
    margin: 0 0 20px 0;
    letter-spacing: -0.5px;
    line-height: 1.2;
  }

  .faq-beauty-subtitle {
    font-size: 16px;
    color: {{ section.settings.text_color }};
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.7;
    font-weight: 400;
  }

  /* Category Filter */
  .faq-category-filter {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 50px;
  }

  .faq-category-btn {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 24px;
    background: {{ section.settings.card_bg_color }};
    border: 1px solid {{ section.settings.border_color }};
    border-radius: 50px;
    cursor: pointer;
    font-size: 13px;
    font-weight: 500;
    color: {{ section.settings.text_color }};
    transition: all 0.3s ease;
    font-family: inherit;
  }

  .faq-category-btn:hover,
  .faq-category-btn.active {
    background: {{ section.settings.accent_color }};
    border-color: {{ section.settings.accent_color }};
    color: #ffffff;
    transform: translateY(-2px);
    box-shadow: 0 4px 15px rgba(201, 168, 124, 0.3);
  }

  .faq-category-btn.active {
    transform: translateY(0);
  }

  .faq-category-btn svg {
    width: 18px;
    height: 18px;
    fill: currentColor;
  }

  /* FAQ List */
  .faq-beauty-list {
    display: grid;
    gap: 16px;
  }

  .faq-beauty-list.two-column {
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }

  /* FAQ Item */
  .faq-beauty-item {
    background: {{ section.settings.card_bg_color }};
    border: 1px solid {{ section.settings.border_color }};
    border-radius: 16px;
    overflow: hidden;
    transition: all 0.3s ease;
  }

  .faq-beauty-item:hover {
    border-color: {{ section.settings.accent_color }};
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.06);
  }

  .faq-beauty-item.open {
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.08);
  }

  .faq-beauty-question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 24px 28px;
    cursor: pointer;
    background: transparent;
    border: none;
    width: 100%;
    text-align: left;
    font-family: inherit;
    transition: background-color 0.2s ease;
  }

  .faq-beauty-question:hover {
    background-color: {{ section.settings.hover_bg_color }};
  }

  .faq-beauty-question-text {
    font-size: {{ section.settings.question_size }}px;
    font-weight: 500;
    color: {{ section.settings.title_color }};
    line-height: 1.5;
    padding-right: 20px;
  }

  .faq-beauty-icon {
    width: 32px;
    height: 32px;
    min-width: 32px;
    border-radius: 50%;
    background: {{ section.settings.bg_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
  }

  .faq-beauty-icon svg {
    width: 14px;
    height: 14px;
    stroke: {{ section.settings.accent_color }};
    stroke-width: 2.5;
    fill: none;
    transition: transform 0.3s ease;
  }

  .faq-beauty-item.open .faq-beauty-icon {
    background: {{ section.settings.accent_color }};
  }

  .faq-beauty-item.open .faq-beauty-icon svg {
    stroke: #ffffff;
    transform: rotate(45deg);
  }

  .faq-beauty-answer {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.4s ease, padding 0.3s ease;
  }

  .faq-beauty-item.open .faq-beauty-answer {
    max-height: 500px;
  }

  .faq-beauty-answer-content {
    padding: 0 28px 28px 28px;
    color: {{ section.settings.text_color }};
    font-size: 15px;
    line-height: 1.8;
  }

  .faq-beauty-answer-content p {
    margin: 0 0 12px 0;
  }

  .faq-beauty-answer-content p:last-child {
    margin-bottom: 0;
  }

  .faq-beauty-answer-content strong {
    color: {{ section.settings.title_color }};
  }

  /* Category Badge */
  .faq-category-badge {
    display: inline-block;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    color: {{ section.settings.accent_color }};
    margin-bottom: 8px;
    opacity: 0.9;
  }

  /* CTA Section */
  .faq-beauty-cta {
    margin-top: 70px;
    background: {{ section.settings.cta_bg_color }};
    border-radius: 24px;
    padding: 50px 40px;
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .faq-beauty-cta::before {
    content: '';
    position: absolute;
    top: -50%;
    right: -20%;
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, {{ section.settings.accent_color }}20 0%, transparent 70%);
    pointer-events: none;
  }

  .faq-beauty-cta-title {
    font-size: 28px;
    font-weight: 300;
    color: {{ section.settings.cta_text_color }};
    margin: 0 0 15px 0;
    position: relative;
  }

  .faq-beauty-cta-text {
    font-size: 15px;
    color: {{ section.settings.cta_text_color }};
    opacity: 0.85;
    margin: 0 0 30px 0;
    max-width: 500px;
    margin-left: auto;
    margin-right: auto;
    line-height: 1.7;
    position: relative;
  }

  .faq-beauty-cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 16px 36px;
    background: {{ section.settings.cta_button_bg }};
    color: {{ section.settings.cta_button_text_color }};
    text-decoration: none;
    border-radius: 50px;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.5px;
    transition: all 0.3s ease;
    position: relative;
  }

  .faq-beauty-cta-btn:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 30px rgba(201, 168, 124, 0.4);
  }

  .faq-beauty-cta-btn svg {
    width: 18px;
    height: 18px;
    stroke: currentColor;
    stroke-width: 2;
    fill: none;
  }

  /* Search Box */
  .faq-search-wrapper {
    max-width: 500px;
    margin: 0 auto 40px auto;
    position: relative;
  }

  .faq-search-input {
    width: 100%;
    padding: 18px 25px 18px 55px;
    border: 1px solid {{ section.settings.border_color }};
    border-radius: 50px;
    font-size: 15px;
    font-family: inherit;
    background: {{ section.settings.card_bg_color }};
    color: {{ section.settings.title_color }};
    transition: all 0.3s ease;
  }

  .faq-search-input::placeholder {
    color: {{ section.settings.text_color }};
    opacity: 0.6;
  }

  .faq-search-input:focus {
    outline: none;
    border-color: {{ section.settings.accent_color }};
    box-shadow: 0 4px 20px rgba(201, 168, 124, 0.15);
  }

  .faq-search-icon {
    position: absolute;
    left: 22px;
    top: 50%;
    transform: translateY(-50%);
    width: 20px;
    height: 20px;
    stroke: {{ section.settings.text_color }};
    stroke-width: 2;
    fill: none;
    opacity: 0.5;
  }

  /* No Results */
  .faq-no-results {
    text-align: center;
    padding: 60px 20px;
    color: {{ section.settings.text_color }};
  }

  .faq-no-results-icon {
    width: 60px;
    height: 60px;
    margin-bottom: 20px;
    opacity: 0.3;
  }

  .faq-no-results-text {
    font-size: 16px;
    margin: 0;
  }

  /* Responsive */
  @media (max-width: 900px) {
    .faq-beauty-list.two-column {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 768px) {
    .faq-beauty-title {
      font-size: calc({{ section.settings.title_size }}px * 0.7);
    }

    .faq-beauty-header {
      margin-bottom: 40px;
    }

    .faq-category-filter {
      gap: 8px;
      margin-bottom: 30px;
    }

    .faq-category-btn {
      padding: 10px 16px;
      font-size: 12px;
    }

    .faq-beauty-question {
      padding: 20px;
    }

    .faq-beauty-question-text {
      font-size: calc({{ section.settings.question_size }}px - 1px);
    }

    .faq-beauty-answer-content {
      padding: 0 20px 20px 20px;
      font-size: 14px;
    }

    .faq-beauty-cta {
      padding: 40px 25px;
      margin-top: 50px;
    }

    .faq-beauty-cta-title {
      font-size: 22px;
    }
  }

  /* Animation */
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .faq-beauty-item {
    animation: fadeInUp 0.5s ease forwards;
  }

  .faq-beauty-item:nth-child(1) { animation-delay: 0.05s; }
  .faq-beauty-item:nth-child(2) { animation-delay: 0.1s; }
  .faq-beauty-item:nth-child(3) { animation-delay: 0.15s; }
  .faq-beauty-item:nth-child(4) { animation-delay: 0.2s; }
  .faq-beauty-item:nth-child(5) { animation-delay: 0.25s; }
  .faq-beauty-item:nth-child(6) { animation-delay: 0.3s; }
</style>

<section class="faq-beauty-section">
  <div class="faq-beauty-container">

    <!-- Header -->
    <div class="faq-beauty-header">
      <h2 class="faq-beauty-title">{{ section.settings.section_title }}</h2>
      {% if section.settings.section_subtitle != blank %}
        <p class="faq-beauty-subtitle">{{ section.settings.section_subtitle }}</p>
      {% endif %}
    </div>

    <!-- Search -->
    <div class="faq-search-wrapper">
      <svg class="faq-search-icon" viewBox="0 0 24 24">
        <circle cx="11" cy="11" r="8"></circle>
        <path d="m21 21-4.35-4.35"></path>
      </svg>
      <input type="text" class="faq-search-input" placeholder="Søg efter et spørgsmål..." id="faq-search-{{ section.id }}">
    </div>

    <!-- Category Filter -->
    {% assign categories = '' %}
    {% for block in section.blocks %}
      {% if block.type == 'category' %}
        {% unless categories contains block.settings.category_title %}
          {% if categories != '' %}
            {% assign categories = categories | append: '|||' %}
          {% endif %}
          {% assign categories = categories | append: block.settings.category_title | append: '::' | append: block.settings.category_icon %}
        {% endunless %}
      {% endif %}
    {% endfor %}

    {% assign category_array = categories | split: '|||' %}
    {% if category_array.size > 0 %}
      <div class="faq-category-filter">
        <button class="faq-category-btn active" data-category="all">
          <svg viewBox="0 0 24 24"><path d="M4 6h16M4 12h16M4 18h16"></path></svg>
          Alle
        </button>
        {% for cat in category_array %}
          {% assign cat_parts = cat | split: '::' %}
          {% assign cat_title = cat_parts[0] %}
          {% assign cat_icon = cat_parts[1] %}
          <button class="faq-category-btn" data-category="{{ cat_title | handleize }}">
            {% case cat_icon %}
              {% when 'skincare' %}
                <svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
              {% when 'makeup' %}
                <svg viewBox="0 0 24 24"><path d="M7 14c-1.66 0-3 1.34-3 3 0 1.31-1.16 2-2 2 .92 1.22 2.49 2 4 2 2.21 0 4-1.79 4-4 0-1.66-1.34-3-3-3zm13.71-9.37l-1.34-1.34a.996.996 0 0 0-1.41 0L9 12.25 11.75 15l8.96-8.96a.996.996 0 0 0 0-1.41z"/></svg>
              {% when 'haircare' %}
                <svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8z"/></svg>
              {% when 'fragrance' %}
                <svg viewBox="0 0 24 24"><path d="M6 3v6c0 2.97 2.16 5.43 5 5.91V19H8v2h8v-2h-3v-4.09c2.84-.48 5-2.94 5-5.91V3H6zm10 6H8V5h8v4z"/></svg>
              {% when 'shipping' %}
                <svg viewBox="0 0 24 24"><path d="M19 7h-3V6a4 4 0 0 0-8 0v1H5a1 1 0 0 0-1 1v11a3 3 0 0 0 3 3h10a3 3 0 0 0 3-3V8a1 1 0 0 0-1-1zm-9-1a2 2 0 0 1 4 0v1h-4V6zm8 13a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V9h2v1a1 1 0 0 0 2 0V9h4v1a1 1 0 0 0 2 0V9h2v10z"/></svg>
              {% when 'returns' %}
                <svg viewBox="0 0 24 24"><path d="M12 5V1L7 6l5 5V7c3.31 0 6 2.69 6 6s-2.69 6-6 6-6-2.69-6-6H4c0 4.42 3.58 8 8 8s8-3.58 8-8-3.58-8-8-8z"/></svg>
              {% when 'ingredients' %}
                <svg viewBox="0 0 24 24"><path d="M12 22c4.97 0 9-4.03 9-9-4.97 0-9 4.03-9 9zM5.6 10.25c0 1.38 1.12 2.5 2.5 2.5.53 0 1.01-.16 1.42-.44l-.02.19c0 1.38 1.12 2.5 2.5 2.5s2.5-1.12 2.5-2.5l-.02-.19c.4.28.89.44 1.42.44 1.38 0 2.5-1.12 2.5-2.5 0-1-.59-1.85-1.43-2.25.84-.4 1.43-1.25 1.43-2.25 0-1.38-1.12-2.5-2.5-2.5-.53 0-1.01.16-1.42.44l.02-.19C14.5 4.12 13.38 3 12 3S9.5 4.12 9.5 5.5l.02.19c-.4-.28-.89-.44-1.42-.44-1.38 0-2.5 1.12-2.5 2.5 0 1 .59 1.85 1.43 2.25-.84.4-1.43 1.25-1.43 2.25z"/></svg>
              {% else %}
                <svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 17h-2v-2h2v2zm2.07-7.75l-.9.92C13.45 12.9 13 13.5 13 15h-2v-.5c0-1.1.45-2.1 1.17-2.83l1.24-1.26c.37-.36.59-.86.59-1.41 0-1.1-.9-2-2-2s-2 .9-2 2H8c0-2.21 1.79-4 4-4s4 1.79 4 4c0 .88-.36 1.68-.93 2.25z"/></svg>
            {% endcase %}
            {{ cat_title }}
          </button>
        {% endfor %}
      </div>
    {% endif %}

    <!-- FAQ List -->
    <div class="faq-beauty-list {% if section.settings.layout_style == 'two-column' %}two-column{% endif %}" id="faq-list-{{ section.id }}">
      {% for block in section.blocks %}
        {% if block.type == 'faq' %}
          <div class="faq-beauty-item" data-category="{{ block.settings.category | handleize }}" {{ block.shopify_attributes }}>
            <button class="faq-beauty-question" aria-expanded="false">
              <div>
                {% if block.settings.category != blank %}
                  <span class="faq-category-badge">{{ block.settings.category }}</span>
                {% endif %}
                <span class="faq-beauty-question-text">{{ block.settings.question }}</span>
              </div>
              <span class="faq-beauty-icon">
                <svg viewBox="0 0 24 24">
                  <line x1="12" y1="5" x2="12" y2="19"></line>
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
              </span>
            </button>
            <div class="faq-beauty-answer">
              <div class="faq-beauty-answer-content">
                {{ block.settings.answer }}
              </div>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    <!-- No Results Message -->
    <div class="faq-no-results" id="faq-no-results-{{ section.id }}" style="display: none;">
      <svg class="faq-no-results-icon" viewBox="0 0 24 24" fill="{{ section.settings.text_color }}">
        <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 17h-2v-2h2v2zm2.07-7.75l-.9.92C13.45 12.9 13 13.5 13 15h-2v-.5c0-1.1.45-2.1 1.17-2.83l1.24-1.26c.37-.36.59-.86.59-1.41 0-1.1-.9-2-2-2s-2 .9-2 2H8c0-2.21 1.79-4 4-4s4 1.79 4 4c0 .88-.36 1.68-.93 2.25z"/>
      </svg>
      <p class="faq-no-results-text">Ingen spørgsmål matcher din søgning</p>
    </div>

    <!-- CTA Section -->
    {% if section.settings.show_cta %}
      <div class="faq-beauty-cta">
        <h3 class="faq-beauty-cta-title">{{ section.settings.cta_title }}</h3>
        <p class="faq-beauty-cta-text">{{ section.settings.cta_text }}</p>
        <a href="{{ section.settings.cta_button_url | default: '/pages/contact' }}" class="faq-beauty-cta-btn">
          {{ section.settings.cta_button_text }}
          <svg viewBox="0 0 24 24">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
    {% endif %}

  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const sectionId = '{{ section.id }}';
    const faqItems = document.querySelectorAll(`#faq-list-${sectionId} .faq-beauty-item`);
    const categoryBtns = document.querySelectorAll(`.faq-category-filter .faq-category-btn`);
    const searchInput = document.getElementById(`faq-search-${sectionId}`);
    const noResults = document.getElementById(`faq-no-results-${sectionId}`);

    // Accordion functionality
    faqItems.forEach(item => {
      const question = item.querySelector('.faq-beauty-question');
      question.addEventListener('click', () => {
        const isOpen = item.classList.contains('open');

        // Close all other items
        faqItems.forEach(otherItem => {
          if (otherItem !== item) {
            otherItem.classList.remove('open');
            otherItem.querySelector('.faq-beauty-question').setAttribute('aria-expanded', 'false');
          }
        });

        // Toggle current item
        item.classList.toggle('open');
        question.setAttribute('aria-expanded', !isOpen);
      });
    });

    // Category filter
    categoryBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const category = btn.dataset.category;

        // Update active state
        categoryBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        // Filter items
        let visibleCount = 0;
        faqItems.forEach(item => {
          if (category === 'all' || item.dataset.category === category) {
            item.style.display = '';
            visibleCount++;
          } else {
            item.style.display = 'none';
          }
        });

        // Show/hide no results
        noResults.style.display = visibleCount === 0 ? '' : 'none';
      });
    });

    // Search functionality
    if (searchInput) {
      searchInput.addEventListener('input', function() {
        const searchTerm = this.value.toLowerCase().trim();
        let visibleCount = 0;

        faqItems.forEach(item => {
          const question = item.querySelector('.faq-beauty-question-text').textContent.toLowerCase();
          const answer = item.querySelector('.faq-beauty-answer-content').textContent.toLowerCase();

          if (question.includes(searchTerm) || answer.includes(searchTerm)) {
            item.style.display = '';
            visibleCount++;
          } else {
            item.style.display = 'none';
          }
        });

        // Reset category filter
        categoryBtns.forEach(b => b.classList.remove('active'));
        document.querySelector('.faq-category-btn[data-category="all"]')?.classList.add('active');

        // Show/hide no results
        noResults.style.display = visibleCount === 0 ? '' : 'none';
      });
    }
  });
</script>
