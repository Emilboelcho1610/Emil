{% comment %}
  Komfort Køledynen – Feature Highlight med Image Hotspots
  Venstre: overskrift + bullets | Højre: billede med pulserende klikpunkter
{% endcomment %}

{{ 'component-image-with-text.css' | asset_url | stylesheet_tag }}

<section
  class="fh"
  id="fh-{{ section.id }}"
  style="
    --fh-bg: {{ section.settings.background_color }};
    --fh-accent: {{ section.settings.accent_color }};
    --fh-heading-color: {{ section.settings.heading_color }};
    --fh-text-color: {{ section.settings.text_color }};
    --fh-popup-bg: {{ section.settings.popup_bg_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="fh__inner">

    <!-- ── VENSTRE: tekst ── -->
    <div class="fh__text">
      {% if section.settings.eyebrow != blank %}
        <p class="fh__eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="fh__heading image-with-text__heading inline-richtext {{ section.settings.heading_size }}">
          {{- section.settings.heading -}}
        </h2>
      {% endif %}

      {% if section.settings.subtext != blank %}
        <p class="fh__subtext">{{ section.settings.subtext }}</p>
      {% endif %}

      {% assign bullets = section.blocks | where: "type", "bullet" %}
      {% if bullets.size > 0 %}
        <ul class="fh__bullets">
          {% for block in bullets %}
            <li class="fh__bullet" {{ block.shopify_attributes }}>
              <span class="fh__bullet-icon" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
                  <circle cx="9" cy="9" r="9" fill="var(--fh-accent)" opacity="0.12"/>
                  <path d="M5 9L7.8 12L13 6.5" stroke="var(--fh-accent)" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
              <div>
                {% if block.settings.bullet_heading != blank %}
                  <strong class="fh__bullet-heading">{{ block.settings.bullet_heading }}</strong>
                {% endif %}
                {% if block.settings.bullet_text != blank %}
                  <span class="fh__bullet-text">{{ block.settings.bullet_text }}</span>
                {% endif %}
              </div>
            </li>
          {% endfor %}
        </ul>
      {% endif %}

      {% if section.settings.button_label != blank and section.settings.button_url != blank %}
        <a href="{{ section.settings.button_url }}" class="fh__cta">
          {{ section.settings.button_label }}
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8H13M13 8L9 4M13 8L9 12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      {% endif %}
    </div>

    <!-- ── HØJRE: billede + hotspots ── -->
    <div class="fh__media">
      <div class="fh__image-wrap">

        {% if section.settings.image != blank %}
          {{
            section.settings.image
            | image_url: width: 1000
            | image_tag:
              loading: 'lazy',
              widths: '500, 800, 1000',
              sizes: '(min-width: 990px) 50vw, 100vw',
              class: 'fh__image'
          }}
        {% else %}
          {{ 'product-2' | placeholder_svg_tag: 'fh__placeholder' }}
        {% endif %}

        <!-- Hotspots -->
        {% assign hotspots = section.blocks | where: "type", "hotspot" %}
        {% for block in hotspots %}
          <button
            class="fh__dot"
            id="fh-dot-{{ block.id }}"
            aria-label="{{ block.settings.title | default: 'Info' }}"
            aria-expanded="false"
            aria-controls="fh-popup-{{ block.id }}"
            style="
              left: {{ block.settings.pos_x }}%;
              top: {{ block.settings.pos_y }}%;
              --dot-color: {{ block.settings.dot_color }};
            "
            {{ block.shopify_attributes }}
          >
            <span class="fh__dot-ring" aria-hidden="true"></span>
            <span class="fh__dot-core" aria-hidden="true">
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                <path d="M6 2.5V6.5M6 8.5V9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
              </svg>
            </span>
          </button>

          <!-- Popup -->
          <div
            class="fh__popup"
            id="fh-popup-{{ block.id }}"
            role="tooltip"
            aria-hidden="true"
            data-hotspot-id="{{ block.id }}"
            style="
              left: {{ block.settings.pos_x }}%;
              top: {{ block.settings.pos_y }}%;
            "
          >
            <button class="fh__popup-close" aria-label="Luk">
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                <path d="M1 1L11 11M11 1L1 11" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
              </svg>
            </button>
            {% if block.settings.title != blank %}
              <p class="fh__popup-title">{{ block.settings.title }}</p>
            {% endif %}
            {% if block.settings.description != blank %}
              <p class="fh__popup-desc">{{ block.settings.description }}</p>
            {% endif %}
            {% if block.settings.stat != blank %}
              <p class="fh__popup-stat">{{ block.settings.stat }}</p>
            {% endif %}
          </div>
        {% endfor %}

      </div>

      {% if section.settings.image_caption != blank %}
        <p class="fh__caption">{{ section.settings.image_caption }}</p>
      {% endif %}
    </div>

  </div>
</section>

<style>
  #fh-{{ section.id }} {
    background: var(--fh-bg);
    color: var(--fh-text-color);
  }

  /* ── Layout ── */
  .fh__inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: center;
  }

  /* ── Venstre tekst ── */
  .fh__eyebrow {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fh-accent);
    margin: 0 0 14px;
  }

  .fh__heading {
    color: var(--fh-heading-color);
    margin: 0 0 16px;
  }

  /* Fed tekst i overskriften skifter til accent-farven */
  .fh__heading strong {
    color: var(--fh-accent);
    font-weight: inherit;
  }

  .fh__subtext {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--fh-text-color);
    opacity: 0.8;
    margin: 0 0 28px;
  }

  .fh__bullets {
    list-style: none;
    padding: 0;
    margin: 0 0 32px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .fh__bullet {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .fh__bullet-icon {
    flex-shrink: 0;
    margin-top: 1px;
  }

  .fh__bullet-heading {
    display: block;
    font-weight: 700;
    color: var(--fh-heading-color);
    margin-bottom: 2px;
  }

  .fh__bullet-text {
    display: block;
    opacity: 0.75;
    font-size: 0.9rem;
  }

  .fh__cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--fh-accent);
    color: #fff;
    font-size: 0.95rem;
    font-weight: 700;
    text-decoration: none;
    padding: 14px 28px;
    border-radius: 999px;
    letter-spacing: 0.02em;
    transition: opacity 0.2s, transform 0.2s;
  }

  .fh__cta:hover {
    opacity: 0.88;
    transform: translateY(-2px);
  }

  /* ── Billede ── */
  .fh__media {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .fh__image-wrap {
    position: relative;
    border-radius: 20px;
    overflow: visible;
    aspect-ratio: 4 / 3;
  }

  .fh__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 20px;
    display: block;
  }

  .fh__placeholder {
    width: 100%;
    height: 100%;
    border-radius: 20px;
    background: #e8f0f6;
    opacity: 0.5;
  }

  .fh__caption {
    font-size: 0.8rem;
    text-align: center;
    opacity: 0.5;
    margin: 0;
  }

  /* ── Hotspot dot ── */
  .fh__dot {
    position: absolute;
    width: 40px;
    height: 40px;
    transform: translate(-50%, -50%);
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .fh__dot-ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--dot-color, var(--fh-accent));
    opacity: 0.25;
    animation: fh-pulse 2s ease-out infinite;
  }

  .fh__dot-core {
    position: relative;
    z-index: 1;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--dot-color, var(--fh-accent));
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 12px rgba(0,0,0,0.25);
    transition: transform 0.15s ease, background 0.15s ease;
  }

  .fh__dot:hover .fh__dot-core,
  .fh__dot[aria-expanded="true"] .fh__dot-core {
    transform: scale(1.18);
  }

  .fh__dot[aria-expanded="true"] .fh__dot-ring {
    animation: none;
    opacity: 0.4;
  }

  @keyframes fh-pulse {
    0%   { transform: scale(1);   opacity: 0.35; }
    70%  { transform: scale(2.2); opacity: 0; }
    100% { transform: scale(2.2); opacity: 0; }
  }

  /* ── Popup ── */
  .fh__popup {
    position: absolute;
    z-index: 20;
    width: 220px;
    background: var(--fh-popup-bg);
    border-radius: 14px;
    padding: 16px 18px;
    box-shadow: 0 8px 32px rgba(0,0,0,0.18), 0 2px 8px rgba(0,0,0,0.08);
    transform: translate(-50%, calc(-100% - 20px));
    pointer-events: none;
    opacity: 0;
    scale: 0.88;
    transition: opacity 0.2s ease, scale 0.2s ease;
    transform-origin: bottom center;
  }

  .fh__popup.fh__popup--active {
    opacity: 1;
    scale: 1;
    pointer-events: auto;
  }

  /* Popup-pil */
  .fh__popup::after {
    content: '';
    position: absolute;
    bottom: -8px;
    left: 50%;
    transform: translateX(-50%);
    width: 0;
    height: 0;
    border-left: 9px solid transparent;
    border-right: 9px solid transparent;
    border-top: 9px solid var(--fh-popup-bg);
  }

  /* Flyt popup ned hvis den er øverst på billedet */
  .fh__popup.fh__popup--below {
    transform: translate(-50%, 20px);
    transform-origin: top center;
  }

  .fh__popup.fh__popup--below::after {
    bottom: auto;
    top: -8px;
    border-top: none;
    border-bottom: 9px solid var(--fh-popup-bg);
  }

  .fh__popup-close {
    position: absolute;
    top: 10px;
    right: 10px;
    background: rgba(0,0,0,0.07);
    border: none;
    cursor: pointer;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--fh-heading-color);
    padding: 0;
    transition: background 0.15s;
  }

  .fh__popup-close:hover {
    background: rgba(0,0,0,0.14);
  }

  .fh__popup-title {
    font-size: 0.875rem;
    font-weight: 800;
    color: var(--fh-heading-color);
    margin: 0 20px 6px 0;
    line-height: 1.3;
  }

  .fh__popup-desc {
    font-size: 0.8rem;
    line-height: 1.55;
    color: var(--fh-text-color);
    margin: 0 0 8px;
    opacity: 0.85;
  }

  .fh__popup-stat {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--fh-accent);
    margin: 0;
    padding-top: 8px;
    border-top: 1px solid rgba(0,0,0,0.07);
  }

  /* ── Responsiv ── */
  @media screen and (max-width: 989px) {
    .fh__inner {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    /* Billede øverst på mobil */
    .fh__media { order: -1; }

    .fh__popup {
      width: 190px;
    }
  }

  @media screen and (max-width: 479px) {
    .fh__inner { padding: 0 16px; }

    .fh__dot {
      width: 34px;
      height: 34px;
    }

    .fh__dot-core {
      width: 24px;
      height: 24px;
    }
  }
</style>

<script>
(function () {
  const section = document.getElementById('fh-{{ section.id }}');
  if (!section) return;

  const dots = section.querySelectorAll('.fh__dot');
  const popups = section.querySelectorAll('.fh__popup');

  function closeAll() {
    dots.forEach(d => d.setAttribute('aria-expanded', 'false'));
    popups.forEach(p => {
      p.classList.remove('fh__popup--active');
      p.setAttribute('aria-hidden', 'true');
    });
  }

  function positionPopup(popup) {
    // Flyt popup ned hvis hotspot er øverst på billedet (< 30%)
    const topPct = parseFloat(popup.style.top);
    if (topPct < 30) {
      popup.classList.add('fh__popup--below');
    } else {
      popup.classList.remove('fh__popup--below');
    }
  }

  dots.forEach(dot => {
    dot.addEventListener('click', function (e) {
      e.stopPropagation();
      const targetId = this.getAttribute('aria-controls');
      const popup = section.querySelector('#' + targetId);
      const isOpen = this.getAttribute('aria-expanded') === 'true';

      closeAll();

      if (!isOpen && popup) {
        this.setAttribute('aria-expanded', 'true');
        popup.classList.add('fh__popup--active');
        popup.setAttribute('aria-hidden', 'false');
        positionPopup(popup);
      }
    });
  });

  // Luk-knapper inde i popup
  section.querySelectorAll('.fh__popup-close').forEach(btn => {
    btn.addEventListener('click', function (e) {
      e.stopPropagation();
      closeAll();
    });
  });

  // Klik udenfor lukker alle popups
  document.addEventListener('click', function (e) {
    if (!section.contains(e.target)) closeAll();
  });

  // Escape-tast lukker
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') closeAll();
  });
})();
</script>

{% schema %}
{
