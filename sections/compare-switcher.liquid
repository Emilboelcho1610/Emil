    { "type": "text", "id": "left_col_title", "label": "Left column title (DE)", "default": "Neuroblends" },

    { "type": "checkbox", "id": "show_button", "label": "Show button", "default": true },
    { "type": "text", "id": "button_label", "label": "Button label (DE)", "default": "Jetzt kaufen" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "variant",
      "name": "Variant",
      "settings": [
