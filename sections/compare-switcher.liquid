        { "type": "text", "id": "label", "label": "Tab label", "default": "SHARP" },

        { "type": "header", "content": "Left Column (Neuroblends)" },
        { "type": "image_picker", "id": "can_image", "label": "Left column image" },
        { "type": "color", "id": "pill_bg", "label": "Left column pill background", "default": "#EAF4E8" },
        { "type": "text", "id": "row_left_1", "label": "Left row 1", "default": "Fokus und Produktivitet, ruhige Energie" },
        { "type": "text", "id": "row_left_2", "label": "Left row 2", "default": "Zuckerfrei" },
        { "type": "text", "id": "row_left_3", "label": "Left row 3", "default": "Klare Dosierung und funktionale Zutaten" },
        { "type": "text", "id": "row_left_4", "label": "Left row 4", "default": "Transparent und sauber deklariert" },

        { "type": "header", "content": "Middle Column (Comparison 1)" },
