{% comment %} Feature Accordion — eksklusivt panel-layout {% endcomment %}

<section class="fac" id="fac-{{ section.id }}" style="
  --fac-bg: {{ section.settings.bg_color }};
  --fac-accent: {{ section.settings.accent_color }};
  --fac-text: {{ section.settings.text_color }};
  --fac-muted: {{ section.settings.muted_color }};
  --fac-border: {{ section.settings.border_color }};
  --fac-pt: {{ section.settings.padding_top }}px;
  --fac-pb: {{ section.settings.padding_bottom }}px;
">

  {%- if section.settings.eyebrow != blank -%}
    <p class="fac__eyebrow">{{ section.settings.eyebrow }}</p>
  {%- endif -%}

  <div class="fac__panels" role="list">
    {%- for block in section.blocks -%}
      <div
        class="fac__panel{% if forloop.first %} is-open{% endif %}"
        data-index="{{ forloop.index0 }}"
        role="listitem"
        tabindex="0"
        aria-expanded="{% if forloop.first %}true{% else %}false{% endif %}"
        {{ block.shopify_attributes }}
      >
        <div class="fac__panel-inner">

          <!-- Nummer -->
          <span class="fac__num">0{{ forloop.index }}</span>

          <!-- Ikon -->
          <div class="fac__icon">
            {%- case block.settings.icon_type -%}
              {%- when 'weight' -%}
                <svg viewBox="0 0 48 48" fill="none"><path d="M24 7c-4.42 0-8 3.58-8 8 0 1.74.56 3.34 1.5 4.65L13 26H8a3 3 0 0 0-3 3v3a3 3 0 0 0 3 3h32a3 3 0 0 0 3-3v-3a3 3 0 0 0-3-3h-5l-4.5-6.35A7.97 7.97 0 0 0 32 15c0-4.42-3.58-8-8-8Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><circle cx="24" cy="15" r="3" stroke="currentColor" stroke-width="2"/></svg>
              {%- when 'feather' -%}
                <svg viewBox="0 0 48 48" fill="none"><path d="M34 6C27 6 14 12 12 28L7 42" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M34 6c0 0 5 9 0 19-5 10-14 11-22 3" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M19 21L12 28M26 14L16 34" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
              {%- when 'leaf' -%}
                <svg viewBox="0 0 48 48" fill="none"><path d="M8 40c0 0 2-16 14-22 12-6 16-12 16-12s2 15-10 23C16 37 8 40 8 40Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M8 40l12-11" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
              {%- when 'shield' -%}
                <svg viewBox="0 0 48 48" fill="none"><path d="M24 4L7 12v14c0 9.4 7.3 18.2 17 20 9.7-1.8 17-10.6 17-20V12L24 4Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M16 24l5.5 5.5L33 19" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              {%- when 'moon' -%}
                <svg viewBox="0 0 48 48" fill="none"><path d="M40 26A16 16 0 1 1 22 8a13 13 0 0 0 18 18Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              {%- when 'star' -%}
                <svg viewBox="0 0 48 48" fill="none"><path d="M24 5l5.5 11.2 12.3 1.8-8.9 8.7 2.1 12.3L24 33l-11 5.8 2.1-12.3-8.9-8.7 12.3-1.8L24 5Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              {%- when 'heart' -%}
                <svg viewBox="0 0 48 48" fill="none"><path d="M24 41S7 30 7 17.5A9 9 0 0 1 23.5 12 9 9 0 0 1 41 17.5C41 30 24 41 24 41Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              {%- when 'text' -%}
                <span class="fac__icon-num"
                  {% if block.settings.animate_number %}data-count="{{ block.settings.icon_text }}"{% endif %}
                >{{ block.settings.icon_text }}</span>
              {%- else -%}
                <svg viewBox="0 0 48 48" fill="none"><circle cx="24" cy="24" r="16" stroke="currentColor" stroke-width="2"/></svg>
            {%- endcase -%}
          </div>

          <!-- Tekst -->
          <div class="fac__text">
            <h3 class="fac__title">{{ block.settings.title }}</h3>
            {%- if block.settings.body != blank -%}
              <p class="fac__body">{{ block.settings.body }}</p>
            {%- endif -%}
          </div>

          <!-- Pil -->
          <div class="fac__arrow" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>

        </div>

        <!-- Baggrundsfarve-glow på aktiv -->
        <div class="fac__fill" aria-hidden="true"></div>
      </div>
    {%- endfor -%}
  </div>

</section>

<style>
#fac-{{ section.id }} {
  background: var(--fac-bg);
  padding: var(--fac-pt) 0 var(--fac-pb);
  overflow: hidden;
}

.fac__eyebrow {
  text-align: center;
  font-size: .75rem;
  font-weight: 600;
  letter-spacing: .18em;
  text-transform: uppercase;
  color: var(--fac-accent);
  margin: 0 0 40px;
}

/* ── Panelrail ── */
.fac__panels {
  display: flex;
  height: clamp(320px, 50vh, 520px);
  border-top: 1px solid var(--fac-border);
  border-bottom: 1px solid var(--fac-border);
}

/* ── Enkelt panel ── */
.fac__panel {
  position: relative;
  flex: 1;
  border-right: 1px solid var(--fac-border);
  overflow: hidden;
  cursor: pointer;
  outline: none;
  transition: flex 0.65s cubic-bezier(0.77, 0, 0.18, 1);
}
.fac__panel:last-child { border-right: none; }

.fac__panel.is-open { flex: 3.2; }

/* fill-glow */
.fac__fill {
  position: absolute;
  inset: 0;
  background: var(--fac-accent);
  opacity: 0;
  transition: opacity 0.55s ease;
  pointer-events: none;
  z-index: 0;
}
.fac__panel.is-open .fac__fill { opacity: 0.06; }

/* inner */
.fac__panel-inner {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  height: 100%;
  padding: 36px 32px;
  gap: 14px;
}

/* nummer */
.fac__num {
  font-size: .7rem;
  font-weight: 700;
  letter-spacing: .14em;
  color: var(--fac-accent);
  opacity: 0.7;
  display: block;
  margin-bottom: 4px;
  transition: opacity 0.3s;
}
.fac__panel.is-open .fac__num { opacity: 1; }

/* ikon */
.fac__icon {
  width: 52px;
  height: 52px;
  color: var(--fac-text);
  flex-shrink: 0;
  transition: color 0.3s, transform 0.45s cubic-bezier(0.34,1.56,0.64,1);
}
.fac__icon svg { width: 100%; height: 100%; display: block; }
.fac__panel.is-open .fac__icon {
  color: var(--fac-accent);
  transform: scale(1.12);
}

.fac__icon-num {
  font-size: 2.2rem;
  font-weight: 800;
  line-height: 1;
  letter-spacing: -0.04em;
  color: var(--fac-accent);
  display: block;
}

/* tekst */
.fac__text { overflow: hidden; }

.fac__title {
  font-size: clamp(1rem, 2vw, 1.45rem);
  font-weight: 700;
  color: var(--fac-text);
  margin: 0;
  line-height: 1.2;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  transition: white-space 0.3s;
}
.fac__panel.is-open .fac__title {
  white-space: normal;
  text-overflow: unset;
}

.fac__body {
  font-size: .88rem;
  color: var(--fac-muted);
  margin: 8px 0 0;
  line-height: 1.65;
  max-width: 340px;
  max-height: 0;
  overflow: hidden;
  opacity: 0;
  transition: max-height 0.5s cubic-bezier(0.77,0,0.18,1), opacity 0.4s ease 0.1s;
}
.fac__panel.is-open .fac__body {
  max-height: 120px;
  opacity: 1;
}

/* pil */
.fac__arrow {
  width: 28px;
  height: 28px;
  color: var(--fac-accent);
  opacity: 0;
  transform: translateX(-8px);
  transition: opacity 0.35s ease, transform 0.4s cubic-bezier(0.34,1.56,0.64,1);
  margin-top: 4px;
}
.fac__arrow svg { width: 100%; height: 100%; }
.fac__panel.is-open .fac__arrow {
  opacity: 1;
  transform: translateX(0);
}

/* ── MOBIL ── */
@media (max-width: 768px) {
  .fac__panels {
    flex-direction: column;
    height: auto;
    border-top: none;
    border-bottom: none;
  }

  .fac__panel {
    flex: none;
    border-right: none;
    border-bottom: 1px solid var(--fac-border);
    transition: none;
  }
  .fac__panel:last-child { border-bottom: none; }

  .fac__panel-inner {
    flex-direction: row;
    align-items: center;
    padding: 24px 20px;
    gap: 16px;
    justify-content: flex-start;
  }

  .fac__icon {
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    transform: none !important;
  }

  .fac__text { flex: 1; min-width: 0; }

  .fac__title { font-size: 1rem; white-space: normal; }

  .fac__body {
    max-height: none !important;
    opacity: 1 !important;
    font-size: .82rem;
  }

  .fac__num { display: none; }

  .fac__arrow {
    opacity: 1 !important;
    transform: none !important;
  }

  .fac__fill { display: none; }
}
</style>

<script>
(function () {
  var section = document.getElementById('fac-{{ section.id }}');
  if (!section) return;

  var panels = section.querySelectorAll('.fac__panel');

  function activate(panel) {
    panels.forEach(function (p) {
      var open = p === panel;
      p.classList.toggle('is-open', open);
      p.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
  }

  panels.forEach(function (panel) {
    panel.addEventListener('click', function () { activate(panel); });
    panel.addEventListener('mouseenter', function () { activate(panel); });
    panel.addEventListener('keydown', function (e) {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); activate(panel); }
    });
  });

  /* Count-up animation */
  var countEls = section.querySelectorAll('[data-count]');
  if (countEls.length) {
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (!entry.isIntersecting) return;
        var el = entry.target;
        var target = parseInt(el.getAttribute('data-count'), 10);
        if (isNaN(target)) return;
        var start = null;
        var dur = 1400;
        function step(ts) {
          if (!start) start = ts;
          var p = Math.min((ts - start) / dur, 1);
          el.textContent = Math.round((1 - Math.pow(1 - p, 3)) * target);
          if (p < 1) requestAnimationFrame(step);
        }
        requestAnimationFrame(step);
        io.unobserve(el);
      });
    }, { threshold: 0.5 });
    countEls.forEach(function (el) { el.textContent = '0'; io.observe(el); });
  }

  /* Entrance: fade section in */
  section.style.opacity = '0';
  section.style.transform = 'translateY(24px)';
  section.style.transition = 'opacity 0.7s ease, transform 0.7s ease';
  var entryIo = new IntersectionObserver(function (entries) {
    if (entries[0].isIntersecting) {
      section.style.opacity = '1';
      section.style.transform = 'translateY(0)';
      entryIo.disconnect();
    }
  }, { threshold: 0.1 });
  entryIo.observe(section);
})();
</script>

{% schema %}
{
  "name": "Feature Accordion",
  "tag": "section",
  "class": "fac-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow-tekst (lille tekst over)",
      "placeholder": "f.eks. Hvorfor vælge os"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Baggrundfarve",
      "default": "#0e1a24"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accentfarve (ikoner & highlights)",
      "default": "#7fbcd2"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Tekstfarve",
      "default": "#f0f4f8"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Dæmpet tekstfarve (brødtekst)",
      "default": "#8aa5b8"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Linjefarve",
      "default": "#1e3040"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Afstand øverst (px)",
      "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Afstand nederst (px)",
      "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72
    }
  ],
  "blocks": [
    {
      "type": "panel",
      "name": "Feature-panel",
      "settings": [
        {
          "type": "select",
          "id": "icon_type",
          "label": "Ikon",
          "options": [
            { "value": "weight",  "label": "Vægt / kettlebell" },
            { "value": "feather", "label": "Fjer" },
            { "value": "leaf",    "label": "Blad" },
            { "value": "shield",  "label": "Skjold / flueben" },
            { "value": "moon",    "label": "Måne" },
            { "value": "star",    "label": "Stjerne" },
            { "value": "heart",   "label": "Hjerte" },
            { "value": "text",    "label": "Stort tal / tekst" }
          ],
          "default": "shield"
        },
        {
          "type": "text",
          "id": "icon_text",
          "label": "Tal/tekst i ikon (kun ved 'Stort tal')",
          "default": "35"
        },
        {
          "type": "checkbox",
          "id": "animate_number",
          "label": "Animér tal (tæller op)",
          "default": true
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titel",
          "default": "Feature-titel"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Beskrivelse",
          "default": "Kort beskrivelse af denne fordel, der vises når panelet er aktivt."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Feature Accordion",
      "settings": {
        "eyebrow": "Hvorfor Komfort Tyngdedyne™"
      },
      "blocks": [
        {
          "type": "panel",
          "settings": {
            "icon_type": "weight",
            "title": "Tung og beroligende",
            "body": "Den dybe tryk stimulerer nervesystemet og hjælper kroppen med at slappe af — naturligt og effektivt."
          }
        },
        {
          "type": "panel",
          "settings": {
            "icon_type": "feather",
            "title": "Stor, fyldig og hyggelig",
            "body": "Fyldigt design giver dig en varm, omfavnende følelse — som at blive pakket ind i noget blødt og godt."
          }
        },
        {
          "type": "panel",
          "settings": {
            "icon_type": "leaf",
            "title": "OEKO TEX® Allergivenlig",
            "body": "Alle materialer er testet og certificeret fri for skadelige stoffer. Trygt for hele familien."
          }
        },
        {
          "type": "panel",
          "settings": {
            "icon_type": "text",
            "icon_text": "35",
            "animate_number": true,
            "title": "35 Dages prøveperiode",
            "body": "Prøv den i 35 dage derhjemme. Hvis du ikke er tilfreds, bytter vi uden spørgsmål."
          }
        }
      ]
    }
  ],
  "max_blocks": 6
}
{% endschema %}
