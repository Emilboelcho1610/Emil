{% schema %}
{
  "name": "Footer (Beauty Brand)",
  "settings": [
    {
      "type": "header",
      "content": "Farver"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Baggrundsfarve",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "bg_gradient_end",
      "label": "Gradient slutfarve (valgfri)",
      "default": "#2d2d2d"
    },
    {
      "type": "checkbox",
      "id": "use_gradient",
      "label": "Brug gradient baggrund",
      "default": false
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Primær tekstfarve",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "muted_text_color",
      "label": "Sekundær tekst",
      "default": "#a0a0a0"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent farve",
      "default": "#d4a574"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Borders og linjer",
      "default": "rgba(255,255,255,0.1)"
    },

    {
      "type": "header",
      "content": "Brand / Logo"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Footer logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo bredde",
      "min": 60,
      "max": 200,
      "step": 10,
      "default": 120,
      "unit": "px"
    },
    {
      "type": "textarea",
      "id": "brand_tagline",
      "label": "Brand tagline",
      "default": "Naturlig skønhed, ren science"
    },

    {
      "type": "header",
      "content": "USP Badges"
    },
    {
      "type": "checkbox",
      "id": "show_usp",
      "label": "Vis USP badges",
      "default": true
    },
    {
      "type": "text",
      "id": "usp_1_text",
      "label": "USP 1 tekst",
      "default": "Gratis fragt over 499 kr"
    },
    {
      "type": "select",
      "id": "usp_1_icon",
      "label": "USP 1 ikon",
      "options": [
        { "value": "shipping", "label": "Fragt" },
        { "value": "leaf", "label": "Blad / Naturlig" },
        { "value": "heart", "label": "Hjerte" },
        { "value": "star", "label": "Stjerne" },
        { "value": "shield", "label": "Garanti" },
        { "value": "recycle", "label": "Bæredygtig" }
      ],
      "default": "shipping"
    },
    {
      "type": "text",
      "id": "usp_2_text",
      "label": "USP 2 tekst",
      "default": "30 dages returret"
    },
    {
      "type": "select",
      "id": "usp_2_icon",
      "label": "USP 2 ikon",
      "options": [
        { "value": "shipping", "label": "Fragt" },
        { "value": "leaf", "label": "Blad / Naturlig" },
        { "value": "heart", "label": "Hjerte" },
        { "value": "star", "label": "Stjerne" },
        { "value": "shield", "label": "Garanti" },
        { "value": "recycle", "label": "Bæredygtig" }
      ],
      "default": "shield"
    },
    {
      "type": "text",
      "id": "usp_3_text",
      "label": "USP 3 tekst",
      "default": "100% vegansk & cruelty-free"
    },
    {
      "type": "select",
      "id": "usp_3_icon",
      "label": "USP 3 ikon",
      "options": [
        { "value": "shipping", "label": "Fragt" },
        { "value": "leaf", "label": "Blad / Naturlig" },
        { "value": "heart", "label": "Hjerte" },
        { "value": "star", "label": "Stjerne" },
        { "value": "shield", "label": "Garanti" },
        { "value": "recycle", "label": "Bæredygtig" }
      ],
      "default": "leaf"
    },
    {
      "type": "text",
      "id": "usp_4_text",
      "label": "USP 4 tekst",
      "default": "Hurtig levering 1-3 dage"
    },
    {
      "type": "select",
      "id": "usp_4_icon",
      "label": "USP 4 ikon",
      "options": [
        { "value": "shipping", "label": "Fragt" },
        { "value": "leaf", "label": "Blad / Naturlig" },
        { "value": "heart", "label": "Hjerte" },
        { "value": "star", "label": "Stjerne" },
        { "value": "shield", "label": "Garanti" },
        { "value": "recycle", "label": "Bæredygtig" }
      ],
      "default": "star"
    },

    {
      "type": "header",
      "content": "Navigation"
    },
    {
      "type": "link_list",
      "id": "menu_1",
      "label": "Menu 1",
      "default": "footer"
    },
    {
      "type": "text",
      "id": "menu_1_title",
      "label": "Menu 1 overskrift",
      "default": "Shop"
    },
    {
      "type": "link_list",
      "id": "menu_2",
      "label": "Menu 2"
    },
    {
      "type": "text",
      "id": "menu_2_title",
      "label": "Menu 2 overskrift",
      "default": "Kundeservice"
    },
    {
      "type": "link_list",
      "id": "menu_3",
      "label": "Menu 3"
    },
    {
      "type": "text",
      "id": "menu_3_title",
      "label": "Menu 3 overskrift",
      "default": "Om os"
    },

    {
      "type": "header",
      "content": "Nyhedsbrev"
    },
    {
