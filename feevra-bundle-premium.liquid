<style>
/* Premium Feevra Bundle - High Quality Design */
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

:root {
    --primary: #1C1A54;
    --primary-light: #2d2a6e;
    --primary-dark: #13102d;
    --accent: #FF6B9D;
    --success: #00C896;
    --white: #ffffff;
    --off-white: #FAFBFC;
    --gray-50: #F9FAFB;
    --gray-100: #F3F4F6;
    --gray-200: #E5E7EB;
    --gray-300: #D1D5DB;
    --gray-400: #9CA3AF;
    --gray-500: #6B7280;
    --gray-600: #4B5563;
    --gray-700: #374151;
    --gray-800: #1F2937;
    --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
    --shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
    --shadow-md: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
    --shadow-lg: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
    --shadow-xl: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
}

.feevra-premium-bundle {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
    padding: 60px 20px;
    min-height: 100vh;
}

.feevra-premium-container {
    max-width: 1400px;
    margin: 0 auto;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(20px);
    border-radius: 32px;
    padding: 80px 60px;
    box-shadow: var(--shadow-xl);
    border: 1px solid rgba(255, 255, 255, 0.8);
}

@media (max-width: 768px) {
    .feevra-premium-container {
        padding: 40px 24px;
        border-radius: 24px;
    }
    .feevra-premium-bundle {
        padding: 30px 16px;
    }
}

/* Typography */
.feevra-premium-title {
    font-size: 48px;
    font-weight: 700;
    text-align: center;
    margin-bottom: 16px;
    background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    letter-spacing: -0.02em;
}

.feevra-premium-subtitle {
    font-size: 18px;
    font-weight: 400;
    text-align: center;
    color: var(--gray-600);
    margin-bottom: 60px;
    letter-spacing: -0.01em;
}

@media (max-width: 768px) {
    .feevra-premium-title {
        font-size: 32px;
        margin-bottom: 12px;
    }
    .feevra-premium-subtitle {
        font-size: 16px;
        margin-bottom: 40px;
    }
}

/* Steps */
.feevra-premium-step {
    display: none;
    opacity: 0;
    transform: translateY(20px);
}

.feevra-premium-step.active {
    display: block;
    animation: fadeInUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

@keyframes fadeInUp {
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

/* Product Grid */
.feevra-premium-products {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 32px;
    margin-bottom: 48px;
}

@media (max-width: 768px) {
    .feevra-premium-products {
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
    }
}

/* Product Cards */
.feevra-premium-product {
    position: relative;
    cursor: pointer;
    border-radius: 24px;
    overflow: hidden;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    background: white;
    border: 2px solid transparent;
    box-shadow: var(--shadow);
}

.feevra-premium-product::before {
    content: '';
