<script>
(function() {
  'use strict';

  const CONFIG = {
    products: {
      sort: { name: 'Sort', variantId: '49885169189206' },
      rosa: { name: 'Rosa', variantId: '49885169189206' },
      graa: { name: 'Grå', variantId: '50595389866326' },
      blaa: { name: 'Blå', variantId: '49885169189206' }
    },
    prices: { 1: 399, 2: 750, 3: 950 }
  };

  let state = {
    selectedColor: null,
    selectedQuantity: 2,
    colorDistribution: {},
    outOfStockVariants: []
  };

  const els = {
    stepColor: document.getElementById('feevra-step-color'),
    stepQuantity: document.getElementById('feevra-step-quantity'),
    backBtn: document.getElementById('feevra-back-btn'),
    ctaBtn: document.getElementById('feevra-cta-btn'),
    distribution: document.getElementById('feevra-distribution'),
    distributionItems: document.getElementById('feevra-distribution-items')
  };

  function init() {
    document.querySelectorAll('.feevra-premium-product').forEach(card => {
      card.addEventListener('click', handleColorSelect);
    });

    document.querySelectorAll('.feevra-premium-quantity').forEach(card => {
      card.addEventListener('click', handleQuantitySelect);
    });

    els.backBtn.addEventListener('click', goBack);
    els.ctaBtn.addEventListener('click', handleAddToCart);

    checkStock();
  }

  async function checkStock() {
    try {
      state.outOfStockVariants = [];
      updateOutOfStockUI();
    } catch (error) {
      console.error('Stock check error:', error);
    }
  }

  function updateOutOfStockUI() {
    document.querySelectorAll('.feevra-premium-product').forEach(card => {
      const variantId = card.dataset.variant;
      if (state.outOfStockVariants.includes(variantId)) {
        card.classList.add('out-of-stock');
        card.parentElement.appendChild(card);
      }
    });
  }

  function handleColorSelect(e) {
    const card = e.currentTarget;
    const color = card.dataset.color;
    const variantId = card.dataset.variant;

    if (state.outOfStockVariants.includes(variantId)) return;

    document.querySelectorAll('.feevra-premium-product').forEach(c => c.classList.remove('selected'));
    card.classList.add('selected');
    state.selectedColor = color;

    setTimeout(() => {
      els.stepColor.classList.remove('active');
      els.stepQuantity.classList.add('active');
      updateCTA();
      updateDistribution();
    }, 300);
  }

  function handleQuantitySelect(e) {
    const card = e.currentTarget;
    const quantity = parseInt(card.dataset.quantity);

    document.querySelectorAll('.feevra-premium-quantity').forEach(c => c.classList.remove('selected'));
    card.classList.add('selected');
    state.selectedQuantity = quantity;

    updateDistribution();
    updateCTA();
  }

  function updateDistribution() {
    const quantity = state.selectedQuantity;

    if (quantity > 1) {
      els.distribution.classList.remove('hidden');
      els.distributionItems.innerHTML = '';

      for (let i = 1; i <= quantity; i++) {
        const item = document.createElement('div');
        item.className = 'feevra-premium-distribution-item';

        const label = document.createElement('label');
        label.innerHTML = `<span style="font-weight: 600; color: var(--primary);">Produkt ${i}:</span>`;

        const select = document.createElement('select');
        select.dataset.index = i;

        Object.keys(CONFIG.products).forEach(colorKey => {
          const product = CONFIG.products[colorKey];
          if (state.outOfStockVariants.includes(product.variantId)) return;

          const option = document.createElement('option');
          option.value = colorKey;
          option.textContent = product.name;

          if (i === 1 && colorKey === state.selectedColor) {
            option.selected = true;
          }

          select.appendChild(option);
        });

        select.addEventListener('change', (e) => {
          state.colorDistribution[i] = e.target.value;
        });

        if (i === 1) {
          state.colorDistribution[i] = state.selectedColor;
        } else {
          state.colorDistribution[i] = select.value;
        }

        label.appendChild(select);
        item.appendChild(label);
        els.distributionItems.appendChild(item);
      }
    } else {
      els.distribution.classList.add('hidden');
      state.colorDistribution = { 1: state.selectedColor };
    }
  }

  function goBack() {
    els.stepQuantity.classList.remove('active');
    els.stepColor.classList.add('active');
  }

  function updateCTA() {
    const btn = els.ctaBtn;
    if (state.selectedColor) {
      btn.innerHTML = '<span>Tilføj til kurv</span>';
      btn.classList.remove('disabled');
    } else {
      btn.innerHTML = '<span>Vælg venligst farve</span>';
      btn.classList.add('disabled');
    }
  }

  async function handleAddToCart() {
    if (!state.selectedColor) {
      els.ctaBtn.innerHTML = '<span>Vælg venligst farve</span>';
      return;
    }

    const items = [];
    const quantity = state.selectedQuantity;

    if (quantity === 1) {
      const product = CONFIG.products[state.selectedColor];
      items.push({
        id: product.variantId,
        quantity: 1,
        properties: {
          'Bundle': 'Feevra Premium Bundle',
          'Farve': product.name
        }
      });
    } else {
      const colorCounts = {};
      for (let i = 1; i <= quantity; i++) {
        const color = state.colorDistribution[i];
        colorCounts[color] = (colorCounts[color] || 0) + 1;
      }

      Object.entries(colorCounts).forEach(([color, count]) => {
        const product = CONFIG.products[color];
        items.push({
          id: product.variantId,
          quantity: count,
          properties: {
            'Bundle': 'Feevra Premium Bundle',
            'Farve': product.name,
            'Bundle størrelse': `${quantity} stk`
          }
        });
      });
    }

    try {
      els.ctaBtn.innerHTML = '<span>Tilføjer...</span>';
      els.ctaBtn.disabled = true;

      const response = await fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ items })
      });

      if (response.ok) {
        els.ctaBtn.innerHTML = '<span>✓ Tilføjet til kurv!</span>';
        setTimeout(() => {
          window.location.href = '/cart';
        }, 1000);
      } else {
        throw new Error('Failed to add to cart');
      }
    } catch (error) {
      console.error('Cart error:', error);
      els.ctaBtn.innerHTML = '<span>Fejl - prøv igen</span>';
      setTimeout(() => {
        updateCTA();
        els.ctaBtn.disabled = false;
      }, 2000);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }

})();
</script>
