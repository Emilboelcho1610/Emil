{% comment %}
  GLOW PRO FAQ Section
  A beautiful, customizable FAQ section for Shopify
  - Montserrat font for body text
  - Theme font for headlines
  - Fully responsive with separate desktop/mobile settings
{% endcomment %}

{{ 'https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600&display=swap' | stylesheet_tag }}

{% style %}
  .glow-faq-section {
    --faq-bg: {{ section.settings.background_color }};
    --faq-title-color: {{ section.settings.title_color }};
    --faq-subtitle-color: {{ section.settings.subtitle_color }};
    --faq-question-color: {{ section.settings.question_color }};
    --faq-answer-color: {{ section.settings.answer_color }};
    --faq-border-color: {{ section.settings.border_color }};
    --faq-hover-bg: {{ section.settings.hover_background }};
    --faq-icon-color: {{ section.settings.icon_color }};
    --faq-accent-color: {{ section.settings.accent_color }};

    /* Desktop sizes */
    --faq-title-size-desktop: {{ section.settings.title_size_desktop }}px;
    --faq-subtitle-size-desktop: {{ section.settings.subtitle_size_desktop }}px;
    --faq-question-size-desktop: {{ section.settings.question_size_desktop }}px;
    --faq-answer-size-desktop: {{ section.settings.answer_size_desktop }}px;

    /* Mobile sizes */
    --faq-title-size-mobile: {{ section.settings.title_size_mobile }}px;
    --faq-subtitle-size-mobile: {{ section.settings.subtitle_size_mobile }}px;
    --faq-question-size-mobile: {{ section.settings.question_size_mobile }}px;
    --faq-answer-size-mobile: {{ section.settings.answer_size_mobile }}px;

    /* Spacing */
    --faq-section-padding-desktop: {{ section.settings.section_padding_desktop }}px;
    --faq-section-padding-mobile: {{ section.settings.section_padding_mobile }}px;
    --faq-item-gap: {{ section.settings.item_gap }}px;
  }

  .glow-faq-section {
    background-color: var(--faq-bg);
    padding: var(--faq-section-padding-desktop) 0;
    font-family: 'Montserrat', sans-serif;
  }

  .glow-faq-container {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 40px;
  }

  .glow-faq-header {
    text-align: {{ section.settings.header_alignment }};
    margin-bottom: 50px;
  }

  .glow-faq-title {
    font-family: var(--font-heading-family, inherit);
    font-size: var(--faq-title-size-desktop);
    font-weight: {{ section.settings.title_weight }};
    color: var(--faq-title-color);
    margin: 0 0 15px 0;
    letter-spacing: {{ section.settings.title_letter_spacing }}em;
    text-transform: {{ section.settings.title_transform }};
  }

  .glow-faq-subtitle {
    font-family: 'Montserrat', sans-serif;
    font-size: var(--faq-subtitle-size-desktop);
    font-weight: 300;
    color: var(--faq-subtitle-color);
    margin: 0;
    max-width: 600px;
    {% if section.settings.header_alignment == 'center' %}
    margin-left: auto;
    margin-right: auto;
    {% endif %}
    line-height: 1.6;
  }

  .glow-faq-list {
    display: flex;
    flex-direction: column;
    gap: var(--faq-item-gap);
  }

  .glow-faq-item {
    background: {{ section.settings.item_background }};
    border: 1px solid var(--faq-border-color);
    border-radius: {{ section.settings.border_radius }}px;
    overflow: hidden;
    transition: all 0.3s ease;
    {% if section.settings.enable_shadow %}
    box-shadow: 0 2px 8px rgba(0,0,0,0.04);
    {% endif %}
  }

  .glow-faq-item:hover {
    background: var(--faq-hover-bg);
    {% if section.settings.enable_shadow %}
    box-shadow: 0 4px 20px rgba(0,0,0,0.08);
    {% endif %}
  }

  .glow-faq-question {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: {{ section.settings.question_padding_desktop }}px {{ section.settings.question_padding_horizontal_desktop }}px;
    background: transparent;
    border: none;
    cursor: pointer;
    text-align: left;
    font-family: 'Montserrat', sans-serif;
    font-size: var(--faq-question-size-desktop);
    font-weight: {{ section.settings.question_weight }};
    color: var(--faq-question-color);
    line-height: 1.5;
    transition: all 0.3s ease;
  }

  .glow-faq-question:hover {
    color: var(--faq-accent-color);
  }

  .glow-faq-question:focus {
    outline: none;
  }

  .glow-faq-question:focus-visible {
    outline: 2px solid var(--faq-accent-color);
    outline-offset: -2px;
  }

  .glow-faq-icon {
    flex-shrink: 0;
    width: {{ section.settings.icon_size }}px;
    height: {{ section.settings.icon_size }}px;
    margin-left: 20px;
    position: relative;
    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .glow-faq-icon svg {
    width: 100%;
    height: 100%;
    stroke: var(--faq-icon-color);
    stroke-width: 2;
    fill: none;
    transition: stroke 0.3s ease;
  }

  .glow-faq-question:hover .glow-faq-icon svg {
    stroke: var(--faq-accent-color);
  }

  .glow-faq-item[data-open="true"] .glow-faq-icon {
    transform: rotate(180deg);
  }

  .glow-faq-answer {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .glow-faq-item[data-open="true"] .glow-faq-answer {
    max-height: 500px;
  }

  .glow-faq-answer-inner {
    padding: 0 {{ section.settings.question_padding_horizontal_desktop }}px {{ section.settings.answer_padding_desktop }}px;
    font-family: 'Montserrat', sans-serif;
    font-size: var(--faq-answer-size-desktop);
    font-weight: {{ section.settings.answer_weight }};
    color: var(--faq-answer-color);
    line-height: {{ section.settings.answer_line_height }};
  }

  .glow-faq-answer-inner p {
    margin: 0 0 12px 0;
  }

  .glow-faq-answer-inner p:last-child {
    margin-bottom: 0;
  }

  .glow-faq-answer-inner ul {
    margin: 10px 0;
    padding-left: 0;
    list-style: none;
  }

  .glow-faq-answer-inner li {
    position: relative;
    padding-left: 20px;
    margin-bottom: 8px;
  }

  .glow-faq-answer-inner li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 8px;
    width: 6px;
    height: 6px;
    background: var(--faq-accent-color);
    border-radius: 50%;
  }

  .glow-faq-divider {
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--faq-border-color), transparent);
    margin: 0 {{ section.settings.question_padding_horizontal_desktop }}px;
    opacity: 0.5;
  }

  /* Mobile styles */
  @media screen and (max-width: 749px) {
    .glow-faq-section {
      padding: var(--faq-section-padding-mobile) 0;
    }

    .glow-faq-container {
      padding: 0 20px;
    }

    .glow-faq-header {
      margin-bottom: 30px;
    }

    .glow-faq-title {
      font-size: var(--faq-title-size-mobile);
    }

    .glow-faq-subtitle {
      font-size: var(--faq-subtitle-size-mobile);
    }

    .glow-faq-question {
      font-size: var(--faq-question-size-mobile);
      padding: {{ section.settings.question_padding_mobile }}px {{ section.settings.question_padding_horizontal_mobile }}px;
    }

    .glow-faq-answer-inner {
      font-size: var(--faq-answer-size-mobile);
      padding: 0 {{ section.settings.question_padding_horizontal_mobile }}px {{ section.settings.answer_padding_mobile }}px;
    }

    .glow-faq-icon {
      width: {{ section.settings.icon_size_mobile }}px;
      height: {{ section.settings.icon_size_mobile }}px;
      margin-left: 15px;
    }

    .glow-faq-divider {
      margin: 0 {{ section.settings.question_padding_horizontal_mobile }}px;
    }
  }
{% endstyle %}

<section class="glow-faq-section" id="glow-pro-faq">
  <div class="glow-faq-container">
    {% if section.settings.show_header %}
    <header class="glow-faq-header">
      {% if section.settings.title != blank %}
      <h2 class="glow-faq-title">{{ section.settings.title }}</h2>
      {% endif %}
      {% if section.settings.subtitle != blank %}
      <p class="glow-faq-subtitle">{{ section.settings.subtitle }}</p>
      {% endif %}
    </header>
    {% endif %}

    <div class="glow-faq-list">
      {% for block in section.blocks %}
        <div class="glow-faq-item" data-open="false" {{ block.shopify_attributes }}>
          <button class="glow-faq-question" aria-expanded="false" aria-controls="faq-answer-{{ block.id }}">
            <span>{{ block.settings.question }}</span>
            <span class="glow-faq-icon">
              {% if section.settings.icon_style == 'chevron' %}
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
              {% elsif section.settings.icon_style == 'arrow' %}
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <polyline points="19 12 12 19 5 12"></polyline>
              </svg>
              {% else %}
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="12" cy="12" r="10" stroke-width="1.5"></circle>
                <polyline points="8 11 12 15 16 11"></polyline>
              </svg>
              {% endif %}
            </span>
          </button>
          <div class="glow-faq-answer" id="faq-answer-{{ block.id }}" role="region">
            {% if section.settings.show_divider %}
            <div class="glow-faq-divider"></div>
            {% endif %}
            <div class="glow-faq-answer-inner">
              {{ block.settings.answer }}
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const faqItems = document.querySelectorAll('.glow-faq-item');

    faqItems.forEach(item => {
      const question = item.querySelector('.glow-faq-question');

      question.addEventListener('click', function() {
        const isOpen = item.getAttribute('data-open') === 'true';

        {% if section.settings.close_others %}
        // Close all other items
        faqItems.forEach(otherItem => {
          if (otherItem !== item) {
            otherItem.setAttribute('data-open', 'false');
            otherItem.querySelector('.glow-faq-question').setAttribute('aria-expanded', 'false');
          }
        });
        {% endif %}

        // Toggle current item
        item.setAttribute('data-open', !isOpen);
        question.setAttribute('aria-expanded', !isOpen);
      });
    });

    // Open first item by default if setting is enabled
    {% if section.settings.open_first %}
    if (faqItems.length > 0) {
      faqItems[0].setAttribute('data-open', 'true');
      faqItems[0].querySelector('.glow-faq-question').setAttribute('aria-expanded', 'true');
    }
    {% endif %}
  });
</script>

