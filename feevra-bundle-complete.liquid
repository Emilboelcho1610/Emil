        name: 'Blå',
        variantId: '49885169254742', // PLACEHOLDER - Update with correct Shopify variant ID
        image: 'https://cdn.shopify.com/s/files/1/0871/4570/9910/files/feevra-migraenemasken.jpg_3_021793b9-d91c-4e66-8277-77242e0f482e.jpg?v=1768917230'
      }
    },
    prices: {
      1: { price: 399, savings: 196, savingsPercent: 33, perItem: 399, originalPrice: 595 },
      2: { price: 750, savings: 440, savingsPercent: 37, perItem: 375, originalPrice: 1190 },
      3: { price: 950, savings: 835, savingsPercent: 47, perItem: 316, originalPrice: 1785 }
    }
  };

  // State
  const state = {
    selectedColor: null,
    selectedQuantity: 2,
    distribution: {},
    soldOutVariants: []
  };

  // DOM Elements
  const els = {
    stepColor: document.getElementById('feevra-step-color'),
    stepQuantity: document.getElementById('feevra-step-quantity'),
    backBtn: document.getElementById('feevra-back-btn'),
    ctaBtn: document.getElementById('feevra-cta-btn'),
    distribution: document.getElementById('feevra-distribution'),
    distributionItems: document.getElementById('feevra-distribution-items'),
    toast: document.getElementById('feevra-toast')
  };

  // Initialize
  function init() {
    // Event delegation for color cards
    els.stepColor.addEventListener('click', handleColorClick);

    // Event delegation for quantity cards
    els.stepQuantity.addEventListener('click', handleQuantityClick);

    // Back button
    els.backBtn.addEventListener('click', goBack);

    // CTA button
    els.ctaBtn.addEventListener('click', handleAddToCart);

    // Check stock availability
    checkStockAvailability();
  }

  // Check stock availability (placeholder - integrate with Shopify if needed)
  async function checkStockAvailability() {
    try {
      // In a real implementation, you would fetch variant availability here
      // For now, we'll use an empty array (all in stock)
      state.soldOutVariants = [];

      // Update UI to mark sold out items
      updateSoldOutUI();
    } catch (error) {
      console.error('Stock check error:', error);
    }
  }

  // Update sold out UI
  function updateSoldOutUI() {
    const colorCards = document.querySelectorAll('.feevra-color-card');
    const inStock = [];
    const soldOut = [];

    colorCards.forEach(card => {
      const variantId = card.dataset.variantId;
      if (state.soldOutVariants.includes(variantId)) {
        card.classList.add('sold-out');
        card.setAttribute('aria-disabled', 'true');
        soldOut.push(card);
      } else {
        inStock.push(card);
      }
    });

    // Re-order: in-stock first, sold-out last
    const parent = colorCards[0].parentElement;
    inStock.forEach(card => parent.appendChild(card));
    soldOut.forEach(card => parent.appendChild(card));
  }

  // Handle color card click
  function handleColorClick(e) {
    const card = e.target.closest('.feevra-color-card');
    if (!card) return;

    const color = card.dataset.color;
    const variantId = card.dataset.variantId;

    // Check if sold out
    if (state.soldOutVariants.includes(variantId)) {
      showToast('Udsolgt', 'error');
      return;
    }

    // Update selection
    const allCards = document.querySelectorAll('.feevra-color-card');
    allCards.forEach(c => c.setAttribute('aria-pressed', 'false'));
    card.setAttribute('aria-pressed', 'true');

    state.selectedColor = color;

    // Move to step 2
    setTimeout(() => {
      els.stepColor.classList.remove('active');
      els.stepQuantity.classList.add('active');
      updateCTA();
      updateDistribution();
    }, 200);
  }

  // Handle quantity card click
  function handleQuantityClick(e) {
    const card = e.target.closest('.feevra-qty-card');
    if (!card) return;

    const quantity = parseInt(card.dataset.quantity);

    // Update selection
    const allCards = document.querySelectorAll('.feevra-qty-card');
    allCards.forEach(c => c.setAttribute('aria-pressed', 'false'));
    card.setAttribute('aria-pressed', 'true');

    state.selectedQuantity = quantity;

    updateDistribution();
    updateCTA();
  }

  // Update distribution UI
  function updateDistribution() {
    const qty = state.selectedQuantity;

    if (qty > 1) {
      els.distribution.classList.remove('hidden');
      els.distributionItems.innerHTML = '';

      for (let i = 1; i <= qty; i++) {
        const item = document.createElement('div');
        item.className = 'feevra-distribution-item';

        const label = document.createElement('label');
        label.className = 'feevra-distribution-label';
        label.setAttribute('for', `feevra-dist-${i}`);
        label.textContent = `Maske ${i}:`;

        const select = document.createElement('select');
        select.className = 'feevra-distribution-select';
        select.id = `feevra-dist-${i}`;
        select.dataset.index = i;

        // Add color options
        Object.keys(CONFIG.products).forEach(colorKey => {
          const product = CONFIG.products[colorKey];

          // Skip sold out variants
          if (state.soldOutVariants.includes(product.variantId)) return;

          const option = document.createElement('option');
          option.value = colorKey;
          option.textContent = product.name;

          // Pre-select the first one as selected color
          if (i === 1 && colorKey === state.selectedColor) {
            option.selected = true;
          }

          select.appendChild(option);
        });

        // Event listener
        select.addEventListener('change', (e) => {
          state.distribution[i] = e.target.value;
        });

        // Set initial state
        if (i === 1) {
          state.distribution[i] = state.selectedColor;
        } else {
          state.distribution[i] = state.distribution[i] || select.value;
        }

        item.appendChild(label);
        item.appendChild(select);
        els.distributionItems.appendChild(item);
      }
    } else {
      els.distribution.classList.add('hidden');
      state.distribution = { 1: state.selectedColor };
    }
  }

  // Go back to color selection
  function goBack() {
    els.stepQuantity.classList.remove('active');
    els.stepColor.classList.add('active');
  }

  // Update CTA button
  function updateCTA() {
    if (state.selectedColor) {
      els.ctaBtn.textContent = 'Tilføj til kurv';
      els.ctaBtn.disabled = false;
    } else {
      els.ctaBtn.textContent = 'Vælg venligst farve';
      els.ctaBtn.disabled = true;
    }
  }

  // Handle add to cart
  async function handleAddToCart() {
    if (!state.selectedColor) {
      els.ctaBtn.textContent = 'Vælg venligst farve';
      return;
    }

    // Build cart items
    const items = [];
    const qty = state.selectedQuantity;

    if (qty === 1) {
      const product = CONFIG.products[state.selectedColor];
      items.push({
        id: product.variantId,
        quantity: 1,
        properties: {
          'Bundle': 'Feevra Bundle',
          'Farve': product.name
        }
      });
    } else {
      // Count color occurrences
      const colorCounts = {};
      for (let i = 1; i <= qty; i++) {
        const color = state.distribution[i];
        colorCounts[color] = (colorCounts[color] || 0) + 1;
      }

      // Create line items
      Object.entries(colorCounts).forEach(([color, count]) => {
        const product = CONFIG.products[color];
        items.push({
          id: product.variantId,
          quantity: count,
          properties: {
            'Bundle': 'Feevra Bundle',
            'Farve': product.name,
            'Bundle størrelse': `${qty} stk`
          }
        });
      });
    }

    // Add to cart via Shopify AJAX
    try {
      els.ctaBtn.classList.add('loading');
      els.ctaBtn.disabled = true;

      const response = await fetch('/cart/add.js', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({ items })
      });

      if (!response.ok) {
        // Handle 422 (sold out)
        if (response.status === 422) {
          const data = await response.json();
          showToast('Produktet er udsolgt', 'error');

          // Update sold out state
          items.forEach(item => {
            if (!state.soldOutVariants.includes(item.id)) {
              state.soldOutVariants.push(item.id);
            }
          });
          updateSoldOutUI();
          return;
        }

        throw new Error('Failed to add to cart');
      }

      // Success
      showToast('Tilføjet til kurv', 'success');

      // Dispatch custom event for theme cart drawer
      document.dispatchEvent(new CustomEvent('feevra:cart:updated', {
        detail: { items }
      }));

      // Optionally redirect to cart or trigger cart drawer
      setTimeout(() => {
        // Uncomment to redirect to cart:
        // window.location.href = '/cart';
      }, 1500);

    } catch (error) {
      console.error('Cart error:', error);
      showToast('Fejl - prøv igen', 'error');
    } finally {
      els.ctaBtn.classList.remove('loading');
      els.ctaBtn.disabled = false;
    }
  }

  // Show toast notification
  function showToast(message, type = 'info') {
    els.toast.textContent = message;
    els.toast.className = `feevra-toast ${type}`;

    // Show
    setTimeout(() => els.toast.classList.add('show'), 10);

    // Hide after 2.5s
    setTimeout(() => {
      els.toast.classList.remove('show');
    }, 2500);
  }

  // Initialize on DOM ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }

})();
</script>
