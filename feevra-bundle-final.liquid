        <div class="feevra-trust-item">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
          <span>30 dages returret</span>
        </div>
        <div class="feevra-trust-item">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
          <span>Premium kvalitet</span>
        </div>
      </div>
    </div>

  </div>
</div>

<script>
(function() {
  'use strict';

  const CONFIG = {
    products: {
      sort: { name: 'Sort', variantId: '49885169189206' },
      rosa: { name: 'Rosa', variantId: '49885169221974' },
      graa: { name: 'Grå', variantId: '50595389866326' },
      blaa: { name: 'Blå', variantId: '49885169254742' }
    }
  };

  let state = {
    selectedColor: null,
    selectedQuantity: 2,
    colorDistribution: {},
    outOfStockVariants: []
  };

  const els = {
    stepColor: document.getElementById('step-color'),
    stepQuantity: document.getElementById('step-quantity'),
    backBtn: document.getElementById('back-btn'),
    ctaBtn: document.getElementById('cta-btn'),
    distribution: document.getElementById('distribution'),
    distributionItems: document.getElementById('distribution-items')
  };

  function init() {
    document.querySelectorAll('.feevra-product').forEach(card => {
      card.addEventListener('click', handleColorSelect);
    });

    document.querySelectorAll('.feevra-quantity').forEach(card => {
      card.addEventListener('click', handleQuantitySelect);
    });

    els.backBtn.addEventListener('click', goBack);
    els.ctaBtn.addEventListener('click', handleAddToCart);

    checkStock();
  }

  async function checkStock() {
    try {
      state.outOfStockVariants = [];
      updateOutOfStockUI();
    } catch (error) {
      console.error('Stock error:', error);
    }
  }

  function updateOutOfStockUI() {
    document.querySelectorAll('.feevra-product').forEach(card => {
      const variantId = card.dataset.variant;
      if (state.outOfStockVariants.includes(variantId)) {
        card.classList.add('out-of-stock');
        card.parentElement.appendChild(card);
      }
    });
  }

  function handleColorSelect(e) {
    const card = e.currentTarget;
    const color = card.dataset.color;
    const variantId = card.dataset.variant;

    if (state.outOfStockVariants.includes(variantId)) return;

    document.querySelectorAll('.feevra-product').forEach(c => c.classList.remove('selected'));
    card.classList.add('selected');
    state.selectedColor = color;

    setTimeout(() => {
      els.stepColor.classList.remove('active');
      els.stepQuantity.classList.add('active');
      updateCTA();
      updateDistribution();
    }, 200);
  }

  function handleQuantitySelect(e) {
    const card = e.currentTarget;
    const quantity = parseInt(card.dataset.quantity);

    document.querySelectorAll('.feevra-quantity').forEach(c => c.classList.remove('selected'));
    card.classList.add('selected');
    state.selectedQuantity = quantity;

    updateDistribution();
    updateCTA();
  }

  function updateDistribution() {
    const quantity = state.selectedQuantity;

    if (quantity > 1) {
      els.distribution.classList.remove('hidden');
      els.distributionItems.innerHTML = '';

      for (let i = 1; i <= quantity; i++) {
        const item = document.createElement('div');
        item.className = 'feevra-distribution-item';

        const label = document.createElement('label');
        label.innerHTML = `<span style="font-weight: 600; color: var(--primary);">Produkt ${i}:</span>`;

        const select = document.createElement('select');
        select.dataset.index = i;

        Object.keys(CONFIG.products).forEach(colorKey => {
          const product = CONFIG.products[colorKey];
          if (state.outOfStockVariants.includes(product.variantId)) return;

          const option = document.createElement('option');
          option.value = colorKey;
          option.textContent = product.name;

          if (i === 1 && colorKey === state.selectedColor) {
            option.selected = true;
          }

          select.appendChild(option);
        });

        select.addEventListener('change', (e) => {
          state.colorDistribution[i] = e.target.value;
        });

        if (i === 1) {
          state.colorDistribution[i] = state.selectedColor;
        } else {
          state.colorDistribution[i] = select.value;
        }

        label.appendChild(select);
        item.appendChild(label);
        els.distributionItems.appendChild(item);
      }
    } else {
      els.distribution.classList.add('hidden');
      state.colorDistribution = { 1: state.selectedColor };
    }
  }

  function goBack() {
    els.stepQuantity.classList.remove('active');
    els.stepColor.classList.add('active');
  }

  function updateCTA() {
    if (state.selectedColor) {
      els.ctaBtn.textContent = 'Tilføj til kurv';
      els.ctaBtn.classList.remove('disabled');
    } else {
      els.ctaBtn.textContent = 'Vælg venligst farve';
      els.ctaBtn.classList.add('disabled');
    }
  }

  async function handleAddToCart() {
    if (!state.selectedColor) {
      els.ctaBtn.textContent = 'Vælg venligst farve';
      return;
    }

    const items = [];
    const quantity = state.selectedQuantity;

    if (quantity === 1) {
      const product = CONFIG.products[state.selectedColor];
      items.push({
        id: product.variantId,
        quantity: 1,
        properties: {
          'Bundle': 'Feevra Bundle',
          'Farve': product.name
        }
      });
    } else {
      const colorCounts = {};
      for (let i = 1; i <= quantity; i++) {
        const color = state.colorDistribution[i];
        colorCounts[color] = (colorCounts[color] || 0) + 1;
      }

      Object.entries(colorCounts).forEach(([color, count]) => {
        const product = CONFIG.products[color];
        items.push({
          id: product.variantId,
          quantity: count,
          properties: {
            'Bundle': 'Feevra Bundle',
            'Farve': product.name,
            'Bundle størrelse': `${quantity} stk`
          }
        });
      });
    }

    try {
      els.ctaBtn.textContent = 'Tilføjer...';
      els.ctaBtn.disabled = true;

      const response = await fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ items })
      });

      if (response.ok) {
        els.ctaBtn.textContent = '✓ Tilføjet!';
        setTimeout(() => {
          window.location.href = '/cart';
        }, 1000);
      } else {
        throw new Error('Failed');
      }
    } catch (error) {
      console.error('Error:', error);
      els.ctaBtn.textContent = 'Fejl - prøv igen';
      setTimeout(() => {
        updateCTA();
        els.ctaBtn.disabled = false;
      }, 2000);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }

})();
</script>
