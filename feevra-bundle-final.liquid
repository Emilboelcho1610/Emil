    <!-- Step 2: Quantity -->
    <div id="step-quantity" class="feevra-step">
      <button class="feevra-back" id="back-btn">← Gå tilbage</button>

      <h1 class="feevra-title">Vælg dit bundle</h1>
      <p class="feevra-subtitle">Spar mere når du køber flere</p>

      <div class="feevra-quantities">
