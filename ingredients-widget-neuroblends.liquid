  // Render content for each variant
  function renderIngredients(variant) {
    var lang = isEnglish ? 'en' : 'de';
    var variantData = data[variant][lang];
    return '<p class="nutri-text-nb">' + variantData.ingredients + '</p>';
  }

  function renderAbout(variant) {
    var lang = isEnglish ? 'en' : 'de';
    var variantData = data[variant][lang];
    var html = '<p class="nutri-text-nb">' + variantData.about + '</p>';
    if (variantData.caffeineNote) {
      html += '<div class="nutri-notice-nb">' + variantData.caffeineNote + '</div>';
    }
    return html;
  }

  function renderActive(variant) {
    var lang = isEnglish ? 'en' : 'de';
    var variantData = data[variant][lang];
    var per250Label = isEnglish ? 'per can (250 ml)' : 'pro Dose (250 ml)';

    var html = '<p class="nutri-subsection-title-nb">' + per250Label + '</p>';
    html += '<table class="nutri-table-nb"><tbody>';
    variantData.activeIngredients.forEach(function(item) {
      var rowClass = item.highlight ? 'nutri-row-nb highlight' : 'nutri-row-nb';
      html += '<tr class="' + rowClass + '">';
      html += '<td class="nutri-cell-nb"><span class="n-label-nb">' + item.name + '</span></td>';
      html += '<td class="nutri-cell-nb"><span class="n-val-nb">' + item.amount + '</span></td>';
      html += '</tr>';
    });
    html += '</tbody></table>';
    return html;
  }

  function renderNutrition(variant) {
    var lang = isEnglish ? 'en' : 'de';
    var variantData = data[variant][lang];
    var per100Label = isEnglish ? 'per 100 ml' : 'pro 100 ml';
    var per250Label = isEnglish ? 'per can (250 ml)' : 'pro Dose (250 ml)';

    var html = '<p class="nutri-subsection-title-nb">' + per100Label + '</p>';
    html += '<table class="nutri-table-nb"><tbody>';
    variantData.nutritionPer100.forEach(function(item) {
      html += '<tr class="nutri-row-nb">';
      html += '<td class="nutri-cell-nb"><span class="n-label-nb">' + item.label + '</span></td>';
      html += '<td class="nutri-cell-nb"><span class="n-val-nb">' + item.value + '</span></td>';
      html += '</tr>';
    });
    html += '</tbody></table>';

    html += '<p class="nutri-subsection-title-nb">' + per250Label + '</p>';
    html += '<table class="nutri-table-nb"><tbody>';
    variantData.nutritionPer250.forEach(function(item) {
      html += '<tr class="nutri-row-nb">';
      html += '<td class="nutri-cell-nb"><span class="n-label-nb">' + item.label + '</span></td>';
      html += '<td class="nutri-cell-nb"><span class="n-val-nb">' + item.value + '</span></td>';
      html += '</tr>';
    });
    html += '</tbody></table>';
    return html;
  }

  // Populate all content on page load
  ['vibe', 'sharp', 'relax'].forEach(function(variant) {
    document.getElementById('nutri-ingredients-' + variant).innerHTML = renderIngredients(variant);
    document.getElementById('nutri-about-' + variant).innerHTML = renderAbout(variant);
    document.getElementById('nutri-active-' + variant).innerHTML = renderActive(variant);
    document.getElementById('nutri-nutrition-' + variant).innerHTML = renderNutrition(variant);
  });

  // Set initial theme (VIBE is default)
  updateTheme('vibe');

  // Variant selector
  var select = document.getElementById('nutri-variant-select-nb');
  var contents = document.querySelectorAll('.nutri-content-nb');
  var mainTitle = document.getElementById('nutri-main-title-nb');

  select.addEventListener('change', function() {
    var variant = this.value;

    // Update active content
    contents.forEach(function(c) {
      c.classList.remove('active');
    });
    document.getElementById('nutri-' + variant + '-nb').classList.add('active');

    // Update main title
    mainTitle.textContent = variant.toUpperCase();

    // Update theme colors
    updateTheme(variant);
  });
})();
</script>
