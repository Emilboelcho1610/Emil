    html += '<h3 class="nutri-section-title">' + aboutLabel + '</h3>';
    html += '<p class="nutri-text">' + variantData.about + '</p>';
    if (variantData.caffeineNote) {
      html += '<div class="nutri-notice">' + variantData.caffeineNote + '</div>';
    }
    html += '</div>';

