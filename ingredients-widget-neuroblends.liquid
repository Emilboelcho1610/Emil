<style>
/* === Container === */
.nutri-widget-container {
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  max-width: 900px;
  margin: 0 auto;
  padding: 0;
  box-sizing: border-box;
}
.nutri-widget-container *,
.nutri-widget-container *::before,
.nutri-widget-container *::after {
  box-sizing: border-box;
}

/* === CSS Variables for Dynamic Theming === */
:root {
  --nutri-brand: #e68917;
  --nutri-soft: rgba(230,137,23,0.10);
  --nutri-panel: #FFF3E0;
  --nutri-ink: #0C141B;
  --nutri-muted: rgba(12,20,27,0.62);
  --nutri-border: rgba(12,20,27,0.14);
}

/* === Tabs === */
.nutri-variant-tabs {
  display: flex;
  gap: 12px;
  margin-bottom: 24px;
  flex-wrap: wrap;
}
.nutri-variant-tab {
  background-color: #fff;
  border: 2px solid var(--nutri-border);
  border-radius: 12px;
  padding: 12px 24px;
  font-size: 16px;
  font-weight: 600;
  color: var(--nutri-ink);
  cursor: pointer;
  transition: all 0.2s ease;
  flex: 1;
  min-width: 120px;
  text-align: center;
}
.nutri-variant-tab:hover {
  border-color: var(--nutri-brand);
  background-color: var(--nutri-soft);
}
.nutri-variant-tab.active {
  background-color: var(--nutri-brand);
  border-color: var(--nutri-brand);
  color: #fff;
}

/* === Content Area === */
.nutri-content-area {
  display: none;
}
.nutri-content-area.active {
  display: block;
  animation: fadeInNutri 0.3s ease;
}

@keyframes fadeInNutri {
  from {
    opacity: 0;
    transform: translateY(10px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* === Section === */
.nutri-section {
  background: #fff;
  border: 1px solid var(--nutri-border);
  border-radius: 16px;
  padding: 24px;
  margin-bottom: 20px;
}
.nutri-section-title {
  font-size: 18px;
  font-weight: 700;
  color: var(--nutri-ink);
  margin: 0 0 16px 0;
  display: flex;
  align-items: center;
  gap: 10px;
}

/* === Badges === */
.nutri-badge-small {
  display: inline-block;
  background: var(--nutri-brand);
  color: #fff;
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  padding: 4px 10px;
  border-radius: 6px;
}

/* === Text === */
.nutri-text {
  font-size: 15px;
  line-height: 1.6;
  color: var(--nutri-ink);
  margin: 0 0 12px 0;
}
.nutri-text:last-child {
  margin-bottom: 0;
}
.nutri-text strong {
  font-weight: 600;
}

/* === Notice === */
.nutri-notice {
  background: var(--nutri-panel);
  border-left: 4px solid var(--nutri-brand);
  padding: 16px;
  border-radius: 8px;
  font-size: 14px;
  line-height: 1.5;
  color: var(--nutri-ink);
  margin-top: 16px;
}

/* === Table === */
.nutri-table {
  width: 100%;
  border-collapse: collapse;
}
.nutri-row {
  border-bottom: 1px solid var(--nutri-border);
  transition: background-color 0.2s ease;
}
.nutri-row:last-child {
  border-bottom: none;
}
.nutri-row.highlight {
  background-color: var(--nutri-panel);
}
.nutri-row.highlight .n-label,
.nutri-row.highlight .n-val {
  color: var(--nutri-brand);
  font-weight: 600;
}
.nutri-cell {
  padding: 14px 8px;
  text-align: left;
  vertical-align: middle;
}
.nutri-cell:last-child {
  text-align: right;
}
.n-label {
  font-size: 15px;
  color: var(--nutri-ink);
  font-weight: 500;
}
.n-val {
  font-size: 15px;
  color: var(--nutri-ink);
  font-weight: 600;
}

/* === Mobile === */
@media (max-width: 600px) {
  .nutri-widget-container {
    padding: 0;
  }
  .nutri-variant-tabs {
    gap: 8px;
  }
  .nutri-variant-tab {
    padding: 10px 16px;
    font-size: 14px;
    min-width: 100px;
  }
  .nutri-section {
    padding: 20px;
    border-radius: 12px;
  }
  .nutri-section-title {
    font-size: 16px;
  }
  .nutri-text {
    font-size: 14px;
  }
  .nutri-notice {
    font-size: 13px;
    padding: 14px;
  }
  .n-label,
  .n-val {
    font-size: 14px;
  }
  .nutri-cell {
    padding: 12px 6px;
  }
}
</style>

