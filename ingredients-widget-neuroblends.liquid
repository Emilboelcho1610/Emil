<style>
/* === Container === */
.nutri-widget-nb {
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  max-width: 900px;
  margin: 0 auto;
  padding: 0;
  box-sizing: border-box;
}
.nutri-widget-nb *,
.nutri-widget-nb *::before,
.nutri-widget-nb *::after {
  box-sizing: border-box;
}

/* === CSS Variables for Dynamic Theming === */
:root {
  --nutri-brand-nb: #e68917;
  --nutri-soft-nb: rgba(230,137,23,0.10);
  --nutri-panel-nb: #FFF3E0;
  --nutri-ink-nb: #0C141B;
  --nutri-muted-nb: rgba(12,20,27,0.62);
  --nutri-border-nb: rgba(12,20,27,0.14);
}

/* === Main Dropdown === */
.nutri-main-dropdown-nb {
  border: 1px solid var(--nutri-border-nb);
  border-radius: 16px;
  background: #fff;
  overflow: hidden;
}

.nutri-main-dropdown-nb summary {
  padding: 18px 20px;
  cursor: pointer;
  list-style: none;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-weight: 700;
  font-size: 16px;
  color: var(--nutri-ink-nb);
  background: var(--nutri-brand-nb);
  color: #fff;
  transition: background-color 0.2s ease;
}

.nutri-main-dropdown-nb summary::-webkit-details-marker {
  display: none;
}

.nutri-main-dropdown-nb summary:hover {
  opacity: 0.9;
}

.nutri-main-header-nb {
  display: flex;
  align-items: center;
  gap: 12px;
}

.nutri-main-chevron-nb {
  width: 16px;
  height: 16px;
  transition: transform 0.2s ease;
  stroke: #fff;
  flex-shrink: 0;
}

.nutri-main-dropdown-nb[open] .nutri-main-chevron-nb {
  transform: rotate(180deg);
}

/* === Variant Selector Inside === */
.nutri-variant-selector-nb {
  padding: 16px 20px;
  border-bottom: 1px solid var(--nutri-border-nb);
  background: var(--nutri-panel-nb);
}

.nutri-variant-select-nb {
  width: 100%;
  padding: 12px 16px;
  font-size: 15px;
  font-weight: 600;
  color: var(--nutri-ink-nb);
  background-color: #fff;
  border: 2px solid var(--nutri-border-nb);
  border-radius: 10px;
  cursor: pointer;
  transition: all 0.2s ease;
  appearance: none;
  background-image: url("data:image/svg+xml,%3Csvg width='14' height='8' viewBox='0 0 14 8' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 1L7 7L13 1' stroke='%230C141B' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E");
  background-repeat: no-repeat;
  background-position: right 16px center;
  padding-right: 48px;
}

.nutri-variant-select-nb:hover {
  border-color: var(--nutri-brand-nb);
}

.nutri-variant-select-nb:focus {
  outline: none;
  border-color: var(--nutri-brand-nb);
  box-shadow: 0 0 0 3px var(--nutri-soft-nb);
}

/* === Content Areas === */
.nutri-content-nb {
  display: none;
}

.nutri-content-nb.active {
  display: block;
  animation: fadeInNutri 0.3s ease;
}

@keyframes fadeInNutri {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

/* === Collapsible Sections === */
.nutri-section-nb {
  border-bottom: 1px solid var(--nutri-border-nb);
}

.nutri-section-nb:last-child {
  border-bottom: none;
}

.nutri-section-nb summary {
  padding: 18px 20px;
  cursor: pointer;
  list-style: none;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-weight: 700;
  font-size: 15px;
  color: var(--nutri-ink-nb);
  text-transform: uppercase;
  letter-spacing: 0.3px;
  transition: background-color 0.2s ease;
}

.nutri-section-nb summary::-webkit-details-marker {
  display: none;
}

.nutri-section-nb summary:hover {
  background-color: var(--nutri-soft-nb);
}

.nutri-section-nb[open] summary {
  background-color: var(--nutri-panel-nb);
  border-bottom: 1px solid var(--nutri-border-nb);
}

.nutri-section-header-nb {
  display: flex;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
}

.nutri-section-badges-nb {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}

.nutri-badge-nb {
  display: inline-block;
  background: var(--nutri-panel-nb);
  color: var(--nutri-brand-nb);
  font-size: 11px;
  font-weight: 700;
  text-transform: none;
  letter-spacing: 0.3px;
  padding: 5px 10px;
  border-radius: 6px;
  border: 1px solid var(--nutri-brand-nb);
}

.nutri-chevron-nb {
  width: 14px;
  height: 14px;
  transition: transform 0.2s ease;
  stroke: var(--nutri-ink-nb);
  flex-shrink: 0;
}

.nutri-section-nb[open] .nutri-chevron-nb {
  transform: rotate(180deg);
}

/* === Section Content === */
.nutri-section-content-nb {
  padding: 20px;
}

/* === Text === */
.nutri-text-nb {
  font-size: 15px;
  line-height: 1.6;
  color: var(--nutri-ink-nb);
  margin: 0 0 12px 0;
}

.nutri-text-nb:last-child {
  margin-bottom: 0;
}

.nutri-text-nb strong {
  font-weight: 600;
}

/* === Notice === */
.nutri-notice-nb {
  background: var(--nutri-panel-nb);
  border-left: 4px solid var(--nutri-brand-nb);
  padding: 14px;
  border-radius: 8px;
  font-size: 14px;
  line-height: 1.5;
  color: var(--nutri-ink-nb);
  margin-top: 12px;
}

/* === Table === */
.nutri-table-nb {
  width: 100%;
  border-collapse: collapse;
  margin-top: 16px;
}

.nutri-table-nb:first-child {
  margin-top: 0;
}

.nutri-row-nb {
  border-bottom: 1px solid var(--nutri-border-nb);
  transition: background-color 0.2s ease;
}

.nutri-row-nb:last-child {
  border-bottom: none;
}

.nutri-row-nb.highlight {
  background-color: var(--nutri-panel-nb);
}

.nutri-row-nb.highlight .n-label-nb,
.nutri-row-nb.highlight .n-val-nb {
  color: var(--nutri-brand-nb);
  font-weight: 600;
}

.nutri-cell-nb {
  padding: 12px 8px;
  text-align: left;
  vertical-align: middle;
}

.nutri-cell-nb:last-child {
  text-align: right;
}

.n-label-nb {
  font-size: 14px;
  color: var(--nutri-ink-nb);
  font-weight: 500;
}

.n-val-nb {
  font-size: 14px;
  color: var(--nutri-ink-nb);
  font-weight: 600;
}

/* === Subsection Headers === */
.nutri-subsection-title-nb {
  font-size: 13px;
  font-weight: 700;
  color: var(--nutri-ink-nb);
  text-transform: uppercase;
  letter-spacing: 0.5px;
  margin: 20px 0 12px 0;
}

.nutri-subsection-title-nb:first-child {
  margin-top: 0;
}

/* === Mobile === */
@media (max-width: 600px) {
  .nutri-widget-nb {
    padding: 0;
  }

  .nutri-main-dropdown-nb summary {
    padding: 16px;
    font-size: 15px;
  }

  .nutri-main-chevron-nb {
    width: 14px;
    height: 14px;
  }

  .nutri-variant-selector-nb {
    padding: 14px 16px;
  }

  .nutri-variant-select-nb {
    padding: 10px 14px;
    font-size: 14px;
    background-position: right 14px center;
    padding-right: 44px;
  }

  .nutri-section-nb summary {
    padding: 16px;
    font-size: 14px;
  }

  .nutri-section-header-nb {
    gap: 10px;
  }

  .nutri-section-badges-nb {
    gap: 6px;
  }

  .nutri-badge-nb {
    font-size: 10px;
    padding: 4px 8px;
  }

  .nutri-section-content-nb {
    padding: 16px;
  }

  .nutri-text-nb {
    font-size: 14px;
  }

  .nutri-notice-nb {
    font-size: 13px;
    padding: 12px;
  }

  .n-label-nb,
  .n-val-nb {
    font-size: 13px;
  }

  .nutri-cell-nb {
    padding: 10px 6px;
  }

  .nutri-subsection-title-nb {
    font-size: 12px;
    margin: 16px 0 10px 0;
  }
}
</style>

