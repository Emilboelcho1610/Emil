{% comment %}
  FAQ - Glow Pro Beauty Edition
  Modern, elegant FAQ for beauty products
{% endcomment %}

<style>
  .glow-faq-section {
    /* Colors */
    --glow-bg: {{ section.settings.bg_color }};
    --glow-card-bg: {{ section.settings.card_bg }};
    --glow-card-hover-bg: {{ section.settings.card_hover_bg }};
    --glow-card-active-bg: {{ section.settings.card_active_bg }};
    --glow-text: {{ section.settings.text_color }};
    --glow-question-color: {{ section.settings.question_color }};
    --glow-answer-color: {{ section.settings.answer_color }};
    --glow-accent: {{ section.settings.accent_color }};
    --glow-border: {{ section.settings.border_color }};
    --glow-border-active: {{ section.settings.border_active_color }};

    /* Desktop font sizes */
    --glow-title-size: {{ section.settings.title_size_desktop }}px;
    --glow-subtitle-size: {{ section.settings.subtitle_size_desktop }}px;
    --glow-question-size: {{ section.settings.question_size_desktop }}px;
    --glow-answer-size: {{ section.settings.answer_size_desktop }}px;

    /* Spacing */
    --glow-section-py: {{ section.settings.section_padding_y_desktop }}px;
    --glow-section-px: {{ section.settings.section_padding_x_desktop }}px;
    --glow-card-gap: {{ section.settings.card_gap }}px;
    --glow-card-radius: {{ section.settings.card_radius }}px;

    background-color: var(--glow-bg);
    padding: var(--glow-section-py) var(--glow-section-px);
    font-family: 'Montserrat', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  }

  .glow-faq-container {
    max-width: {{ section.settings.container_width }}px;
    margin: 0 auto;
  }

  .glow-faq-header {
    text-align: {{ section.settings.header_alignment }};
    margin-bottom: {{ section.settings.header_margin_bottom }}px;
  }

  .glow-faq-title {
    font-size: var(--glow-title-size);
    font-weight: {{ section.settings.title_weight }};
    color: var(--glow-text);
    margin: 0 0 {{ section.settings.title_spacing }}px 0;
    line-height: {{ section.settings.title_line_height }};
    letter-spacing: {{ section.settings.title_letter_spacing }}px;
  }

  .glow-faq-subtitle {
    font-size: var(--glow-subtitle-size);
    color: {{ section.settings.subtitle_color }};
    font-weight: {{ section.settings.subtitle_weight }};
    line-height: {{ section.settings.subtitle_line_height }};
    letter-spacing: {{ section.settings.subtitle_letter_spacing }}px;
    margin: 0;
  }

  .glow-faq-list {
    display: flex;
    flex-direction: column;
    gap: var(--glow-card-gap);
  }

  .glow-faq-item {
    background: var(--glow-card-bg);
    border: {{ section.settings.border_width }}px solid var(--glow-border);
    border-radius: var(--glow-card-radius);
    overflow: hidden;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    cursor: pointer;
  }

  .glow-faq-item:hover {
    background: var(--glow-card-hover-bg);
    border-color: var(--glow-accent);
    transform: translateY(-2px);
    box-shadow: {{ section.settings.hover_shadow }};
  }

  .glow-faq-item.active {
    background: var(--glow-card-active-bg);
    border-color: var(--glow-border-active);
    box-shadow: {{ section.settings.active_shadow }};
  }

  .glow-faq-question {
    padding: {{ section.settings.question_padding_y_desktop }}px {{ section.settings.question_padding_x_desktop }}px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
  }

  .glow-faq-question-text {
    font-size: var(--glow-question-size);
    font-weight: {{ section.settings.question_weight }};
    color: var(--glow-question-color);
    line-height: {{ section.settings.question_line_height }};
    margin: 0;
    flex: 1;
  }

  .glow-faq-icon {
    width: {{ section.settings.icon_size }}px;
    height: {{ section.settings.icon_size }}px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: {{ section.settings.icon_bg }};
    border-radius: {{ section.settings.icon_radius }}px;
    transition: all 0.3s ease;
  }

  .glow-faq-icon svg {
    width: {{ section.settings.chevron_size }}px;
    height: {{ section.settings.chevron_size }}px;
    stroke: var(--glow-accent);
    stroke-width: {{ section.settings.chevron_stroke }}px;
    transition: transform 0.3s ease;
  }

  .glow-faq-item.active .glow-faq-icon {
    background: var(--glow-accent);
    transform: rotate({{ section.settings.icon_rotate_degrees }}deg);
  }

  .glow-faq-item.active .glow-faq-icon svg {
    stroke: {{ section.settings.icon_active_color }};
    transform: rotate(180deg);
  }

  .glow-faq-answer {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .glow-faq-answer-inner {
    padding: 0 {{ section.settings.answer_padding_x_desktop }}px {{ section.settings.answer_padding_bottom_desktop }}px {{ section.settings.answer_padding_x_desktop }}px;
  }

  .glow-faq-answer-content {
    font-size: var(--glow-answer-size);
    color: var(--glow-answer-color);
    line-height: {{ section.settings.answer_line_height }};
    font-weight: {{ section.settings.answer_weight }};
  }

  .glow-faq-answer-content p {
    margin: 0 0 {{ section.settings.answer_paragraph_spacing }}px 0;
  }

  .glow-faq-answer-content p:last-child {
    margin-bottom: 0;
  }

  .glow-faq-answer-content ul,
  .glow-faq-answer-content ol {
    margin: {{ section.settings.list_spacing }}px 0;
    padding-left: 20px;
  }

  .glow-faq-answer-content li {
    margin-bottom: 8px;
  }

  .glow-faq-answer-content a {
    color: var(--glow-accent);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s ease;
  }

  .glow-faq-answer-content a:hover {
    border-bottom-color: var(--glow-accent);
  }

  .glow-faq-answer-content strong {
    font-weight: 600;
    color: var(--glow-question-color);
  }

  /* Mobile styles */
  @media (max-width: 768px) {
    .glow-faq-section {
      --glow-title-size: {{ section.settings.title_size_mobile }}px;
      --glow-subtitle-size: {{ section.settings.subtitle_size_mobile }}px;
      --glow-question-size: {{ section.settings.question_size_mobile }}px;
      --glow-answer-size: {{ section.settings.answer_size_mobile }}px;
      --glow-section-py: {{ section.settings.section_padding_y_mobile }}px;
      --glow-section-px: {{ section.settings.section_padding_x_mobile }}px;
    }

    .glow-faq-question {
      padding: {{ section.settings.question_padding_y_mobile }}px {{ section.settings.question_padding_x_mobile }}px;
    }

    .glow-faq-answer-inner {
      padding: 0 {{ section.settings.answer_padding_x_mobile }}px {{ section.settings.answer_padding_bottom_mobile }}px {{ section.settings.answer_padding_x_mobile }}px;
    }

    .glow-faq-item:hover {
      transform: none;
    }
  }
</style>

<div class="glow-faq-section">
  <div class="glow-faq-container">

    {% if section.settings.title != blank or section.settings.subtitle != blank %}
      <div class="glow-faq-header">
        {% if section.settings.title != blank %}
          <h2 class="glow-faq-title">{{ section.settings.title }}</h2>
        {% endif %}
        {% if section.settings.subtitle != blank %}
          <p class="glow-faq-subtitle">{{ section.settings.subtitle }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="glow-faq-list">
      {% for block in section.blocks %}
        {% if block.type == 'faq_item' %}
          <div class="glow-faq-item" {{ block.shopify_attributes }} onclick="toggleGlowFaq(this)">

            <div class="glow-faq-question">
              <h3 class="glow-faq-question-text">{{ block.settings.question }}</h3>
              <div class="glow-faq-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </div>
            </div>

            <div class="glow-faq-answer">
              <div class="glow-faq-answer-inner">
                <div class="glow-faq-answer-content">
                  {{ block.settings.answer }}
                </div>
              </div>
            </div>

          </div>
        {% endif %}
      {% endfor %}
    </div>

  </div>
</div>

<script>
  function toggleGlowFaq(item) {
    const answer = item.querySelector('.glow-faq-answer');
    const isActive = item.classList.contains('active');

    // Close all items
    document.querySelectorAll('.glow-faq-item').forEach(faqItem => {
      faqItem.classList.remove('active');
      const ans = faqItem.querySelector('.glow-faq-answer');
      if (ans) ans.style.maxHeight = null;
    });

    // Open clicked item if it wasn't active
    if (!isActive) {
      item.classList.add('active');
      answer.style.maxHeight = answer.scrollHeight + 'px';
    }
  }
</script>

